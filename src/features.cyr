# src/features.cyr — SPE/Hayes distinctive features, derived from the phoneme record.
#
# Added at 2.2.3, and deliberately **derived rather than stored**. By this point the
# record already carries manner, place, voicing, height, backness, rounding, airstream
# (2.2.0) and the secondary-articulation mask (2.2.1/2.2.2); almost every distinctive
# feature is a function of those. Storing them again would double the per-phoneme cost,
# and — worse — let the two representations drift: an inventory edited to change a
# manner would silently keep a stale [±sonorant]. Derived, that cannot happen, and the
# Phoneme record stays 56 bytes.
#
# --- Three values, not two ---------------------------------------
# Feature systems are not binary. A feature can be +, −, or genuinely *unspecified*
# for a segment: [±anterior] is only defined for coronals, [±delayed release] only for
# stops and affricates, and [±ATR] is not transcribed anywhere in this corpus at all
# (see roadmap "Data: ATR vowel systems"). Collapsing unspecified into − would assert
# things the data does not support, so the reader returns a tri-state and the two
# masks are exposed separately:
#
#   phoneme_df(p, f)         ->  1 (+),  0 (−),  (0-1) unspecified
#   phoneme_df_present(p)    ->  bitmask of features that are +
#   phoneme_df_defined(p)    ->  bitmask of features that are specified at all
#
# --- Sourcing ------------------------------------------------------
# Definitions follow Hayes, *Introductory Phonetics* (2009), ch. 4-5, which is also
# the framework PHOIBLE's feature set is closest to. Where treatments genuinely
# disagree the feature is left unspecified rather than silently resolved — the two
# cases are trills/taps for [±continuant] and central vowels for [±back], both noted
# at the point of decision below.
#
# Variant names carry a `DF_` prefix: Cyrius enum variants share one flat symbol
# namespace, and `Nasal`, `Lateral`, `Long`, `Syllabic`, `Back` and `Trill` are all
# already taken by Manner, PhonemeFeature and Backness. `VarnaError` sets the
# precedent for a prefixed enum in this tree.

enum DistinctiveFeature {
    # Major class
    DF_SYLLABIC = 1;
    DF_CONSONANTAL = 2;
    DF_SONORANT = 4;
    DF_APPROXIMANT = 8;
    # Manner
    DF_CONTINUANT = 16;
    DF_DELAYED_RELEASE = 32;
    DF_NASAL = 64;
    DF_LATERAL = 128;
    DF_STRIDENT = 256;
    DF_TRILL = 512;
    DF_TAP = 1024;
    # Laryngeal
    DF_VOICE = 2048;
    DF_SPREAD_GLOTTIS = 4096;
    DF_CONSTRICTED_GLOTTIS = 8192;
    # Place
    DF_LABIAL = 16384;
    DF_ROUND = 32768;
    DF_CORONAL = 65536;
    DF_ANTERIOR = 131072;
    DF_DISTRIBUTED = 262144;
    DF_DORSAL = 524288;
    DF_HIGH = 1048576;
    DF_LOW = 2097152;
    DF_BACK = 4194304;
    # Vowel quality / length
    DF_TENSE_ATR = 8388608;
    DF_LONG = 16777216;
}

# Every feature the enum defines, for iteration and for masking.
fn df_all_mask() {
    return 33554431;
}

fn df_count() {
    return 25;
}

# --- internal accumulator -------------------------------------------------
# Cyrius has no tuples, so the two masks are accumulated into a 2-slot record and
# both readers below pull from the same derivation.
#   acc (16B): [0]=present  [8]=defined

# One scratch record, reused for every derivation.
#
# The obvious shape is `alloc(16)` per call — but the bump allocator never frees,
# so a consumer reading features in a loop would leak 16 bytes a call (measured:
# 16,000 bytes per 1,000 reads before this was changed). That is precisely the
# defect 2.1.5 swept out of the rest of the tree, so it is not reintroduced here.
#
# Safe because the record never escapes: `_df_derive` is private, and the three
# public readers all extract an i64 from it before returning. varna is
# single-threaded; if that ever changes this becomes thread-local state.
var _df_scratch = 0;

fn _df_acc() {
    if (_df_scratch == 0) { _df_scratch = alloc(16); }
    store64(_df_scratch, 0);
    store64(_df_scratch + 8, 0);
    return _df_scratch;
}

# Record feature `f` as + (value 1) or − (value 0). Anything not passed through
# here stays unspecified.
fn _df_set(a, f, value) {
    store64(a + 8, load64(a + 8) | f);
    if (value == 1) { store64(a, load64(a) | f); }
    return a;
}

fn _df_consonant(a, p) {
    var manner = phoneme_manner(p);
    var place = phoneme_place(p);
    var air = phoneme_airstream(p);

    # --- major class ---
    _df_set(a, DistinctiveFeature.DF_SYLLABIC, 0);

    # [−consonantal] for the glottals /h ʔ/ and for the glides /j w/, which have no
    # constriction in the oral cavity; everything else is [+consonantal].
    var cons = 1;
    if (place == Place.Glottal) { cons = 0; }
    if (manner == Manner.Approximant) {
        if (place == Place.Palatal || place == Place.LabialVelar) { cons = 0; }
    }
    _df_set(a, DistinctiveFeature.DF_CONSONANTAL, cons);

    var son = 0;
    if (manner == Manner.Nasal) { son = 1; }
    if (manner == Manner.Trill) { son = 1; }
    if (manner == Manner.TapFlap) { son = 1; }
    if (manner == Manner.Approximant) { son = 1; }
    if (manner == Manner.LateralApproximant) { son = 1; }
    _df_set(a, DistinctiveFeature.DF_SONORANT, son);

    var appr = 0;
    if (manner == Manner.Approximant) { appr = 1; }
    if (manner == Manner.LateralApproximant) { appr = 1; }
    _df_set(a, DistinctiveFeature.DF_APPROXIMANT, appr);

    # --- manner ---
    # Trills and taps are left UNSPECIFIED for [±continuant] on purpose: they involve
    # intermittent closure, and treatments split on whether that counts. Asserting
    # either value would be inventing a commitment the data does not make.
    if (manner == Manner.Fricative || manner == Manner.LateralFricative) {
        _df_set(a, DistinctiveFeature.DF_CONTINUANT, 1);
    }
    elif (manner == Manner.Approximant || manner == Manner.LateralApproximant) {
        _df_set(a, DistinctiveFeature.DF_CONTINUANT, 1);
    }
    elif (manner == Manner.Plosive || manner == Manner.Nasal || manner == Manner.Affricate) {
        _df_set(a, DistinctiveFeature.DF_CONTINUANT, 0);
    }

    # [±delayed release] is only defined for stops and affricates.
    if (manner == Manner.Affricate) { _df_set(a, DistinctiveFeature.DF_DELAYED_RELEASE, 1); }
    elif (manner == Manner.Plosive) { _df_set(a, DistinctiveFeature.DF_DELAYED_RELEASE, 0); }

    var nas = 0;
    if (manner == Manner.Nasal) { nas = 1; }
    _df_set(a, DistinctiveFeature.DF_NASAL, nas);

    _df_set(a, DistinctiveFeature.DF_LATERAL, phoneme_has_feature(p, PhonemeFeature.Lateral));

    # [±strident] distinguishes the noisy sibilants and labiodentals from the quieter
    # obstruents at the same manner: /f v s z ʃ ʒ/ are +, /ɸ β θ ð x ɣ/ are −. It is
    # only defined for obstruents.
    if (manner == Manner.Fricative || manner == Manner.Affricate || manner == Manner.LateralFricative) {
        var strid = 0;
        if (place == Place.Labiodental) { strid = 1; }
        if (place == Place.Alveolar) { strid = 1; }
        if (place == Place.Postalveolar) { strid = 1; }
        if (place == Place.Uvular) { strid = 1; }
        # Lateral fricatives /ɬ ɮ/ are non-strident despite being alveolar.
        if (manner == Manner.LateralFricative) { strid = 0; }
        _df_set(a, DistinctiveFeature.DF_STRIDENT, strid);
    }

    var tri = 0;
    if (manner == Manner.Trill) { tri = 1; }
    _df_set(a, DistinctiveFeature.DF_TRILL, tri);
    var tap = 0;
    if (manner == Manner.TapFlap) { tap = 1; }
    _df_set(a, DistinctiveFeature.DF_TAP, tap);

    # --- laryngeal ---
    _df_set(a, DistinctiveFeature.DF_VOICE, phoneme_voiced(p));

    # Aspiration and breathy voice both spread the glottis.
    var spread = 0;
    if (phoneme_has_feature(p, PhonemeFeature.Aspirated) == 1) { spread = 1; }
    if (phoneme_has_feature(p, PhonemeFeature.Breathy) == 1) { spread = 1; }
    _df_set(a, DistinctiveFeature.DF_SPREAD_GLOTTIS, spread);

    # Ejectives and implosives use a closed glottis as the airstream source; so does
    # the glottal stop itself.
    var constr = 0;
    if (air == Airstream.Ejective || air == Airstream.Implosive) { constr = 1; }
    if (manner == Manner.Plosive && place == Place.Glottal) { constr = 1; }
    _df_set(a, DistinctiveFeature.DF_CONSTRICTED_GLOTTIS, constr);

    # --- place ---
    var lab = 0;
    if (place == Place.Bilabial || place == Place.Labiodental || place == Place.LabialVelar) { lab = 1; }
    if (phoneme_has_feature(p, PhonemeFeature.Labialized) == 1) { lab = 1; }
    _df_set(a, DistinctiveFeature.DF_LABIAL, lab);
    _df_set(a, DistinctiveFeature.DF_ROUND, phoneme_has_feature(p, PhonemeFeature.Labialized));

    var cor = 0;
    if (place == Place.Dental || place == Place.Alveolar) { cor = 1; }
    if (place == Place.Postalveolar || place == Place.Retroflex) { cor = 1; }
    _df_set(a, DistinctiveFeature.DF_CORONAL, cor);

    # [±anterior] and [±distributed] are coronal-only features.
    if (cor == 1) {
        var ant = 0;
        if (place == Place.Dental || place == Place.Alveolar) { ant = 1; }
        _df_set(a, DistinctiveFeature.DF_ANTERIOR, ant);
        # Laminal (dental, postalveolar) is [+distributed]; apical (alveolar,
        # retroflex) is [−distributed].
        var dist = 0;
        if (place == Place.Dental || place == Place.Postalveolar) { dist = 1; }
        _df_set(a, DistinctiveFeature.DF_DISTRIBUTED, dist);
    }

    var dors = 0;
    if (place == Place.Palatal || place == Place.Velar) { dors = 1; }
    if (place == Place.Uvular || place == Place.LabialVelar) { dors = 1; }
    if (phoneme_has_feature(p, PhonemeFeature.Palatalized) == 1) { dors = 1; }
    _df_set(a, DistinctiveFeature.DF_DORSAL, dors);

    # [±high/low/back] describe tongue-body position, so they are defined for dorsals
    # and for the pharyngeals that recruit the tongue root; elsewhere unspecified.
    if (dors == 1) {
        var high = 0;
        if (place == Place.Palatal || place == Place.Velar || place == Place.LabialVelar) { high = 1; }
        if (phoneme_has_feature(p, PhonemeFeature.Palatalized) == 1) { high = 1; }
        _df_set(a, DistinctiveFeature.DF_HIGH, high);
        _df_set(a, DistinctiveFeature.DF_LOW, 0);
        var back = 0;
        if (place == Place.Velar || place == Place.Uvular || place == Place.LabialVelar) { back = 1; }
        if (place == Place.Palatal) { back = 0; }
        _df_set(a, DistinctiveFeature.DF_BACK, back);
    }
    elif (place == Place.Pharyngeal) {
        _df_set(a, DistinctiveFeature.DF_HIGH, 0);
        _df_set(a, DistinctiveFeature.DF_LOW, 1);
        _df_set(a, DistinctiveFeature.DF_BACK, 1);
    }
    elif (phoneme_has_feature(p, PhonemeFeature.Pharyngealized) == 1) {
        # Arabic emphatics retract the tongue root without being pharyngeal by place.
        _df_set(a, DistinctiveFeature.DF_LOW, 1);
        _df_set(a, DistinctiveFeature.DF_BACK, 1);
    }

    # --- length; ATR is never specified (see the header) ---
    _df_set(a, DistinctiveFeature.DF_LONG, phoneme_has_feature(p, PhonemeFeature.Long));
    return a;
}

fn _df_vowel(a, p) {
    var height = phoneme_height(p);
    var backness = phoneme_backness(p);
    var rounded = phoneme_rounded(p);
    var syllabic_c = phoneme_has_feature(p, PhonemeFeature.Syllabic);

    _df_set(a, DistinctiveFeature.DF_SYLLABIC, 1);
    # Sanskrit's /r̩ l̩ r̩ː l̩ː/ are filed as vowels but are syllabic *consonants*:
    # they keep [+consonantal] where a true vowel is [−consonantal].
    _df_set(a, DistinctiveFeature.DF_CONSONANTAL, syllabic_c);
    _df_set(a, DistinctiveFeature.DF_SONORANT, 1);
    _df_set(a, DistinctiveFeature.DF_APPROXIMANT, 1);
    _df_set(a, DistinctiveFeature.DF_CONTINUANT, 1);
    _df_set(a, DistinctiveFeature.DF_NASAL, phoneme_has_feature(p, PhonemeFeature.Nasalized));
    _df_set(a, DistinctiveFeature.DF_LATERAL, 0);
    _df_set(a, DistinctiveFeature.DF_TRILL, 0);
    _df_set(a, DistinctiveFeature.DF_TAP, 0);
    # Every vowel in the corpus is voiced; none carries the Devoiced bit.
    _df_set(a, DistinctiveFeature.DF_VOICE, 1);
    _df_set(a, DistinctiveFeature.DF_SPREAD_GLOTTIS, 0);
    _df_set(a, DistinctiveFeature.DF_CONSTRICTED_GLOTTIS, 0);

    _df_set(a, DistinctiveFeature.DF_LABIAL, rounded);
    _df_set(a, DistinctiveFeature.DF_ROUND, rounded);
    _df_set(a, DistinctiveFeature.DF_CORONAL, 0);
    _df_set(a, DistinctiveFeature.DF_DORSAL, 1);

    var high = 0;
    if (height == Height.Close || height == Height.NearClose) { high = 1; }
    _df_set(a, DistinctiveFeature.DF_HIGH, high);
    var low = 0;
    if (height == Height.Open || height == Height.NearOpen) { low = 1; }
    _df_set(a, DistinctiveFeature.DF_LOW, low);

    # Central vowels are left UNSPECIFIED for [±back]. A two-valued feature cannot
    # express a three-way front/central/back contrast, and treatments differ on which
    # way central should fall; the Backness axis already records the truth exactly.
    if (backness == Backness.Back) { _df_set(a, DistinctiveFeature.DF_BACK, 1); }
    elif (backness == Backness.Front) { _df_set(a, DistinctiveFeature.DF_BACK, 0); }

    _df_set(a, DistinctiveFeature.DF_LONG, phoneme_has_feature(p, PhonemeFeature.Long));
    return a;
}

fn _df_derive(p) {
    var a = _df_acc();
    if (phoneme_kind(p) == PhonemeKind.Vowel) { return _df_vowel(a, p); }
    return _df_consonant(a, p);
}

# Bitmask of the distinctive features this phoneme has a **+** value for.
fn phoneme_df_present(p) {
    return load64(_df_derive(p));
}

# Bitmask of the distinctive features that are **specified** for this phoneme,
# whether + or −. A feature outside this mask is genuinely undefined for the segment,
# not merely negative.
fn phoneme_df_defined(p) {
    return load64(_df_derive(p) + 8);
}

# Tri-state read of one feature: 1 (+), 0 (−), (0-1) unspecified.
fn phoneme_df(p, feature) {
    var a = _df_derive(p);
    if ((load64(a + 8) & feature) == 0) { return 0 - 1; }
    if ((load64(a) & feature) != 0) { return 1; }
    return 0;
}

# Human-readable name for a single DistinctiveFeature constant, or "unknown feature".
fn df_name(feature) {
    if (feature == DistinctiveFeature.DF_SYLLABIC) { return "syllabic"; }
    if (feature == DistinctiveFeature.DF_CONSONANTAL) { return "consonantal"; }
    if (feature == DistinctiveFeature.DF_SONORANT) { return "sonorant"; }
    if (feature == DistinctiveFeature.DF_APPROXIMANT) { return "approximant"; }
    if (feature == DistinctiveFeature.DF_CONTINUANT) { return "continuant"; }
    if (feature == DistinctiveFeature.DF_DELAYED_RELEASE) { return "delayed release"; }
    if (feature == DistinctiveFeature.DF_NASAL) { return "nasal"; }
    if (feature == DistinctiveFeature.DF_LATERAL) { return "lateral"; }
    if (feature == DistinctiveFeature.DF_STRIDENT) { return "strident"; }
    if (feature == DistinctiveFeature.DF_TRILL) { return "trill"; }
    if (feature == DistinctiveFeature.DF_TAP) { return "tap"; }
    if (feature == DistinctiveFeature.DF_VOICE) { return "voice"; }
    if (feature == DistinctiveFeature.DF_SPREAD_GLOTTIS) { return "spread glottis"; }
    if (feature == DistinctiveFeature.DF_CONSTRICTED_GLOTTIS) { return "constricted glottis"; }
    if (feature == DistinctiveFeature.DF_LABIAL) { return "labial"; }
    if (feature == DistinctiveFeature.DF_ROUND) { return "round"; }
    if (feature == DistinctiveFeature.DF_CORONAL) { return "coronal"; }
    if (feature == DistinctiveFeature.DF_ANTERIOR) { return "anterior"; }
    if (feature == DistinctiveFeature.DF_DISTRIBUTED) { return "distributed"; }
    if (feature == DistinctiveFeature.DF_DORSAL) { return "dorsal"; }
    if (feature == DistinctiveFeature.DF_HIGH) { return "high"; }
    if (feature == DistinctiveFeature.DF_LOW) { return "low"; }
    if (feature == DistinctiveFeature.DF_BACK) { return "back"; }
    if (feature == DistinctiveFeature.DF_TENSE_ATR) { return "ATR"; }
    if (feature == DistinctiveFeature.DF_LONG) { return "long"; }
    return "unknown feature";
}

# Do two phonemes differ in exactly one specified feature? Returns that feature's
# constant, or 0 if they form no minimal pair.
#
# This is what a feature system is *for*: /p/ and /b/ differ only in [voice], /s/ and
# /ʃ/ only in [anterior]. Features that are unspecified on either side are skipped,
# since an undefined value is not a contrast.
fn phoneme_minimal_contrast(a, b) {
    var da = phoneme_df_defined(a);
    var db = phoneme_df_defined(b);
    var both_defined = da & db;
    var diff = (phoneme_df_present(a) ^ phoneme_df_present(b)) & both_defined;
    if (diff == 0) { return 0; }
    # Exactly one bit set?
    if ((diff & (diff - 1)) != 0) { return 0; }
    return diff;
}
