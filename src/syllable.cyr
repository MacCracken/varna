    _constraint_add_seq(c2, "mb");
    _constraint_add_seq(c2, "mbʱ");
    _phonotactics_add(p, c2);
    var c3 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Coda,
      "Hindi final three-consonant clusters, Sanskrit loans (Ohala p. 43)");
    _constraint_add_seq(c3, "kɕɳ");
    _constraint_add_seq(c3, "kɕj");
    _constraint_add_seq(c3, "kɕm");
    _constraint_add_seq(c3, "ɡd̪ʱj");
    _constraint_add_seq(c3, "t̪rj");
