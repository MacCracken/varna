    _constraint_add_seq(c0, "jɡ");
    _constraint_add_seq(c0, "jɡʲ");
    _constraint_add_seq(c0, "jt͡s");
    _constraint_add_seq(c0, "jt͡ɕ");
    _constraint_add_seq(c0, "jf");
    _constraint_add_seq(c0, "jfʲ");
