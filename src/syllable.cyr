var _c_phonotactics_korean = 0;
# Korean, after Lee (1993), "Korean", JIPA 23(1), pp. 30-31. Glides are parts of
# diphthongs (p. 30), so the onset is one consonant, and the corpus inventory has no
# glides. In syllable-final position /p, p*, b/ are a voiceless unreleased stop, and so
# for the other places, and "/m, n, ŋ, l/ are the only other consonants which can occur
# syllable-finally" (p. 31): seven finals. His /l/ is the inventory's ɾ. Sohn (1999)
# gives (C)(G)V(C), a glide in the onset, which the inventory cannot spell.
fn phonotactics_korean() {
    if (_c_phonotactics_korean != 0) { return _c_phonotactics_korean; }
    var p = _phonotactics_new("ko", _syllable_new(1, 1, 1, "(C)V(C)"));
    _phonotactics_source(p, "lee1993", "the template and the seven finals (pp. 30-31)");
    var c0 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Coda,
      "The seven Korean syllable finals (Lee 1993 p. 31)");
    _constraint_add_seq(c0, "p");
    _constraint_add_seq(c0, "t");
    _constraint_add_seq(c0, "k");
    _constraint_add_seq(c0, "m");
    _constraint_add_seq(c0, "n");
    _constraint_add_seq(c0, "ŋ");
    _constraint_add_seq(c0, "ɾ");
    _phonotactics_add(p, c0);
    _c_phonotactics_korean = p;
    return _c_phonotactics_korean;
}

var _c_phonotactics_portuguese = 0;
# EUROPEAN Portuguese, after Mateus & d'Andrade (1998), "The syllable structure in
# European Portuguese", D.E.L.T.A. 14(1), pp. 13-32. Onsets of two, by the Sonority
# Principle (p. 28); "Both elements of these diphthongs - either oral or nasal - belong
# to the syllable nucleus" (p. 19); one coda consonant, "/R/, /L/ and /S/ are usually
# considered the only ones that can occur in Portuguese syllable coda" (p. 21),
# realized ɾ l ʃ ʒ in EP. Not tautosyllabic: the word-internal sequences of its
# example (1), e.g. pn gn ps (p. 15).
# VARIETY: European, as the default Portuguese inventory is since 2.6.0 (Cruz-Ferreira
# 1995), whose tap ɾ these sequences spell. The Brazilian inventory ("pt-BR") has no
# profile; there the codas are /R S N L/ (Barbosa & Albano 2004, JIPA, p. 228).
fn phonotactics_portuguese() {
    if (_c_phonotactics_portuguese != 0) { return _c_phonotactics_portuguese; }
    var p = _phonotactics_new("pt", _syllable_new(2, 1, 1, "(C)(C)V(C)"));
    _phonotactics_source(p, "mateus1998", "European Portuguese onsets, nucleus and codas");
    var c0 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Onset,
      "European Portuguese onset clusters (Mateus & d'Andrade 1998, ex. 2)");
    _constraint_add_seq(c0, "pɾ");
    _constraint_add_seq(c0, "bɾ");
    _constraint_add_seq(c0, "tɾ");
    _constraint_add_seq(c0, "dɾ");
    _constraint_add_seq(c0, "kɾ");
    _constraint_add_seq(c0, "ɡɾ");
    _constraint_add_seq(c0, "pl");
    _constraint_add_seq(c0, "bl");
    _constraint_add_seq(c0, "tl");
    _constraint_add_seq(c0, "kl");
    _constraint_add_seq(c0, "ɡl");
    _constraint_add_seq(c0, "fɾ");
    _constraint_add_seq(c0, "vɾ");
    _constraint_add_seq(c0, "fl");
    _phonotactics_add(p, c0);
    var c1 = _constraint_new(ConstraintKind.Forbidden, SyllablePosition.Onset,
      "Not tautosyllabic in EP (Mateus & d'Andrade 1998, ex. 1)");
    _constraint_add_seq(c1, "pn");
    _constraint_add_seq(c1, "ɡn");
    _constraint_add_seq(c1, "ps");
    _phonotactics_add(p, c1);
    var c2 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Coda,
      "EP coda consonants (Mateus & d'Andrade 1998, p. 21)");
    _constraint_add_seq(c2, "ɾ");
    _constraint_add_seq(c2, "l");
    _constraint_add_seq(c2, "ʃ");
    _constraint_add_seq(c2, "ʒ");
    _phonotactics_add(p, c2);
    _c_phonotactics_portuguese = p;
    return _c_phonotactics_portuguese;
}

# --- Lookup by language (2.6.0) ------------------------------------
# The same shape as allophone_by_code and grammar_by_code.

# The phonotactic profile for an ISO 639 code, or 0 when the corpus has none for it.
#must_use
fn phonotactics_by_code(code) {
    if (code == 0) { return 0; }
    if (streq(code, "en") == 1) { return phonotactics_english(); }
    if (streq(code, "ar") == 1) { return phonotactics_arabic(); }
    if (streq(code, "zh") == 1) { return phonotactics_mandarin(); }
    if (streq(code, "hi") == 1) { return phonotactics_hindi(); }
    if (streq(code, "ja") == 1) { return phonotactics_japanese(); }
    if (streq(code, "es") == 1) { return phonotactics_spanish(); }
    if (streq(code, "fr") == 1) { return phonotactics_french(); }
    if (streq(code, "de") == 1) { return phonotactics_german(); }
    if (streq(code, "ru") == 1) { return phonotactics_russian(); }
    if (streq(code, "ko") == 1) { return phonotactics_korean(); }
    if (streq(code, "pt") == 1) { return phonotactics_portuguese(); }
    if (streq(code, "sa") == 1) { return phonotactics_sanskrit(); }
    return 0;
}

var _c_phonotactics_all_codes = 0;
# Every code with a profile, in the order they were added — vec of cstrings.
fn phonotactics_all_codes() {
    if (_c_phonotactics_all_codes != 0) { return _c_phonotactics_all_codes; }
    var c = vec_new();
    vec_push(c, "en");
    vec_push(c, "ar");
    vec_push(c, "zh");
    vec_push(c, "hi");
    vec_push(c, "ja");
    vec_push(c, "es");
    vec_push(c, "fr");
    vec_push(c, "de");
    vec_push(c, "ru");
    vec_push(c, "ko");
    vec_push(c, "pt");
    vec_push(c, "sa");
    _c_phonotactics_all_codes = c;
    return _c_phonotactics_all_codes;
}
