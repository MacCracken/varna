    _constraint_add_seq(c3, "rkʰj");
    _constraint_add_seq(c3, "rɡʱj");
    _constraint_add_seq(c3, "rd͡ʑj");
    _constraint_add_seq(c3, "rt̪j");
    _constraint_add_seq(c3, "rt̪m");
