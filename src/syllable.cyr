    _constraint_add_seq(c2, "ŋ");
    _phonotactics_add(p, c2);
    var c3 = _constraint_new(ConstraintKind.Forbidden, SyllablePosition.Coda, "Excluded German codas (Schäfer p. 132)");
    _constraint_add_seq(c3, "mf");
    _constraint_add_seq(c3, "ŋf");
