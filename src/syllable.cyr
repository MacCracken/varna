    _constraint_add_seq(c0, "jzʲ");
    _constraint_add_seq(c0, "jʃ");
    _constraint_add_seq(c0, "jʒ");
    _constraint_add_seq(c0, "jɕː");
    _constraint_add_seq(c0, "jx");
