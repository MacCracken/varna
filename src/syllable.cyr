    _constraint_add_seq(c3, "rd̪ʱʋ");
    _constraint_add_seq(c3, "rɕʋ");
    _constraint_add_seq(c3, "rɦj");
    _constraint_add_seq(c3, "rɳj");
    _constraint_add_seq(c3, "rmj");
    _constraint_add_seq(c3, "lkj");
    _constraint_add_seq(c3, "ɳɖj");
    _constraint_add_seq(c3, "ɳɖr");
    _constraint_add_seq(c3, "ŋkʰj");
    _constraint_add_seq(c3, "nt̪j");
    _constraint_add_seq(c3, "nt̪r");
    _constraint_add_seq(c3, "nd̪r");
    _constraint_add_seq(c3, "nd̪ʋ");
    _constraint_add_seq(c3, "nd̪j");
    _constraint_add_seq(c3, "nd̪ʱj");
    _phonotactics_add(p, c3);
    _c_phonotactics_hindi = p;
    return _c_phonotactics_hindi;
}

var _c_phonotactics_spanish = 0;
# Castilian Spanish, after Ríos Mestre (1999), La transcripción fonética automática del
# DEFSFE (UAB thesis, ELiEs 4), §6.2. Hualde (2005) and Harris (1983) could not be
# read. Obstruent + liquid is "la única combinación consonántica permitida en
# posición prenuclear": /p k b g f/ + /r l/ and /d t/ + /r/, and "no consideraremos
# como tales las combinaciones /tl/ y /dl/" (§6.2.2.2). Complex codas are /b d k n l
# r/ + /s/; "ninguna palatal aparece en posición de coda", nor /w/, nor /c/ (§6.2.2.3).
# The source's r is the tap ɾ and its c is t͡ʃ. Prenuclear glides are in the nucleus,
# so C + j/w is not an onset here.
fn phonotactics_spanish() {
    if (_c_phonotactics_spanish != 0) { return _c_phonotactics_spanish; }
    var p = _phonotactics_new("es", _syllable_new(2, 2, 1, "(C)(C)V(C)(C)"));
    _phonotactics_source(p, "riosmestre1999", "the onset and coda clusters (§6.2)");
    var c0 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Onset,
      "Spanish onset clusters: obstruent + liquid (Ríos Mestre §6.2.2.2)");
    _constraint_add_seq(c0, "pɾ");
    _constraint_add_seq(c0, "kɾ");
    _constraint_add_seq(c0, "bɾ");
    _constraint_add_seq(c0, "ɡɾ");
    _constraint_add_seq(c0, "fɾ");
    _constraint_add_seq(c0, "pl");
    _constraint_add_seq(c0, "kl");
    _constraint_add_seq(c0, "bl");
    _constraint_add_seq(c0, "ɡl");
    _constraint_add_seq(c0, "fl");
    _constraint_add_seq(c0, "dɾ");
    _constraint_add_seq(c0, "tɾ");
    _phonotactics_add(p, c0);
    var c1 = _constraint_new(ConstraintKind.Forbidden, SyllablePosition.Onset,
      "Not tautosyllabic in Spanish (Ríos Mestre §6.2.2.2)");
    _constraint_add_seq(c1, "tl");
    _constraint_add_seq(c1, "dl");
    _phonotactics_add(p, c1);
    var c2 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Coda,
      "Spanish complex codas: C + /s/ (Ríos Mestre §6.2.2.3)");
    _constraint_add_seq(c2, "bs");
    _constraint_add_seq(c2, "ds");
    _constraint_add_seq(c2, "ks");
    _constraint_add_seq(c2, "ns");
    _constraint_add_seq(c2, "ls");
    _constraint_add_seq(c2, "ɾs");
    _phonotactics_add(p, c2);
    var c3 = _constraint_new(ConstraintKind.Forbidden, SyllablePosition.Coda,
      "No palatal, /w/ or /t͡ʃ/ in a Spanish coda (Ríos Mestre §6.2.2.3)");
    _constraint_add_seq(c3, "ɟ͡ʝ");
    _constraint_add_seq(c3, "ɲ");
    _constraint_add_seq(c3, "ʎ");
    _constraint_add_seq(c3, "w");
    _constraint_add_seq(c3, "t͡ʃ");
    _phonotactics_add(p, c3);
    _c_phonotactics_spanish = p;
    return _c_phonotactics_spanish;
}

var _c_phonotactics_french = 0;
# French: PARTIAL, AND ITS TEMPLATE IS UNVERIFIED. No reachable source states a French
# syllable template: Walker (2001), Tranel (1987) and Dell (1995) could not be read,
# and Fougeron & Smith (1993, JIPA) give none. max_coda 1 is a REPORTED claim:
# Côté (2000, MIT thesis, p. 91) cites "French allows only one coda consonant"
# (Bouchard 1981, Anderson 1982) and argues against that syllable-based view, and
# French words do end in clusters (table, arbre). The onset list is Côté's minimum:
# "stop+liquid (except /tl, dl/) and /f/+liquid clusters", "with the possible
# addition of /s/". It is a minimum, not an enumeration, and misses vʁ (vrai).
# Verified: "The velar nasal occurs only in final position in borrowed (usually
# English) words" (Fougeron & Smith, p. 75). Re-check against Walker or Tranel.
fn phonotactics_french() {
    if (_c_phonotactics_french != 0) { return _c_phonotactics_french; }
    var p = _phonotactics_new("fr", _syllable_new(2, 1, 0, "(C)(C)V(C)"));
    _phonotactics_source(p, "cote2000", "max_coda 1, a view it reports, and the minimum onsets (p. 91)");
    _phonotactics_source(p, "fougeron1993", "no initial ŋ (p. 75)");
    var c0 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Onset,
      "French stop/f + liquid onsets, Côté's minimum (p. 91)");
    _constraint_add_seq(c0, "pʁ");
    _constraint_add_seq(c0, "bʁ");
    _constraint_add_seq(c0, "tʁ");
    _constraint_add_seq(c0, "dʁ");
    _constraint_add_seq(c0, "kʁ");
    _constraint_add_seq(c0, "ɡʁ");
    _constraint_add_seq(c0, "pl");
    _constraint_add_seq(c0, "bl");
    _constraint_add_seq(c0, "kl");
    _constraint_add_seq(c0, "ɡl");
    _constraint_add_seq(c0, "fʁ");
    _constraint_add_seq(c0, "fl");
    _phonotactics_add(p, c0);
    var c1 = _constraint_new(ConstraintKind.Forbidden, SyllablePosition.Onset,
      "Word-final in loans only (Fougeron & Smith p. 75)");
    _constraint_add_seq(c1, "ŋ");
    _phonotactics_add(p, c1);
    _c_phonotactics_french = p;
    return _c_phonotactics_french;
}

var _c_phonotactics_german = 0;
# Standard German, after Schäfer (2018), Einführung in die grammatische Beschreibung
# des Deutschen, 3rd ed., §5.2, pp. 124-145 (open access). Wiese (1996) could not be read.
# The core syllable is CCVCC ("Der Anfangsrand ist maximal duplex", p. 140; "Der
# Endrand ist maximal duplex", p. 145), with one extrasyllabic segment before the onset
# and "nach dem Endrand maximal drei extrasilbische Segmente" (p. 137). The template
# counts the surface maximum: three-segment onsets "sind auf [ʃpʁ] und [ʃtʁ]
# beschränkt" (p. 130), and "qualmt, qualmst oder Herbsts zeigen, dass es drei-, vier-
# und fünfsegmentale Endränder zu geben scheint" (p. 132).
# Onsets (pp. 129-130): [ʁ] only after the plosives, [f], [ʃ] and rarely [v]; [v] only
# after [k] and [ʃ]; [kn], rarely [gn], [ʃn], [ʃm]; [l] after the non-alveolar
# plosives and [f ʃ]; [ʃp ʃt]. The list misses affricate clusters (t͡sv in zwei), which
# Schäfer's statements leave out. Forbidden onsets are his starred forms. [ŋ] does not
# occur in the onset of a monosyllable (p. 128). Codas: final devoicing, so no voiced
# obstruent (p. 117, p. 131), [h] "nur im Anfangsrand", and "[mf] und [ŋf] sowie
# Kombinationen aus zwei Nasalen oder aus Nasal und Liquid sind gänzlich
# ausgeschlossen" (p. 132). The permitted codas are stated as prose rules, not a list,
# so they are not enumerated. His ʝ is the inventory's j.
fn phonotactics_german() {
    if (_c_phonotactics_german != 0) { return _c_phonotactics_german; }
    var p = _phonotactics_new("de", _syllable_new(3, 5, 1, "(C)(C)(C)V(C)(C)(C)(C)(C)"));
    _phonotactics_source(p, "schafer2018", "the template, the onsets and the excluded codas (§5.2)");
    var c0 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Onset,
      "German onset clusters (Schäfer pp. 129-130)");
    _constraint_add_seq(c0, "ʃp");
    _constraint_add_seq(c0, "ʃt");
    _constraint_add_seq(c0, "pʁ");
    _constraint_add_seq(c0, "bʁ");
    _constraint_add_seq(c0, "tʁ");
    _constraint_add_seq(c0, "dʁ");
    _constraint_add_seq(c0, "kʁ");
    _constraint_add_seq(c0, "ɡʁ");
    _constraint_add_seq(c0, "fʁ");
    _constraint_add_seq(c0, "ʃʁ");
    _constraint_add_seq(c0, "vʁ");
    _constraint_add_seq(c0, "kv");
    _constraint_add_seq(c0, "ʃv");
    _constraint_add_seq(c0, "kn");
    _constraint_add_seq(c0, "ɡn");
    _constraint_add_seq(c0, "ʃn");
    _constraint_add_seq(c0, "ʃm");
    _constraint_add_seq(c0, "pl");
    _constraint_add_seq(c0, "bl");
    _constraint_add_seq(c0, "kl");
    _constraint_add_seq(c0, "ɡl");
    _constraint_add_seq(c0, "fl");
    _constraint_add_seq(c0, "ʃl");
    _constraint_add_seq(c0, "ʃpʁ");
    _constraint_add_seq(c0, "ʃtʁ");
    _phonotactics_add(p, c0);
    var c1 = _constraint_new(ConstraintKind.Forbidden, SyllablePosition.Onset,
      "Starred German onsets (Schäfer pp. 129-130)");
    _constraint_add_seq(c1, "pt");
    _constraint_add_seq(c1, "fp");
    _constraint_add_seq(c1, "ʃɡ");
    _constraint_add_seq(c1, "lt");
    _constraint_add_seq(c1, "ks");
