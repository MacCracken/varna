# varna — multilingual language engine (Cyrius port)
# Ported from 8386 lines of Rust (rust-old/).
#
# Stdlib auto-included via cyrius.cyml [deps]. Project modules below.

include "src/error.cyr"
include "src/util.cyr"
include "src/phoneme.cyr"
include "src/inventories.cyr"
include "src/allophone.cyr"
include "src/syllable.cyr"
include "src/grammar.cyr"
include "src/script.cyr"
include "src/registry.cyr"
include "src/numerals.cyr"
include "src/transliteration.cyr"

fn main() {
    alloc_init();
    var en = phoneme_english();
    if (phoneme_has(en, "θ") == 1) {
        println("varna: English inventory loaded (24C + 12V, has θ)");
    }
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
