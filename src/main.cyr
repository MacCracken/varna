# Demo entry — loads the English inventory and confirms the engine links.
fn main() {
    alloc_init();
    var en = phoneme_english();
    if (phoneme_has(en, "θ") == 1) {
        println("varna: English inventory loaded (24C + 12V, has θ)");
    }
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
