# src/sources.cyr — the bibliography: the works varna's data is taken from (2.6.0).
#
# Provenance was named only in comments until 2.6.0. This module holds each cited work
# once, under a key, and a dataset links to keys with what each work covers:
# inventory_sources, phonotactics_sources, allophone_sources, translit_sources and
# numerals_sources. Grammar, scripts and lexicons are not linked yet (see the roadmap).
#
# What gets a link: a work the values are taken from. A work that only agrees with
# them, one that was checked and set aside, and one that could not be read are
# named in the dataset's comment, not linked.
#
# Every field is as the work's publisher, journal or repository prints it, read from
# that page: Crossref's publisher-deposited record for a work with a DOI, and the
# page in `url` for one without. Authors are "Family, Given" and separated by "; ".
# A work that prints no date is undated, year 0, rather than dated from another
# work's citation of it.
#
# Source (64B): [0]=key [8]=authors [16]=year [24]=title [32]=venue
#               [40]=pages (cstr|0) [48]=doi (cstr|0) [56]=url (cstr|0)
#
# Every data module includes this file first: it holds the link record the
# inventories, phonotactic profiles, allophone sets, transliteration tables and
# numeral systems use.

# --- Links ---------------------------------------------------------------
# A link: a bibliography key and what that work covers in the record holding it.
# SourceLink (16B): [0]=key (cstr) [8]=covers (cstr)
fn _source_link_new(key, covers) {
    var l = alloc(16);
    store64(l, key);
    store64(l + 8, covers);
    return l;
}

fn source_link_key(l) { return load64(l); }
fn source_link_covers(l) { return load64(l + 8); }

# Append a link to a record's vec of links.
fn _source_links_add(links, key, covers) {
    vec_push(links, _source_link_new(key, covers));
    return links;
}

# --- The bibliography ----------------------------------------------------

fn _source_new(key, authors, year, title, venue, pages, doi, url) {
    var s = alloc(64);
    store64(s, key);
    store64(s + 8, authors);
    store64(s + 16, year);
    store64(s + 24, title);
    store64(s + 32, venue);
    store64(s + 40, pages);
    store64(s + 48, doi);
    store64(s + 56, url);
    return s;
}

fn source_key(s) { return load64(s); }
fn source_authors(s) { return load64(s + 8); }
# Year, or 0 for a work that prints no date (cited "n.d."; its key ends "_nd").
fn source_year(s) { return load64(s + 16); }
fn source_title(s) { return load64(s + 24); }
fn source_venue(s) { return load64(s + 32); }
# Page range, or 0 for a whole book or database.
fn source_pages(s) { return load64(s + 40); }
# DOI, or 0 when the work has none.
fn source_doi(s) { return load64(s + 48); }
# The page the record was read from, or 0 when the DOI resolves to it.
fn source_url(s) { return load64(s + 56); }

var _c_bibliography = 0;

