var _c_bibliography_index = 0;

# The work under `key`, or 0 when the bibliography has none.
#
# Through an index built on first use: a scan of the 50 works cost 2.8 µs for the
# last key, and resolving every link in the corpus calls this once per link.
#must_use
fn source_by_key(key) {
    if (key == 0) { return 0; }
    if (_c_bibliography_index == 0) {
        var ix = map_new();
        var b = _bibliography();
        var i = 0;
        while (i < vec_len(b)) {
            map_set(ix, load64(vec_get(b, i)), vec_get(b, i));
            i = i + 1;
        }
        _c_bibliography_index = ix;
    }
    return map_get(_c_bibliography_index, key);
}

var _c_source_all_keys = 0;
# Every bibliography key, in key order — vec of cstrings.
fn source_all_keys() {
    if (_c_source_all_keys != 0) { return _c_source_all_keys; }
    var c = vec_new();
    var b = _bibliography();
    var i = 0;
    while (i < vec_len(b)) {
        vec_push(c, load64(vec_get(b, i)));
        i = i + 1;
    }
    _c_source_all_keys = c;
    return _c_source_all_keys;
}
