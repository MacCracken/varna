# --- Lookup --------------------------------------------------------

# --- 2.1.6: the nine scripts the registry named but did not define -----
# Until 2.1.6 these nine ISO 15924 codes appeared in the registry's language
# entries with no Script behind them, so `registry_primary_script` silently
# returned 0 for Thai, Bengali, Tamil, Amharic, Hebrew, Georgian, Burmese, Khmer
# and Lao. Ranges are the Unicode blocks for each script, main block first.

var _c_script_thai = 0;
fn script_thai() {
    if (_c_script_thai != 0) { return _c_script_thai; }
    var s = _script_new("Thai", "Thai", ScriptType.Abugida, Direction.LeftToRight, ScriptStatus.Living, 0);
    _script_add_range(s, 0x0E00, 0x0E7F);
    _script_add_lang(s, "th");
    _c_script_thai = s;
    return _c_script_thai;
}

