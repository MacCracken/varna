# src/hoosh.cyr — structured LLM query interface (-D HOOSH).
#
# Ported from v1.x Rust src/hoosh.rs. Requires everything src/json.cyr does.
# The record holds confidence per-mille (1000 = 1.0, (0-1) = None) to avoid f64; on the
# wire it is the number v1.x wrote, so 1000 is 1.0. A value finer than a thousandth
# rounds on read. structured_data holds JSON text (0 = None), written out as it stands.
#
# LanguageQuery (40B): [0]=tag [8]=f0 [16]=f1 [24]=f2
# QueryResponse (40B): [0]=query_id(cstr|0) [8]=source [16]=content
#                      [24]=confidence(per-mille|0-1) [32]=structured_data(cstr|0)

#ifdef HOOSH

#derive(Serialize)
enum ComparisonAspect {
    Phonology = 0;
    Grammar = 1;
    Script = 2;
    Lexicon = 3;
}

#derive(Serialize)
enum ResponseSource {
    VarnaData = 0;
    LlmGenerated = 1;
    Hybrid = 2;
}

#derive(Serialize)
enum LanguageQueryTag {
    IdentifyLanguage = 0;
    ExplainPhonology = 1;
    ExamplesForPhoneme = 2;
    ComparativeAnalysis = 3;
    EtymologyLookup = 4;
}

fn hoosh_query_tag(q) { return load64(q); }

fn hoosh_identify(text) {
    var q = alloc(40);
    store64(q, LanguageQueryTag.IdentifyLanguage);
    store64(q + 8, text);
    return q;
}

fn hoosh_explain_phonology(language, topic) {
    var q = alloc(40);
    store64(q, LanguageQueryTag.ExplainPhonology);
    store64(q + 8, language);
    store64(q + 16, topic);
    return q;
}

fn hoosh_examples_for_phoneme(language, ipa, count) {
    var q = alloc(40);
    store64(q, LanguageQueryTag.ExamplesForPhoneme);
    store64(q + 8, language);
    store64(q + 16, ipa);
    store64(q + 24, count);
    return q;
}

fn hoosh_compare(lang1, lang2, aspect) {
    var q = alloc(40);
    store64(q, LanguageQueryTag.ComparativeAnalysis);
    var langs = vec_new();
    vec_push(langs, lang1);
    vec_push(langs, lang2);
    store64(q + 8, langs);
    store64(q + 16, aspect);
    return q;
}

fn hoosh_etymology_lookup(word, source_language) {
    var q = alloc(40);
    store64(q, LanguageQueryTag.EtymologyLookup);
    store64(q + 8, word);
    store64(q + 16, source_language);
    return q;
}

fn _query_response_new(query_id, source, content, confidence, structured_data) {
    var r = alloc(40);
    store64(r, query_id);
    store64(r + 8, source);
    store64(r + 16, content);
    store64(r + 24, confidence);
    store64(r + 32, structured_data);
    return r;
}

fn hoosh_response_query_id(r) { return load64(r); }
fn hoosh_response_source(r) { return load64(r + 8); }
fn hoosh_response_content(r) { return load64(r + 16); }
fn hoosh_response_confidence(r) { return load64(r + 24); }
fn hoosh_response_structured_data(r) { return load64(r + 32); }

# Append cstring `src` to `buf` at `off`, writing no further than `cap - 1` so
# the terminating NUL always fits; return the new offset.
#
# `hoosh_answer_from_data` interpolates the caller's `ipa` string into a fixed
# 256-byte buffer. On the not-in-inventory path that string has not been matched
# against anything, so its length is entirely the caller's choice — unbounded
# appends overflowed the allocation. Truncating keeps the response well-formed.
fn _hb_append(buf, off, cap, src) {
    var len = strlen(src);
    var room = cap - off - 1;
    if (room <= 0) { return off; }
    if (len > room) { len = room; }
    memcpy(buf + off, src, len);
    return off + len;
}

# Bounded decimal append; fmt_int_buf needs up to 21 bytes of headroom.
fn _hb_append_int(buf, off, cap, n) {
    if (cap - off - 1 < 21) { return off; }
    return off + fmt_int_buf(n, buf + off);
}

# Answer a query from varna's data — QueryResponse ptr, or 0 if it needs an LLM.
fn hoosh_answer_from_data(q) {
    var tag = load64(q);
    if (tag == LanguageQueryTag.ExamplesForPhoneme) {
        var language = load64(q + 8);
        var ipa = load64(q + 16);
        var inv = registry_phonemes(language);
        if (inv == 0) { return 0; }
        var name = phoneme_language_name(inv);
        if (phoneme_has(inv, ipa) == 1) {
            var cap = 256;
            var buf = alloc(cap);
            var off = 0;
            off = _hb_append(buf, off, cap, "/");
            off = _hb_append(buf, off, cap, ipa);
            off = _hb_append(buf, off, cap, "/ is present in ");
            off = _hb_append(buf, off, cap, name);
            off = _hb_append(buf, off, cap, " (");
            off = _hb_append_int(buf, off, cap, phoneme_consonant_count(inv));
            off = _hb_append(buf, off, cap, "C + ");
            off = _hb_append_int(buf, off, cap, phoneme_vowel_count(inv));
            off = _hb_append(buf, off, cap, "V inventory)");
            store8(buf + off, 0);
            # v1.x's serde_json::to_value(inv.find(ipa)): the phoneme itself.
            var data = str_builder_new();
            phoneme_to_json(phoneme_find(inv, ipa), data);
            return _query_response_new(0, ResponseSource.VarnaData, buf, 1000, str_cstr(str_builder_build(data)));
        }
        var cap2 = 256;
        var b2 = alloc(cap2);
        var o2 = 0;
        o2 = _hb_append(b2, o2, cap2, "/");
        o2 = _hb_append(b2, o2, cap2, ipa);
        o2 = _hb_append(b2, o2, cap2, "/ is not in the ");
        o2 = _hb_append(b2, o2, cap2, name);
        o2 = _hb_append(b2, o2, cap2, " phoneme inventory");
        store8(b2 + o2, 0);
        return _query_response_new(0, ResponseSource.VarnaData, b2, 1000, 0);
    }
    if (tag == LanguageQueryTag.ComparativeAnalysis) {
        var langs = load64(q + 8);
        var aspect = load64(q + 16);
        if (aspect == ComparisonAspect.Phonology && vec_len(langs) == 2) {
            var inv1 = registry_phonemes(vec_get(langs, 0));
            var inv2 = registry_phonemes(vec_get(langs, 1));
            if (inv1 == 0 || inv2 == 0) { return 0; }
            var cap = 256;
            var buf = alloc(cap);
            var off = 0;
            off = _hb_append(buf, off, cap, phoneme_language_name(inv1));
            off = _hb_append(buf, off, cap, " has ");
            off = _hb_append_int(buf, off, cap, phoneme_consonant_count(inv1));
            off = _hb_append(buf, off, cap, "C+");
            off = _hb_append_int(buf, off, cap, phoneme_vowel_count(inv1));
            off = _hb_append(buf, off, cap, "V, ");
            off = _hb_append(buf, off, cap, phoneme_language_name(inv2));
            off = _hb_append(buf, off, cap, " has ");
            off = _hb_append_int(buf, off, cap, phoneme_consonant_count(inv2));
            off = _hb_append(buf, off, cap, "C+");
            off = _hb_append_int(buf, off, cap, phoneme_vowel_count(inv2));
            off = _hb_append(buf, off, cap, "V");
            store8(buf + off, 0);
            return _query_response_new(0, ResponseSource.VarnaData, buf, 1000, 0);
        }
        return 0;
    }
    return 0;
}

# --- JSON -----------------------------------------------------------------
#
# v1.x's LanguageQuery has struct variants, externally tagged:
#   {"IdentifyLanguage":{"text":".."}}
#   {"ExplainPhonology":{"language":"en","topic":".."}}
#   {"ExamplesForPhoneme":{"language":"en","ipa":"θ","count":3}}
#   {"ComparativeAnalysis":{"languages":["en","de"],"aspect":"Phonology"}}
#   {"EtymologyLookup":{"word":"..","source_language":"fr"}}
# QueryResponse: {"query_id":null,"source":"VarnaData","content":"..","confidence":1.0,
#                 "structured_data":{..}}

# Append query `q`. Returns 0, or -1 (nothing written) for a null query or one whose
# tag names no variant.
fn language_query_to_json(q, sb) {
    if (q == 0) { return 0 - 1; }
    var tag = load64(q);
    if (tag < LanguageQueryTag.IdentifyLanguage || tag > LanguageQueryTag.EtymologyLookup) { return 0 - 1; }
    str_builder_putc(sb, '{');
    LanguageQueryTag_to_json(tag, sb);
    if (tag == LanguageQueryTag.IdentifyLanguage) {
        str_builder_add_cstr(sb, ":{\"text\":");
        str_builder_add_json_cstr(sb, load64(q + 8));
    } elif (tag == LanguageQueryTag.ExplainPhonology) {
        str_builder_add_cstr(sb, ":{\"language\":");
        str_builder_add_json_cstr(sb, load64(q + 8));
        str_builder_add_cstr(sb, ",\"topic\":");
        str_builder_add_json_cstr(sb, load64(q + 16));
    } elif (tag == LanguageQueryTag.ExamplesForPhoneme) {
        str_builder_add_cstr(sb, ":{\"language\":");
        str_builder_add_json_cstr(sb, load64(q + 8));
        str_builder_add_cstr(sb, ",\"ipa\":");
        str_builder_add_json_cstr(sb, load64(q + 16));
        str_builder_add_cstr(sb, ",\"count\":");
        str_builder_add_int(sb, load64(q + 24));
    } elif (tag == LanguageQueryTag.ComparativeAnalysis) {
        str_builder_add_cstr(sb, ":{\"languages\":");
        _json_cstr_array(sb, load64(q + 8));
        str_builder_add_cstr(sb, ",\"aspect\":");
        ComparisonAspect_to_json(load64(q + 16), sb);
    } else {
        str_builder_add_cstr(sb, ":{\"word\":");
        str_builder_add_json_cstr(sb, load64(q + 8));
        str_builder_add_cstr(sb, ",\"source_language\":");
        str_builder_add_json_cstr(sb, load64(q + 16));
    }
    str_builder_add_cstr(sb, "}}");
    return 0;
}

fn _json_language_query(v) {
    if (!bayan_json_v_is_obj(v)) { return 0; }
    if (bayan_json_v_obj_len(v) != 1) { return 0; }
    var nb[48];
    if (_json_name_from_str(bayan_json_v_obj_key(v, 0), &nb) == 0) { return 0; }
    var t, x = LanguageQueryTag_from_json_str(&nb);
    if (is_ok(t) != 1) { return 0; }
    var tag = result_unwrap(t, x);
    # Every variant has a required field, so a body that is not an object refuses itself.
    var body = bayan_json_v_obj_val(v, 0);

    if (tag == LanguageQueryTag.ComparativeAnalysis) {
        var langs = _json_cstr_vec(bayan_json_v_obj_get_by_cstr(body, "languages"));
        var aspect = _json_enum(bayan_json_v_obj_get_by_cstr(body, "aspect"), &ComparisonAspect_from_json_str);
        if (langs == 0 || aspect < 0) { return 0; }
        var c = alloc(40);
        store64(c, tag);
        store64(c + 8, langs);
        store64(c + 16, aspect);
        return c;
    }
    if (tag == LanguageQueryTag.IdentifyLanguage) {
        var text = _json_cstr(bayan_json_v_obj_get_by_cstr(body, "text"));
        if (text == 0) { return 0; }
        return hoosh_identify(text);
    }
    if (tag == LanguageQueryTag.ExplainPhonology) {
        var lang = _json_cstr(bayan_json_v_obj_get_by_cstr(body, "language"));
        var topic = _json_cstr(bayan_json_v_obj_get_by_cstr(body, "topic"));
        if (lang == 0 || topic == 0) { return 0; }
        return hoosh_explain_phonology(lang, topic);
    }
    if (tag == LanguageQueryTag.ExamplesForPhoneme) {
        var lg = _json_cstr(bayan_json_v_obj_get_by_cstr(body, "language"));
        var ipa = _json_cstr(bayan_json_v_obj_get_by_cstr(body, "ipa"));
        var count = _json_u8(bayan_json_v_obj_get_by_cstr(body, "count"));
        if (lg == 0 || ipa == 0 || count < 0) { return 0; }
        return hoosh_examples_for_phoneme(lg, ipa, count);
    }
    var word = _json_cstr(bayan_json_v_obj_get_by_cstr(body, "word"));
    var src = _json_cstr(bayan_json_v_obj_get_by_cstr(body, "source_language"));
    if (word == 0 || src == 0) { return 0; }
    return hoosh_etymology_lookup(word, src);
}

# A language query from NUL-terminated JSON text, or 0.
#must_use
fn language_query_from_json(text) {
    return _json_language_query(_json_parse(text));
}

# Append per-mille `c` as the number v1.x wrote, or null for None: 1000 is 1.0, 875 is
# 0.875. serde_json prints the shortest form, so trailing zeros go, but one digit always
# follows the point, since 1.0 is a float and 1 is not.
fn _json_confidence_write(sb, c) {
    if (c < 0) { return str_builder_add_cstr(sb, "null"); }
    str_builder_add_int(sb, c / 1000);
    str_builder_putc(sb, '.');
    var frac = c % 1000;
    if (frac == 0) { return str_builder_putc(sb, '0'); }
    str_builder_putc(sb, '0' + frac / 100);
    frac = frac % 100;
    if (frac == 0) { return 0; }
    str_builder_putc(sb, '0' + frac / 10);
    frac = frac % 10;
    if (frac == 0) { return 0; }
    return str_builder_putc(sb, '0' + frac);
}

# `confidence`: per-mille rounded to nearest, -1 for None (absent or null), or -2 for
# anything else, including a number outside 0.0..1.0, the range v1.x documents. A
# negative one could otherwise round onto the None sentinel. An integer reads too, as
# serde reads 1 into an f64.
fn _json_confidence(v) {
    if (v == 0 || bayan_json_v_is_null(v)) { return 0 - 1; }
    if (!bayan_json_v_is_float(v) && !bayan_json_v_is_int(v)) { return 0 - 2; }
    var f = bayan_json_v_float(v);
    if (f64_lt(f, 0.0) || f64_gt(f, 1.0)) { return 0 - 2; }
    return f64_to(f64_round(f64_mul(f, f64_from(1000))));
}

# Append response `r`. Returns 0, or -1 (nothing written) for a null one.
fn query_response_to_json(r, sb) {
    if (r == 0) { return 0 - 1; }
    str_builder_add_cstr(sb, "{\"query_id\":");
    _json_opt_cstr_write(sb, hoosh_response_query_id(r));
    str_builder_add_cstr(sb, ",\"source\":");
    ResponseSource_to_json(hoosh_response_source(r), sb);
    str_builder_add_cstr(sb, ",\"content\":");
    str_builder_add_json_cstr(sb, hoosh_response_content(r));
    str_builder_add_cstr(sb, ",\"confidence\":");
    _json_confidence_write(sb, hoosh_response_confidence(r));
    str_builder_add_cstr(sb, ",\"structured_data\":");
    var data = hoosh_response_structured_data(r);
    if (data == 0) {
        str_builder_add_cstr(sb, "null");
    } else {
        str_builder_add_cstr(sb, data);
    }
    str_builder_putc(sb, '}');
    return 0;
}

fn _json_query_response(v) {
    if (!bayan_json_v_is_obj(v)) { return 0; }
    var id = _json_opt_cstr(bayan_json_v_obj_get_by_cstr(v, "query_id"));
    if (id < 0) { return 0; }
    var source = _json_enum(bayan_json_v_obj_get_by_cstr(v, "source"), &ResponseSource_from_json_str);
    if (source < 0) { return 0; }
    var content = _json_cstr(bayan_json_v_obj_get_by_cstr(v, "content"));
    if (content == 0) { return 0; }
    var conf = _json_confidence(bayan_json_v_obj_get_by_cstr(v, "confidence"));
    if (conf < 0 - 1) { return 0; }
    # Option<Value>: absent and null are both None, and any other JSON is held as text.
    var data = 0;
    var dv = bayan_json_v_obj_get_by_cstr(v, "structured_data");
    if (dv != 0 && !bayan_json_v_is_null(dv)) { data = str_cstr(bayan_json_v_build(dv)); }
    return _query_response_new(id, source, content, conf, data);
}

# A query response from NUL-terminated JSON text, or 0.
#must_use
fn query_response_from_json(text) {
    return _json_query_response(_json_parse(text));
}

#endif
