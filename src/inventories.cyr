fn phoneme_russian() {

    var b = phoneme_builder_with_capacity("ru", "Russian", 38);
    phoneme_builder_stress(b, StressPattern.Free);
    # Plosives (plain / palatalized pairs)
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant(b, "pʲ", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "bʲ", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Dental, 0);
    phoneme_builder_consonant(b, "tʲ", Manner.Plosive, Place.Dental, 0);
    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Dental, 1);
