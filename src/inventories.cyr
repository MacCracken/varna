    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel_full(b, "iː", Height.Close, Backness.Front, 0, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "o", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel_full(b, "oː", Height.CloseMid, Backness.Back, 1, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    phoneme_builder_vowel_full(b, "uː", Height.Close, Backness.Back, 1, PhonemeFeature.Long);
    _c_phoneme_czech = phoneme_builder_build(b);
    return _c_phoneme_czech;
}

