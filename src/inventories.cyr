    phoneme_builder_vowel(b, "eː", Height.OpenMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "aː", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "oː", Height.OpenMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "uː", Height.Close, Backness.Back, 1);
