    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    phoneme_builder_vowel(b, "ɨ", Height.Close, Backness.Central, 0);
    # Nasal vowels. Corrected at 2.5.4: they were written with the precomposed letters
    # (U+00E3 ã and kin) and carried no Nasalized bit, so features.cyr read all five as
    # [−nasal]. The vowel test could not see it, because it checks the combining tilde.
