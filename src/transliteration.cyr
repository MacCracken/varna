# Arabic → Latin, ALA-LC (Library of Congress, Arabic Romanization Table, 2012
# version), read from the LoC PDF. PARTIAL: ALA-LC romanizes the word as pronounced,
# so unvowelled text gives the consonant skeleton (كتب is "ktb"; ALA-LC's kitāb needs
# the short vowels written). Fully vowelled text gives ALA-LC's forms, except where a
# rule needs word position or grammar, which this table cannot see. Left out:
#   - initial hamzah, not written (rule 8(a)), so أسد is "ʼsd", not asad; and initial
#     آ is ā (10(a)), so it reads ʼā here;
#   - tāʼ marbūṭah as t in the construct state (7(b)); it is always h;
#   - final ِيّ as ī (6(b), 6(c), 11(b)(2)); it reads īy;
#   - the article: al with a hyphen (17), so ال reads l; tanwīn where it is kept (12);
#     vowel endings dropped in pause (14); the prime on a mid-word final form
#     (21(b)); capitalization (18); defective long vowels (19);
#   - the letters for non-Arabic consonants (p. 2), whose values the table says vary
#     by country; it also prints U+0686 for both its ch and its zh.
# ʻ and ʼ are U+02BB and U+02BC, as MARC 21 maps ALA-LC's ayn and alif (LoC, MARC 21
# code tables, Extended Latin) and as the ALA-LC Hebrew PDF prints them; this PDF
# typesets them as curly quotes, U+2018/U+2019.
# The prime is U+02B9.
var _c_translit_arabic_alalc = 0;
fn translit_arabic_alalc() {
    if (_c_translit_arabic_alalc != 0) { return _c_translit_arabic_alalc; }
    var tt = _tt_new("ALA-LC Arabic", "Arab", "Latn");
    # The letters (table, p. 1). ة before ه, so the reverse map gives ه for h.
    _tt_add(tt, "ب", "b");
    _tt_add(tt, "ت", "t");
    _tt_add(tt, "ث", "th");
    _tt_add(tt, "ج", "j");
    _tt_add(tt, "ح", "ḥ");
    _tt_add(tt, "خ", "kh");
    _tt_add(tt, "د", "d");
    _tt_add(tt, "ذ", "dh");
    _tt_add(tt, "ر", "r");
    _tt_add(tt, "ز", "z");
    _tt_add(tt, "س", "s");
    _tt_add(tt, "ش", "sh");
    _tt_add(tt, "ص", "ṣ");
    _tt_add(tt, "ض", "ḍ");
    _tt_add(tt, "ط", "ṭ");
    _tt_add(tt, "ظ", "ẓ");
    _tt_add(tt, "ع", "ʻ");
    _tt_add(tt, "غ", "gh");
    _tt_add(tt, "ف", "f");
    _tt_add(tt, "ق", "q");
    _tt_add(tt, "ك", "k");
    _tt_add(tt, "ل", "l");
    _tt_add(tt, "م", "m");
    _tt_add(tt, "ن", "n");
    _tt_add(tt, "ة", "h");
    _tt_add(tt, "ه", "h");
    _tt_add(tt, "و", "w");
    _tt_add(tt, "ي", "y");
    _tt_add(tt, "ڢ", "f");
    _tt_add(tt, "ڧ", "q");
    # Alif: "omit" (table); its long-vowel use is fatha + alif below.
    _tt_add(tt, "ا", "");
    _tt_add(tt, "ٱ", "");
    _tt_add(tt, "آ", "ʼā");
    # Hamzah: medial and final, rule 8(a); its seats are not written (rule 2). Initial
    # hamzah, not written, is left out. ء last, so the reverse map gives it.
    _tt_add(tt, "أ", "ʼ");
    _tt_add(tt, "إ", "ʼ");
    _tt_add(tt, "ؤ", "ʼ");
    _tt_add(tt, "ئ", "ʼ");
    _tt_add(tt, "ء", "ʼ");
    # Vowel signs (table). Tanwin is "normally disregarded" (rule 12) and sukun marks
    # no vowel, so both write nothing.
    _tt_add(tt, "َ", "a");
    _tt_add(tt, "ُ", "u");
    _tt_add(tt, "ِ", "i");
    _tt_add(tt, "ً", "");
    _tt_add(tt, "ٌ", "");
    _tt_add(tt, "ٍ", "");
    _tt_add(tt, "ْ", "");
    # Long vowels and diphthongs (table, pp. 1-2; rule 1). The table prints the ya
    # combinations with dotless ى; modern text writes ي, so both are listed.
    _tt_add(tt, "َا", "ā");
    _tt_add(tt, "َى", "á");
    _tt_add(tt, "ِى", "ī");
    _tt_add(tt, "ِي", "ī");
    _tt_add(tt, "ُو", "ū");
    _tt_add(tt, "َوْ", "aw");
    _tt_add(tt, "َىْ", "ay");
    _tt_add(tt, "َيْ", "ay");
    # Shaddah after damma + و and kasra + ي is the long vowel plus the consonant
    # (rule 11(a)(1), 11(b)(1)): ūw, īy. Final ِيّ is ī (11(b)(2)), which needs word
    # position, so it reads īy. After fatha, aww and ayy (11(a)(2), 11(b)(3)) are the
    # doubling below.
    _tt_add(tt, "ُوّ", "ūw");
