# src/logging.cyr — optional logging init (-D LOGGING).
#
# Ported from rust-old/src/logging.rs. The v1.x tracing-subscriber + VARNA_LOG
# env-filter is approximated by a level-gated stderr writer (lib/io.cyr). Reading
# the VARNA_LOG env var and routing through sakshi are future enhancements (see
# ADR 0001's logging note) — kept dependency-light here to stay warning-free.
#
# Levels: 0=trace 1=debug 2=info 3=warn 4=error.

#ifdef LOGGING

var _varna_log_level = 2;

fn _varna_level_from_str(level) {
    if (streq(level, "trace") == 1) { return 0; }
    if (streq(level, "debug") == 1) { return 1; }
    if (streq(level, "info") == 1) { return 2; }
    if (streq(level, "warn") == 1) { return 3; }
    if (streq(level, "error") == 1) { return 4; }
    return 2;
}

# Initialise logging at a custom default level (VARNA_LOG would override here).
fn varna_log_init_with_level(level) {
    _varna_log_level = _varna_level_from_str(level);
    return 0;
}

# Initialise logging with default level `info`.
fn varna_log_init() {
    return varna_log_init_with_level("info");
}

fn varna_log_level() { return _varna_log_level; }

# Emit `msg` at `level` to stderr if at or above the configured threshold.
fn varna_log(level, msg) {
    if (level >= _varna_log_level) {
        eprint(msg, strlen(msg));
        eprint("\n", 1);
    }
    return 0;
}

#endif
