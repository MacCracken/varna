[package]
name = "varna"
version = "${file:VERSION}"
description = "Varna — multilingual language engine: phoneme inventories, writing systems, grammar profiles, and lexicon access for 50+ languages"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/varna"
language = "cyrius"
cyrius = "6.5.35"

[build]
entry = "src/main.cyr"
output = "build/varna"

# `[lib]` lets `cyrius distlib` concatenate src/ into a single
# dist/varna.cyr bundle for downstream consumers (shabda, shabdakosh,
# svara, sankhya, jnana, vidya) that fold the language engine in as one
# file. Order mirrors the include order in src/main.cyr — load-bearing
# for Cyrius single-pass forward-reference resolution.
#   cyrius distlib       → dist/varna.cyr       (full data engine)
#   cyrius distlib core  → dist/varna-core.cyr  ([lib.core], no AI surfaces)
[lib]
modules = [
    "src/error.cyr",
    "src/util.cyr",
    "src/tone.cyr",
    "src/phoneme.cyr",
    "src/features.cyr",
    "src/inventories.cyr",
    "src/allophone.cyr",
    "src/syllable.cyr",
    "src/grammar.cyr",
    "src/lexicon.cyr",
    "src/swadesh.cyr",
    "src/cognate.cyr",
    "src/dialect.cyr",
    "src/script.cyr",
    "src/registry.cyr",
    "src/numerals.cyr",
    "src/transliteration.cyr",
]

# Core-only bundle: the linguistic data engine without the optional AI
# integration surfaces (mcp / daimon / hoosh), which compile in only
# under their -D defines. Consumers that want just phoneme/script/
# grammar/lexicon data fold this.
[lib.core]
modules = [
    "src/error.cyr",
    "src/util.cyr",
    "src/tone.cyr",
    "src/phoneme.cyr",
    "src/features.cyr",
    "src/inventories.cyr",
    "src/allophone.cyr",
    "src/syllable.cyr",
    "src/grammar.cyr",
    "src/lexicon.cyr",
    "src/swadesh.cyr",
    "src/cognate.cyr",
    "src/dialect.cyr",
    "src/script.cyr",
    "src/registry.cyr",
    "src/numerals.cyr",
    "src/transliteration.cyr",
]

# ── Dependencies ─────────────────────────────────────────────────
# Cyrius-stdlib modules. `cyrius deps` copies these from the version-
# pinned toolchain snapshot into ./lib/ (gitignored). The list mirrors
# the include order at the top of src/main.cyr so the manifest stays
# load-bearing.
#
# Rust → Cyrius dependency map (the v1.x crate's Cargo deps):
#   serde + serde_json  →  bayan           (JSON: #derive(Serialize) + json_parse/json_build)
#   thiserror           →  result + tagged (native enum + Result<T,E>, lib/result.cyr)
#   tracing             →  sakshi          (structured logging/audit — added with -D LOGGING)
#   tracing-subscriber  →  sakshi          (no separate subscriber; env-filter wired by hand)
#   criterion (dev)     →  cyrius bench    (lib/bench.cyr; benches/*.bcyr)
#
# Core data-engine deps ONLY. The optional surfaces add their own deps
# WITH their module, so the core build stays lean (no crypto/thread/log
# closure dragged in):
#   -D LOGGING (src/logging.cyr) → add "sakshi"
#   -D MCP     (src/mcp.cyr)     → add [deps.bote] + "chrono", the one
#                                  stdlib leaf its sidecar needs that is
#                                  not already declared below
[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "slice",
    "syscalls",
    "io",
    "args",
    "assert",
    "hashmap",
    "bayan",
    "fnptr",
    "tagged",
    "result",
    "bench",
]

# --- Added with -D MCP (src/mcp.cyr), not before -------------------
# bote is the AGNOS MCP / JSON-RPC core, consumed as the transport-free
# `dist/bote-core.cyr` bundle — 12 modules at 3.3.7 (error, protocol,
# jsonx, registry, prompts, resources, events, audit, dispatch, codec,
# schema, content). `cyrius deps` copies it into lib/bote-core.cyr.
#
# Its `dist/bote-core.deps` sidecar declares the stdlib leaves it needs:
# hashmap, bayan, string, alloc, vec, str, fnptr, chrono, tagged. All but
# `chrono` are already in [deps].stdlib above, so enabling this dep means
# appending exactly one entry — no crypto/thread closure is dragged in.
#
# Kept commented on purpose: src/mcp.cyr hand-builds its JSON today and
# links nothing from bote, so the recipe is documentation of how to wire
# it, not an active dependency. bote 3.3.7 pins Cyrius 6.5.35, matching
# [package].cyrius above.
#
# NOTE: the v1.x `daimon` and `hoosh` Cargo features did NOT link those
# crates — they only flipped on serde_json. Their Cyrius equivalents are
# pure -D DAIMON / -D HOOSH build defines (JSON via bayan, already a
# stdlib dep), so neither needs a [deps.*] entry. daimon and hoosh ship
# as Cyrius binaries today with no consumable [lib]/dist bundle.
#
# [deps.bote]
# git = "https://github.com/MacCracken/bote"
# path = "../bote"
# tag = "3.3.7"
# modules = ["dist/bote-core.cyr"]
