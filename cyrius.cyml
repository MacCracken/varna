[package]
name = "varna"
version = "${file:VERSION}"
description = "Varna — multilingual language engine: phoneme inventories, writing systems, grammar profiles, and lexicon access for 50+ languages"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/varna"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/varna"

# `[lib]` lets `cyrius distlib` concatenate src/ into a single
# dist/varna.cyr bundle for downstream consumers (shabda, shabdakosh,
# svara, sankhya, jnana) that fold the language engine in as one
# file. Order mirrors the include order in src/main.cyr — load-bearing
# for Cyrius single-pass forward-reference resolution.
#   cyrius distlib       → dist/varna.cyr       (full data engine)
#   cyrius distlib core  → dist/varna-core.cyr  ([lib.core], no AI surfaces)
#   cyrius distlib json  → dist/varna-json.cyr  ([lib.json], the engine + JSON)
[lib]
modules = [
    "src/error.cyr",
    "src/util.cyr",
    "src/sources.cyr",
    "src/tone.cyr",
    "src/phoneme.cyr",
    "src/features.cyr",
    "src/inventories.cyr",
    "src/allophone.cyr",
    "src/syllable.cyr",
    "src/grammar.cyr",
    "src/lexicon.cyr",
    "src/swadesh.cyr",
    "src/cognate.cyr",
    "src/dialect.cyr",
    "src/script.cyr",
    "src/registry.cyr",
    "src/numerals.cyr",
    "src/transliteration.cyr",
]

# Core-only bundle: the linguistic data engine without the optional AI
# integration surfaces (mcp / daimon / hoosh), which compile in only
# under their -D defines. Consumers that want just phoneme/script/
# grammar/lexicon data fold this.
[lib.core]
modules = [
    "src/error.cyr",
    "src/util.cyr",
    "src/sources.cyr",
    "src/tone.cyr",
    "src/phoneme.cyr",
    "src/features.cyr",
    "src/inventories.cyr",
    "src/allophone.cyr",
    "src/syllable.cyr",
    "src/grammar.cyr",
    "src/lexicon.cyr",
    "src/swadesh.cyr",
    "src/cognate.cyr",
    "src/dialect.cyr",
    "src/script.cyr",
    "src/registry.cyr",
    "src/numerals.cyr",
    "src/transliteration.cyr",
]

# The engine plus src/json.cyr. A superset of dist/varna.cyr, so a consumer folds one or
# the other. JSON calls bayan, and this is the only bundle that does, so the choice of
# bayan stays the consumer's and dist/varna.cyr keeps working with no bayan in scope.
# A consumer folding this one declares either bayan's thin profile:
#   [deps.bayan]
#   git = "https://github.com/MacCracken/bayan.git"
#   tag = "1.11.1"
#   modules = ["dist/bayan-json.cyr"]
# or the "bayan" stdlib monolith, as shabda and shabdakosh do, but never both: that
# defines 27 JSON symbols twice. With neither, the build refuses, naming the bayan_json_*
# calls. The sidecar lists neither, because which one is the consumer's choice.
[lib.json]
modules = [
    "src/error.cyr",
    "src/util.cyr",
    "src/sources.cyr",
    "src/tone.cyr",
    "src/phoneme.cyr",
    "src/features.cyr",
    "src/inventories.cyr",
    "src/allophone.cyr",
    "src/syllable.cyr",
    "src/grammar.cyr",
    "src/lexicon.cyr",
    "src/swadesh.cyr",
    "src/cognate.cyr",
    "src/dialect.cyr",
    "src/script.cyr",
    "src/registry.cyr",
    "src/numerals.cyr",
    "src/transliteration.cyr",
    "src/json.cyr",
]

# ── Dependencies ─────────────────────────────────────────────────
# Cyrius-stdlib modules. `cyrius deps` copies these from the version-
# pinned toolchain snapshot into ./lib/ (gitignored). The list mirrors
# the include order at the top of src/main.cyr so the manifest stays
# load-bearing.
#
# Rust → Cyrius dependency map (the v1.x crate's Cargo deps):
#   serde + serde_json  →  bayan-json      ([deps.bayan] below, called by src/json.cyr)
#   thiserror           →  result + tagged (native enum + Result<T,E>, lib/result.cyr)
#   tracing             →  sakshi          (structured logging/audit — added with -D LOGGING)
#   tracing-subscriber  →  sakshi          (no separate subscriber; env-filter wired by hand)
#   criterion (dev)     →  cyrius bench    (lib/bench.cyr; benches/*.bcyr)
#
# Core data-engine deps, plus sakshi for -D LOGGING (2.5.4). The other
# optional surfaces add their own deps WITH their module:
#   -D LOGGING (src/logging.cyr) → "sakshi", declared above since 2.5.4. It is
#                                  prepended to every varna build (+29.8 KB
#                                  default, +9.3 KB under CYRIUS_DCE=1), and does
#                                  not reach dist/*.deps: a consumer that folds
#                                  dist/varna.cyr with -D LOGGING declares
#                                  "sakshi" itself.
#   -D MCP     (src/mcp.cyr)     → add [deps.bote]; its sidecar brings
#                                  the leaves it needs (see the recipe
#                                  at the bottom of this file)
[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "slice",
    "syscalls",
    "io",
    "args",
    "hashmap",
    "fnptr",
    "tagged",
    "result",
    "sakshi",
]

# Test / bench / fuzz compiles only (cyrius 6.7.6+). `assert` and `bench` were in
# [deps].stdlib until 2.5.4, which prepended them to every library build as well;
# no file under src/ calls either. They are still vendored and locked by every
# resolve, so cyrius.lock keeps them.
[test]
stdlib = ["assert", "bench"]

# --- bayan: the serde / serde_json replacement --------------------
# bayan ships one profile per format. varna needs JSON only, so it takes
# the thin `dist/bayan-json.cyr` profile as a named dep, NOT the `bayan`
# stdlib monolith. At cyrius 6.7.18 the monolith carries math plus ~353 KB
# of Unicode tables that DCE cannot drop: varna's live (CYRIUS_DCE=1)
# binary was 414,664 B with it and is 44,408 B with this profile. Never
# list "bayan" in [deps].stdlib as well — both files would be vendored
# and 27 JSON symbols defined twice (last definition wins). The profile
# omits the short `json_v_*` aliases; call the qualified `bayan_json_v_*`.
#
# The tag tracks the bayan the toolchain pin vendors (cyrius 6.7.18 →
# bayan 1.11.1), the same tag mihi, samay, iam and ai-hwaccel take.
#
# Optional, on by default: [features] resolve from the ROOT manifest
# only, so varna's own builds and tests get it and downstream consumers
# do not. That matters because shabda and shabdakosh declare the bayan
# monolith in their own [deps].stdlib; pulling the profile into them
# too would hit that double definition. So it stays optional, and only
# dist/varna-json.cyr calls bayan ([lib.json] above).
[features]
default = ["bayan"]

[deps.bayan]
optional = true
git = "https://github.com/MacCracken/bayan.git"
tag = "1.11.1"
modules = ["dist/bayan-json.cyr"]

# --- Added with -D MCP (src/mcp.cyr), not before -------------------
# bote is the AGNOS MCP / JSON-RPC core, consumed as the transport-free
# `dist/bote-core.cyr` bundle — 15 modules at 3.8.14 (log, error,
# protocol, jsonx, regex, format, registry, prompts, resources, events,
# audit, dispatch, codec, schema, content). `cyrius deps` copies it into
# lib/bote-core.cyr. The bundle states its own minimum toolchain, cyrius
# 6.7.13; varna's 6.7.18 pin clears that.
#
# Since cyrius 6.6.18 a sidecar names only the leaves distlib's compile-
# verify proves, and the bundle opens with a matching `# Requires` include
# block. At 3.8.14 `dist/bote-core.deps` is `hashmap sys`; the rest arrive
# through those leaves' own requires blocks, so nothing needs appending to
# [deps].stdlib by hand. The sigil crypto fold that `sigil ct` dragged in
# through 3.4.x is gone, dropped once cyrius 6.7.13's distlib stopped
# recording a named dep's kept fold as the bundle's need. One indirect
# need remains: the `log` module calls sakshi, which a [deps.bote] pin
# receives through bote's own libro dep. (Copying the bundle by hand
# instead would mean declaring "sakshi" here.) The default build is
# unaffected either way.
#
# Since cyrius 6.7.6 a `path` beside `git` / `tag` is a dev override, read
# only in local mode (`--local` / CYRIUS_LOCAL=1). A default build always
# builds the tag and checks its commit pin in cyrius.lock.
#
# Kept commented on purpose: src/mcp.cyr builds its JSON with src/json.cyr
# and links nothing from bote, so the recipe is documentation of how to
# wire it, not an active dependency. bote 3.8.14 is bote's latest release and
# pins Cyrius 6.7.18, the same pin as varna 2.5.2.
#
# NOTE: the v1.x `daimon` and `hoosh` Cargo features did NOT link those
# crates — they only flipped on serde_json. Their Cyrius equivalents are
# pure -D DAIMON / -D HOOSH build defines (JSON via src/json.cyr and the
# [deps.bayan] profile above), so neither needs a [deps.*] entry of its
# own. daimon and hoosh ship
# as Cyrius binaries today with no consumable [lib]/dist bundle.
#
# [deps.bote]
# git = "https://github.com/MacCracken/bote"
# path = "../bote"
# tag = "3.8.14"
# modules = ["dist/bote-core.cyr"]
