# tests/script.tcyr — script module parity tests (v1.x Rust src/script/mod.rs).

include "src/script.cyr"

# True if any cstring in vec `v` equals `target`.
fn _lang_has(v, target) {
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(v, i), target) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();

    test_group("latin");
    var la = script_latin();
    assert(streq(script_code(la), "Latn"), "latin code");
    assert_eq(script_type(la), ScriptType.Alphabet, "latin alphabet");
    assert_eq(script_direction(la), Direction.LeftToRight, "latin LTR");
    assert(script_contains_codepoint(la, 0x0041), "latin has A");
    assert_eq(script_contains_codepoint(la, 0x0600), 0, "latin lacks Arabic range");
    # boundary checks
    assert(script_contains_codepoint(la, 0x005A), "latin end A-Z");
    assert_eq(script_contains_codepoint(la, 0x0040), 0, "latin just before A");
    assert_eq(script_contains_codepoint(la, 0x005B), 0, "latin just after Z");

    test_group("arabic");
    var ar = script_arabic();
    assert(streq(script_code(ar), "Arab"), "arabic code");
    assert_eq(script_type(ar), ScriptType.Abjad, "arabic abjad");
    assert_eq(script_direction(ar), Direction.RightToLeft, "arabic RTL");
    assert(script_contains_codepoint(ar, 0x0627), "arabic alef");

    test_group("others");
    var dv = script_devanagari();
    assert(streq(script_code(dv), "Deva"), "deva code");
    assert_eq(script_type(dv), ScriptType.Abugida, "deva abugida");
    assert(_lang_has(script_languages(dv), "sa"), "deva used by sanskrit");
    var hani = script_cjk();
    assert_eq(script_type(hani), ScriptType.Logographic, "cjk logographic");
    assert(script_contains_codepoint(hani, 0x4E00), "cjk first ideograph");
    var cy = script_cyrillic();
    assert(script_contains_codepoint(cy, 0x0410), "cyrillic A");
    var ha = script_hangul();
    assert(script_contains_codepoint(ha, 0xAC00), "hangul first syllable");
    var ka = script_kana();
    assert_eq(script_type(ka), ScriptType.Syllabary, "kana syllabary");
    assert(script_contains_codepoint(ka, 0x3042), "kana hiragana a");
    assert(script_contains_codepoint(ka, 0x30A2), "kana katakana a");
    var gr = script_greek();
    assert(script_contains_codepoint(gr, 0x03B1), "greek alpha");
    assert(script_contains_codepoint(gr, 0x03C0), "greek pi");

    test_group("historical");
    var xs = script_cuneiform();
    assert(streq(script_code(xs), "Xsux"), "cuneiform code");
    assert_eq(script_status(xs), ScriptStatus.Historical, "cuneiform historical");
    assert(script_contains_codepoint(xs, 0x12000), "cuneiform first sign");
    assert(_lang_has(script_languages(xs), "sux"), "cuneiform sumerian");
    assert(streq(script_attestation(xs), "3400 BCE – 75 CE"), "cuneiform attestation");
    var eg = script_egyptian();
    assert(streq(script_code(eg), "Egyp"), "egyptian code");
    assert_eq(script_status(eg), ScriptStatus.Historical, "egyptian historical");
    assert(script_contains_codepoint(eg, 0x13000), "egyptian first hieroglyph");

    test_group("lookup");
    assert(script_by_code("Latn") != 0, "by_code Latn");
    assert(script_by_code("Grek") != 0, "by_code Grek");
    assert_eq(script_by_code("XXXX"), 0, "by_code unknown");
    var codes = script_all_codes();
    assert_eq(vec_len(codes), 10, "10 script codes");
    var n = vec_len(codes);
    var i = 0;
    var missing = 0;
    while (i < n) {
        if (script_by_code(vec_get(codes, i)) == 0) { missing = missing + 1; }
        i = i + 1;
    }
    assert_eq(missing, 0, "all codes resolve via by_code");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
