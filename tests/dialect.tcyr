# tests/dialect.tcyr — dialect-overlay parity (v1.x Rust src/dialect.rs).

include "src/tone.cyr"
include "src/phoneme.cyr"
include "src/allophone.cyr"
include "src/dialect.cyr"

fn main() {
    alloc_init();
    test_group("british_english");
    var rp = dialect_british_english();
    assert(streq(dialect_parent(rp), "en"), "parent en");
    assert_eq(dialect_kind(rp), VarietyKind.NationalStandard, "national standard");
    assert(dialect_adds(rp, "ɒ"), "adds ɒ");
    assert(dialect_removes(rp, "ɹ"), "removes ɹ");
    assert_eq(dialect_adds(rp, "xyz"), 0, "no add xyz");
    assert_eq(vec_len(dialect_overrides(rp)), 1, "1 allophone override");

    test_group("apply");
    var ga = phoneme_english();
    var rp_inv = dialect_apply(rp, ga);
    assert(streq(phoneme_language_code(rp_inv), "en-GB"), "applied code en-GB");
    assert(phoneme_has(rp_inv, "ɒ"), "applied has ɒ (added)");
    assert_eq(phoneme_has(rp_inv, "ɹ"), 0, "applied removed ɹ");
    # parent inventory must be left unmodified
    assert(phoneme_has(ga, "ɹ"), "parent still has ɹ");
    assert_eq(phoneme_has(ga, "ɒ"), 0, "parent still lacks ɒ");

    test_group("variety_metadata");
    assert(streq(dialect_code(rp), "en-GB"), "code en-GB");
    assert(streq(dialect_name(rp), "British English (RP)"), "name RP");
    # dialect_adds/removes answer the membership question; the vecs behind them
    # are what dialect_apply walks, so their contents are pinned too.
    assert_eq(vec_len(dialect_added(rp)), 1, "1 added phoneme");
    assert(streq(vec_get(dialect_added(rp), 0), "ɒ"), "added[0] ɒ");
    assert_eq(vec_len(dialect_removed(rp)), 1, "1 removed phoneme");
    assert(streq(vec_get(dialect_removed(rp), 0), "ɹ"), "removed[0] ɹ");
    assert_eq(dialect_removes(rp, "ɒ"), 0, "added phoneme is not removed");

    test_group("allophone_overrides");
    # RP keeps intervocalic /t/ unflapped — the override restates t as itself,
    # which is only visible through the rule accessors.
    var ov = vec_get(dialect_overrides(rp), 0);
    assert(streq(allophone_rule_phoneme(ov), "t"), "override on t");
    assert(streq(allophone_rule_allophone(ov), "t"), "override keeps t");
    assert_eq(allophone_rule_environment(ov), Environment.Intervocalic, "override intervocalic");
    assert_eq(allophone_rule_obligatory(ov), 1, "override obligatory");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
