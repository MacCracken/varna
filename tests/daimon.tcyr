# tests/daimon.tcyr — daimon registration parity (v1.x Rust src/daimon.rs).

include "src/error.cyr"
include "src/util.cyr"
include "src/tone.cyr"
include "src/sources.cyr"
include "src/phoneme.cyr"
include "src/inventories.cyr"
include "src/allophone.cyr"
include "src/syllable.cyr"
include "src/grammar.cyr"
include "src/lexicon.cyr"
include "src/swadesh.cyr"
include "src/cognate.cyr"
include "src/dialect.cyr"
include "src/script.cyr"
include "src/registry.cyr"
include "src/numerals.cyr"
include "src/transliteration.cyr"
include "src/json.cyr"
#define DAIMON
include "src/daimon.cyr"

fn _vec_has(v, s) {
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(v, i), s) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();
    test_group("daimon");
    var reg = daimon_registration();
    assert(streq(daimon_name(reg), "varna"), "name varna");
    assert(strlen(daimon_version(reg)) > 0, "version not empty");
    # The registration hardcodes its version string, and it went stale for a whole
    # release: 2.4.2 shipped reporting "2.4.1". VERSION is the canonical source, so
    # hold the literal to it. `cyrius test` runs from the repo root.
    var vbuf = alloc(64);
    var vn = file_read_all("VERSION", vbuf, 63);
    assert(vn > 0, "VERSION readable from the repo root");
    if (vn > 0) {
        while (vn > 0 && load8(vbuf + vn - 1) <= 32) { vn = vn - 1; }
        store8(vbuf + vn, 0);
        assert(streq(daimon_version(reg), vbuf), "daimon version matches VERSION");
    }
    assert_eq(vec_len(daimon_capabilities(reg)), 6, "6 capabilities");
    assert(_vec_has(daimon_supported_languages(reg), "en"), "languages has en");
    assert(_vec_has(daimon_supported_scripts(reg), "Latn"), "scripts has Latn");
    assert_eq(vec_len(daimon_supported_languages(reg)), 51, "51 languages");
    assert_eq(vec_len(daimon_supported_scripts(reg)), 21, "21 scripts (9 added at 2.1.6, Glagolitic and Bopomofo at 2.6.0)");
    # first capability shape
    var c1 = vec_get(daimon_capabilities(reg), 0);
    assert(streq(capability_name(c1), "phoneme_lookup"), "cap0 name");
    assert_eq(vec_len(capability_inputs(c1)), 1, "cap0 1 input");
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
