# tests/daimon.tcyr — daimon registration parity (rust-old/src/daimon.rs).

include "src/phoneme.cyr"
include "src/inventories.cyr"
include "src/script.cyr"
include "src/registry.cyr"
#define DAIMON
include "src/daimon.cyr"

fn _vec_has(v, s) {
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(v, i), s) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();
    test_group("daimon");
    var reg = daimon_registration();
    assert(streq(daimon_name(reg), "varna"), "name varna");
    assert(strlen(daimon_version(reg)) > 0, "version not empty");
    assert_eq(vec_len(daimon_capabilities(reg)), 6, "6 capabilities");
    assert(_vec_has(daimon_supported_languages(reg), "en"), "languages has en");
    assert(_vec_has(daimon_supported_scripts(reg), "Latn"), "scripts has Latn");
    assert_eq(vec_len(daimon_supported_languages(reg)), 51, "51 languages");
    assert_eq(vec_len(daimon_supported_scripts(reg)), 10, "10 scripts");
    # first capability shape
    var c1 = vec_get(daimon_capabilities(reg), 0);
    assert(streq(capability_name(c1), "phoneme_lookup"), "cap0 name");
    assert_eq(vec_len(capability_inputs(c1)), 1, "cap0 1 input");
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
