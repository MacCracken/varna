# tests/allophone.tcyr — allophone parity (v1.x Rust src/phoneme/allophone.rs).

include "src/allophone.cyr"

fn main() {
    alloc_init();
    test_group("english_allophones");
    var r = allophone_english();
    assert(streq(allophone_language_code(r), "en"), "code en");
    assert(vec_len(allophone_rules(r)) > 0, "rules not empty");
    assert_eq(vec_len(allophone_rules_for(r, "t")), 2, "t has 2 rules");
    assert(streq(allophone_realize(r, "t", Environment.Intervocalic), "ɾ"), "t intervocalic flap");
    assert(streq(allophone_realize(r, "t", Environment.WordInitial), "tʰ"), "t word-initial aspirated");
    assert(streq(allophone_realize(r, "t", Environment.WordFinal), "t"), "t word-final unchanged");
    assert(streq(allophone_realize(r, "l", Environment.SyllableFinal), "ɫ"), "l dark");
    assert_eq(vec_len(allophone_rules_for(r, "ʀ")), 0, "unknown phoneme no rules");

    test_group("rule_fields");
    # allophone_realize collapses a rule to its output; the accessors are how a
    # consumer reads the rest of it (environment, obligatoriness).
    var trules = allophone_rules_for(r, "t");
    var flap = vec_get(trules, 0);
    assert(streq(allophone_rule_phoneme(flap), "t"), "flap phoneme t");
    assert(streq(allophone_rule_allophone(flap), "ɾ"), "flap allophone ɾ");
    assert_eq(allophone_rule_environment(flap), Environment.Intervocalic, "flap intervocalic");
    assert_eq(allophone_rule_obligatory(flap), 0, "flapping optional");
    var asp = vec_get(trules, 1);
    assert(streq(allophone_rule_phoneme(asp), "t"), "aspiration phoneme t");
    assert(streq(allophone_rule_allophone(asp), "tʰ"), "aspiration allophone tʰ");
    assert_eq(allophone_rule_environment(asp), Environment.WordInitial, "aspiration word-initial");
    assert_eq(allophone_rule_obligatory(asp), 1, "aspiration obligatory");
    # Vowel reduction is the one non-consonant rule and is optional.
    var schwa = vec_get(allophone_rules_for(r, "ə"), 0);
    assert(streq(allophone_rule_allophone(schwa), "ɨ"), "schwa raises to ɨ");
    assert_eq(allophone_rule_environment(schwa), Environment.Unstressed, "schwa unstressed");
    assert_eq(allophone_rule_obligatory(schwa), 0, "schwa raising optional");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
