# tests/inventories.tcyr — extended-inventory parity tests.
# Counts: 39 from the v1.x Rust inventory_test! macro + 9 verified against source.

include "src/error.cyr"
include "src/tone.cyr"
include "src/phoneme.cyr"
include "src/inventories.cyr"

fn main() {
    alloc_init();
    test_group("inv_counts");
    var iv = 0;
    iv = phoneme_yucatec_maya();
    assert(streq(phoneme_language_code(iv), "yua"), "yua code");
    assert_eq(phoneme_consonant_count(iv), 21, "yua consonants");
    assert_eq(phoneme_vowel_count(iv), 10, "yua vowels");
    iv = phoneme_swahili();
    assert(streq(phoneme_language_code(iv), "sw"), "sw code");
    assert_eq(phoneme_consonant_count(iv), 26, "sw consonants");
    assert_eq(phoneme_vowel_count(iv), 5, "sw vowels");
    iv = phoneme_yoruba();
    assert(streq(phoneme_language_code(iv), "yo"), "yo code");
    assert_eq(phoneme_consonant_count(iv), 18, "yo consonants");
    assert_eq(phoneme_vowel_count(iv), 7, "yo vowels");
    iv = phoneme_zulu();
    assert(streq(phoneme_language_code(iv), "zu"), "zu code");
    assert_eq(phoneme_consonant_count(iv), 42, "zu consonants");
    assert_eq(phoneme_vowel_count(iv), 5, "zu vowels");
    iv = phoneme_thai();
    assert(streq(phoneme_language_code(iv), "th"), "th code");
    assert_eq(phoneme_consonant_count(iv), 21, "th consonants");
    assert_eq(phoneme_vowel_count(iv), 9, "th vowels");
    iv = phoneme_vietnamese();
    assert(streq(phoneme_language_code(iv), "vi"), "vi code");
    assert_eq(phoneme_consonant_count(iv), 22, "vi consonants");
    assert_eq(phoneme_vowel_count(iv), 11, "vi vowels");
    iv = phoneme_tagalog();
    assert(streq(phoneme_language_code(iv), "tl"), "tl code");
    assert_eq(phoneme_consonant_count(iv), 18, "tl consonants");
    assert_eq(phoneme_vowel_count(iv), 5, "tl vowels");
    iv = phoneme_turkish();
    assert(streq(phoneme_language_code(iv), "tr"), "tr code");
    assert_eq(phoneme_consonant_count(iv), 20, "tr consonants");
    assert_eq(phoneme_vowel_count(iv), 8, "tr vowels");
    iv = phoneme_finnish();
    assert(streq(phoneme_language_code(iv), "fi"), "fi code");
    assert_eq(phoneme_consonant_count(iv), 17, "fi consonants");
    assert_eq(phoneme_vowel_count(iv), 16, "fi vowels");
    iv = phoneme_hawaiian();
    assert(streq(phoneme_language_code(iv), "haw"), "haw code");
    assert_eq(phoneme_consonant_count(iv), 8, "haw consonants");
    assert_eq(phoneme_vowel_count(iv), 10, "haw vowels");
    iv = phoneme_nahuatl();
    assert(streq(phoneme_language_code(iv), "nah"), "nah code");
    assert_eq(phoneme_consonant_count(iv), 16, "nah consonants");
    assert_eq(phoneme_vowel_count(iv), 8, "nah vowels");
    iv = phoneme_latin();
    assert(streq(phoneme_language_code(iv), "la"), "la code");
    assert_eq(phoneme_consonant_count(iv), 18, "la consonants");
    assert_eq(phoneme_vowel_count(iv), 10, "la vowels");
    iv = phoneme_classical_arabic();
    assert(streq(phoneme_language_code(iv), "ar"), "ar code");
    assert_eq(phoneme_consonant_count(iv), 28, "ar consonants");
    assert_eq(phoneme_vowel_count(iv), 6, "ar vowels");
    iv = phoneme_koine_greek();
    assert(streq(phoneme_language_code(iv), "grc"), "grc code");
    assert_eq(phoneme_consonant_count(iv), 17, "grc consonants");
    assert_eq(phoneme_vowel_count(iv), 5, "grc vowels");
    iv = phoneme_literary_chinese();
    assert(streq(phoneme_language_code(iv), "lzh"), "lzh code");
    assert_eq(phoneme_consonant_count(iv), 27, "lzh consonants");
    assert_eq(phoneme_vowel_count(iv), 12, "lzh vowels");
    iv = phoneme_mandarin();
    assert(streq(phoneme_language_code(iv), "zh"), "zh code");
    assert_eq(phoneme_consonant_count(iv), 21, "zh consonants");
    assert_eq(phoneme_vowel_count(iv), 7, "zh vowels");
    iv = phoneme_hindi();
    assert(streq(phoneme_language_code(iv), "hi"), "hi code");
    assert_eq(phoneme_consonant_count(iv), 34, "hi consonants");
    assert_eq(phoneme_vowel_count(iv), 10, "hi vowels");
    iv = phoneme_japanese();
    assert(streq(phoneme_language_code(iv), "ja"), "ja code");
    assert_eq(phoneme_consonant_count(iv), 20, "ja consonants");
    assert_eq(phoneme_vowel_count(iv), 5, "ja vowels");
    iv = phoneme_spanish();
    assert(streq(phoneme_language_code(iv), "es"), "es code");
    assert_eq(phoneme_consonant_count(iv), 23, "es consonants");
    assert_eq(phoneme_vowel_count(iv), 5, "es vowels");
    iv = phoneme_french();
    assert(streq(phoneme_language_code(iv), "fr"), "fr code");
    assert_eq(phoneme_consonant_count(iv), 21, "fr consonants");
    assert_eq(phoneme_vowel_count(iv), 16, "fr vowels");
    iv = phoneme_german();
    assert(streq(phoneme_language_code(iv), "de"), "de code");
    assert_eq(phoneme_consonant_count(iv), 23, "de consonants");
    assert_eq(phoneme_vowel_count(iv), 16, "de vowels");
    iv = phoneme_russian();
    assert(streq(phoneme_language_code(iv), "ru"), "ru code");
    assert_eq(phoneme_consonant_count(iv), 36, "ru consonants");
    assert_eq(phoneme_vowel_count(iv), 6, "ru vowels");
    iv = phoneme_korean();
    assert(streq(phoneme_language_code(iv), "ko"), "ko code");
    assert_eq(phoneme_consonant_count(iv), 19, "ko consonants");
    assert_eq(phoneme_vowel_count(iv), 7, "ko vowels");
    iv = phoneme_portuguese();
    assert(streq(phoneme_language_code(iv), "pt"), "pt code");
    assert_eq(phoneme_consonant_count(iv), 23, "pt consonants");
    assert_eq(phoneme_vowel_count(iv), 14, "pt vowels");
    iv = phoneme_italian();
    assert(streq(phoneme_language_code(iv), "it"), "it code");
    assert_eq(phoneme_consonant_count(iv), 23, "it consonants");
    assert_eq(phoneme_vowel_count(iv), 7, "it vowels");
    iv = phoneme_dutch();
    assert(streq(phoneme_language_code(iv), "nl"), "nl code");
    assert_eq(phoneme_consonant_count(iv), 19, "nl consonants");
    assert_eq(phoneme_vowel_count(iv), 13, "nl vowels");
    iv = phoneme_polish();
    assert(streq(phoneme_language_code(iv), "pl"), "pl code");
    assert_eq(phoneme_consonant_count(iv), 29, "pl consonants");
    assert_eq(phoneme_vowel_count(iv), 6, "pl vowels");
    iv = phoneme_amharic();
    assert(streq(phoneme_language_code(iv), "am"), "am code");
    assert_eq(phoneme_consonant_count(iv), 27, "am consonants");
    assert_eq(phoneme_vowel_count(iv), 7, "am vowels");
    iv = phoneme_hausa();
    assert(streq(phoneme_language_code(iv), "ha"), "ha code");
    assert_eq(phoneme_consonant_count(iv), 25, "ha consonants");
    assert_eq(phoneme_vowel_count(iv), 10, "ha vowels");
    iv = phoneme_indonesian();
    assert(streq(phoneme_language_code(iv), "id"), "id code");
    assert_eq(phoneme_consonant_count(iv), 18, "id consonants");
    assert_eq(phoneme_vowel_count(iv), 6, "id vowels");
    iv = phoneme_czech();
    assert(streq(phoneme_language_code(iv), "cs"), "cs code");
    assert_eq(phoneme_consonant_count(iv), 25, "cs consonants");
    assert_eq(phoneme_vowel_count(iv), 10, "cs vowels");
    iv = phoneme_hungarian();
    assert(streq(phoneme_language_code(iv), "hu"), "hu code");
    assert_eq(phoneme_consonant_count(iv), 25, "hu consonants");
    assert_eq(phoneme_vowel_count(iv), 14, "hu vowels");
    iv = phoneme_romanian();
    assert(streq(phoneme_language_code(iv), "ro"), "ro code");
    assert_eq(phoneme_consonant_count(iv), 21, "ro consonants");
    assert_eq(phoneme_vowel_count(iv), 7, "ro vowels");
    iv = phoneme_burmese();
    assert(streq(phoneme_language_code(iv), "my"), "my code");
    assert_eq(phoneme_consonant_count(iv), 30, "my consonants");
    assert_eq(phoneme_vowel_count(iv), 7, "my vowels");
    iv = phoneme_khmer();
    assert(streq(phoneme_language_code(iv), "km"), "km code");
    assert_eq(phoneme_consonant_count(iv), 24, "km consonants");
    assert_eq(phoneme_vowel_count(iv), 18, "km vowels");
    iv = phoneme_somali();
    assert(streq(phoneme_language_code(iv), "so"), "so code");
    assert_eq(phoneme_consonant_count(iv), 22, "so consonants");
    assert_eq(phoneme_vowel_count(iv), 10, "so vowels");
    iv = phoneme_quechua();
    assert(streq(phoneme_language_code(iv), "qu"), "qu code");
    assert_eq(phoneme_consonant_count(iv), 24, "qu consonants");
    assert_eq(phoneme_vowel_count(iv), 3, "qu vowels");
    iv = phoneme_guarani();
    assert(streq(phoneme_language_code(iv), "gn"), "gn code");
    assert_eq(phoneme_consonant_count(iv), 16, "gn consonants");
    assert_eq(phoneme_vowel_count(iv), 12, "gn vowels");
    iv = phoneme_icelandic();
    assert(streq(phoneme_language_code(iv), "is"), "is code");
    assert_eq(phoneme_consonant_count(iv), 22, "is consonants");
    assert_eq(phoneme_vowel_count(iv), 8, "is vowels");
    iv = phoneme_bengali();
    assert(streq(phoneme_language_code(iv), "bn"), "bn code");
    assert_eq(phoneme_consonant_count(iv), 29, "bn consonants");
    assert_eq(phoneme_vowel_count(iv), 7, "bn vowels");
    iv = phoneme_tamil();
    assert(streq(phoneme_language_code(iv), "ta"), "ta code");
    assert_eq(phoneme_consonant_count(iv), 19, "ta consonants");
    assert_eq(phoneme_vowel_count(iv), 10, "ta vowels");
    iv = phoneme_urdu();
    assert(streq(phoneme_language_code(iv), "ur"), "ur code");
    assert_eq(phoneme_consonant_count(iv), 37, "ur consonants");
    assert_eq(phoneme_vowel_count(iv), 10, "ur vowels");
    iv = phoneme_persian();
    assert(streq(phoneme_language_code(iv), "fa"), "fa code");
    assert_eq(phoneme_consonant_count(iv), 23, "fa consonants");
    assert_eq(phoneme_vowel_count(iv), 6, "fa vowels");
    iv = phoneme_hebrew();
    assert(streq(phoneme_language_code(iv), "he"), "he code");
    assert_eq(phoneme_consonant_count(iv), 23, "he consonants");
    assert_eq(phoneme_vowel_count(iv), 5, "he vowels");
    iv = phoneme_georgian();
    assert(streq(phoneme_language_code(iv), "ka"), "ka code");
    assert_eq(phoneme_consonant_count(iv), 28, "ka consonants");
    assert_eq(phoneme_vowel_count(iv), 5, "ka vowels");
    iv = phoneme_wolof();
    assert(streq(phoneme_language_code(iv), "wo"), "wo code");
    assert_eq(phoneme_consonant_count(iv), 24, "wo consonants");
    assert_eq(phoneme_vowel_count(iv), 8, "wo vowels");
    iv = phoneme_lao();
    assert(streq(phoneme_language_code(iv), "lo"), "lo code");
    assert_eq(phoneme_consonant_count(iv), 20, "lo consonants");
    assert_eq(phoneme_vowel_count(iv), 9, "lo vowels");
    iv = phoneme_mongolian();
    assert(streq(phoneme_language_code(iv), "mn"), "mn code");
    assert_eq(phoneme_consonant_count(iv), 21, "mn consonants");
    assert_eq(phoneme_vowel_count(iv), 14, "mn vowels");

    test_group("inv_special");
    var m = phoneme_yucatec_maya();
    assert(phoneme_has(m, "pʼ"), "maya pʼ");
    assert(phoneme_has(m, "tʼ"), "maya tʼ");
    assert(phoneme_has(m, "kʼ"), "maya kʼ");
    var zu = phoneme_zulu();
    assert(phoneme_has(zu, "ǀ"), "zulu click ǀ");
    assert(phoneme_has(zu, "ǃ"), "zulu click ǃ");
    assert(phoneme_has(zu, "ǁ"), "zulu click ǁ");
    var cs = phoneme_czech();
    assert(phoneme_has(cs, "r̝"), "czech r-raised");
    var hu = phoneme_hungarian();
    assert(phoneme_has(hu, "y"), "hungarian y");
    assert(phoneme_has(hu, "ø"), "hungarian ø");
    assert(phoneme_has(hu, "yː"), "hungarian yː");
    assert(phoneme_has(hu, "øː"), "hungarian øː");
    assert(phoneme_has(hu, "c"), "hungarian c");
    assert(phoneme_has(hu, "ɟ"), "hungarian ɟ");
    var ro = phoneme_romanian();
    assert(phoneme_has(ro, "ɨ"), "romanian central close");
    var yo = phoneme_yoruba();
    assert_eq(vec_len(phoneme_tones(yo)), 3, "yoruba 3 tones");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
