# varna benchmarks
# Run: cyrius bench tests/varna.bcyr

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "lib/syscalls.cyr"

fn bench_noop() {
    return 0;
}

fn main() {
    alloc_init();
    var b = bench_new("noop");
    bench_run(b, &bench_noop, 1000000);
    bench_report(b);
    return 0;
}

var r = main();
syscall(60, r);
