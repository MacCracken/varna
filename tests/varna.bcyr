# varna benchmarks — ported from v1.x Rust benches/benchmarks.rs (criterion).
# Run: cyrius bench tests/varna.bcyr   (or ./scripts/bench-history.sh)

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/slice.cyr"
include "lib/io.cyr"
include "lib/hashmap.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "lib/syscalls.cyr"

include "src/error.cyr"
include "src/util.cyr"
include "src/tone.cyr"
include "src/phoneme.cyr"
include "src/inventories.cyr"
include "src/allophone.cyr"
include "src/syllable.cyr"
include "src/grammar.cyr"
include "src/lexicon.cyr"
include "src/swadesh.cyr"
include "src/cognate.cyr"
include "src/dialect.cyr"
include "src/script.cyr"
include "src/registry.cyr"
include "src/numerals.cyr"
include "src/transliteration.cyr"
include "src/json.cyr"

# Pre-built state for lookup benchmarks.
var _b_en = 0;
var _b_deva = 0;
var _b_iast = 0;
var _b_beta = 0;
var _b_iso = 0;
var _b_es = 0;
var _b_allo = 0;
var _b_phono = 0;
var _b_rp = 0;
var _b_en_json = 0;
var _b_phono_json = 0;
var _b_grek_num = 0;
var _b_script_json = 0;
var _b_num_json = 0;
var _b_tt_json = 0;
var _b_grammar = 0;
var _b_lexicon = 0;
var _b_cognate = 0;
var _b_info = 0;
var _b_grammar_json = 0;
var _b_lexicon_json = 0;
var _b_cognate_json = 0;
var _b_variety_json = 0;
var _b_info_json = 0;

fn b_english_inventory() { phoneme_english(); return 0; }
fn b_sanskrit_inventory() { phoneme_sanskrit(); return 0; }
fn b_greek_inventory() { phoneme_greek(); return 0; }
fn b_phoneme_lookup() { phoneme_find(_b_en, "ʃ"); return 0; }
fn b_registry_lookup() { registry_phonemes("sa"); return 0; }
fn b_registry_all_codes_iter() {
    var codes = registry_all_codes();
    var n = vec_len(codes);
    var i = 0;
    while (i < n) {
        registry_info(vec_get(codes, i));
        i = i + 1;
    }
    return 0;
}
fn b_script_lookup() { script_by_code("Deva"); return 0; }
fn b_script_contains_codepoint() { script_contains_codepoint(_b_deva, 0x0915); return 0; }
fn b_translit_deva_char() { translit_char(_b_iast, "क"); return 0; }
fn b_translit_greek_word() { translit_apply(_b_beta, "φιλοσοφια"); return 0; }
fn b_numeral_value_of() { numerals_value_of(_b_iso, "π"); return 0; }
# 2.4.0 shipped char_value/string_value_in/script_alphabet_values with no bench
# row, so the gate never saw a per-character allocation leak in the string walk.
fn b_char_value() { char_value("Hebr", NumericSystem.NUM_STANDARD, "ש"); return 0; }
fn b_char_value_ordinal() { char_value("Hebr", NumericSystem.NUM_ORDINAL, "ם"); return 0; }
fn b_string_value_in() { string_value_in("Hebr", NumericSystem.NUM_STANDARD, "שלום"); return 0; }
fn b_script_alphabet_values() { script_alphabet_values("Grek", NumericSystem.NUM_ORDINAL); return 0; }
fn b_numeral_string_value() { numerals_string_value(_b_iso, "θεος"); return 0; }
fn b_grammar_lookup() { grammar_by_code("ru"); return 0; }
fn b_swadesh_lookup() { swadesh_by_code("ja"); return 0; }
fn b_lexicon_find() { lexicon_find(_b_es, "agua"); return 0; }
fn b_allophone_realize() { allophone_realize(_b_allo, "t", Environment.Intervocalic); return 0; }
fn b_phonotactics_is_permitted() { phonotactics_is_permitted(_b_phono, "str", SyllablePosition.Onset); return 0; }
fn b_dialect_apply() { dialect_apply(_b_rp, _b_en); return 0; }
# 2.5.2 JSON (ADR 0003): the full English inventory, 36 phonemes. Each call builds a
# fresh str_builder / value tree (there is no builder reset and the bump allocator
# never frees), so the iteration counts are kept low.
fn b_json_inventory_write() {
    var sb = str_builder_new();
    phoneme_inventory_to_json(_b_en, sb);
    return 0;
}
fn b_json_inventory_read() { phoneme_inventory_from_json(_b_en_json); return 0; }
fn b_json_phonotactics_write() {
    var sb = str_builder_new();
    phonotactics_to_json(_b_phono, sb);
    return 0;
}
fn b_json_phonotactics_read() { phonotactics_from_json(_b_phono_json); return 0; }
fn b_json_script_write() {
    var sb = str_builder_new();
    script_to_json(_b_deva, sb);
    return 0;
}
fn b_json_script_read() { script_from_json(_b_script_json); return 0; }
fn b_json_numerals_write() {
    var sb = str_builder_new();
    numeral_system_to_json(_b_grek_num, sb);
    return 0;
}
fn b_json_numerals_read() { numeral_system_from_json(_b_num_json); return 0; }
fn b_json_translit_write() {
    var sb = str_builder_new();
    transliteration_table_to_json(_b_iast, sb);
    return 0;
}
fn b_json_translit_read() { transliteration_table_from_json(_b_tt_json); return 0; }
fn b_json_grammar_write() {
    var sb = str_builder_new();
    grammar_profile_to_json(_b_grammar, sb);
    return 0;
}
fn b_json_grammar_read() { grammar_profile_from_json(_b_grammar_json); return 0; }
fn b_json_lexicon_write() {
    var sb = str_builder_new();
    lexicon_to_json(_b_lexicon, sb);
    return 0;
}
fn b_json_lexicon_read() { lexicon_from_json(_b_lexicon_json); return 0; }
fn b_json_cognate_write() {
    var sb = str_builder_new();
    cognate_set_to_json(_b_cognate, sb);
    return 0;
}
fn b_json_cognate_read() { cognate_set_from_json(_b_cognate_json); return 0; }
fn b_json_variety_write() {
    var sb = str_builder_new();
    language_variety_to_json(_b_rp, sb);
    return 0;
}
fn b_json_variety_read() { language_variety_from_json(_b_variety_json); return 0; }
fn b_json_registry_write() {
    var sb = str_builder_new();
    registry_info_to_json(_b_info, sb);
    return 0;
}
fn b_json_registry_read() { registry_info_from_json(_b_info_json); return 0; }

fn _bench(benches, name, fp, n) {
    var b = bench_new(name);
    bench_run(b, fp, n);
    vec_push(benches, b);
    return 0;
}

fn main() {
    alloc_init();
    _b_en = phoneme_english();
    _b_deva = script_devanagari();
    _b_iast = translit_devanagari_iast();
    _b_beta = translit_greek_beta_code();
    _b_iso = numerals_greek_isopsephy();
    _b_es = swadesh_by_code("es");
    _b_allo = allophone_english();
    _b_phono = phonotactics_english();
    _b_rp = dialect_british_english();
    var jsb = str_builder_new();
    phoneme_inventory_to_json(_b_en, jsb);
    _b_en_json = str_cstr(str_builder_build(jsb));
    var psb = str_builder_new();
    phonotactics_to_json(_b_phono, psb);
    _b_phono_json = str_cstr(str_builder_build(psb));
    _b_grek_num = numerals_greek_isopsephy();
    var ssb = str_builder_new();
    script_to_json(_b_deva, ssb);
    _b_script_json = str_cstr(str_builder_build(ssb));
    var nsb = str_builder_new();
    numeral_system_to_json(_b_grek_num, nsb);
    _b_num_json = str_cstr(str_builder_build(nsb));
    var tsb = str_builder_new();
    transliteration_table_to_json(_b_iast, tsb);
    _b_tt_json = str_cstr(str_builder_build(tsb));
    _b_grammar = grammar_english();
    var gsb = str_builder_new();
    grammar_profile_to_json(_b_grammar, gsb);
    _b_grammar_json = str_cstr(str_builder_build(gsb));
    _b_lexicon = swadesh_arabic();
    var lsb = str_builder_new();
    lexicon_to_json(_b_lexicon, lsb);
    _b_lexicon_json = str_cstr(str_builder_build(lsb));
    _b_cognate = cognate_water();
    var csb = str_builder_new();
    cognate_set_to_json(_b_cognate, csb);
    _b_cognate_json = str_cstr(str_builder_build(csb));
    var vsb = str_builder_new();
    language_variety_to_json(_b_rp, vsb);
    _b_variety_json = str_cstr(str_builder_build(vsb));
    _b_info = registry_info("en");
    var rsb = str_builder_new();
    registry_info_to_json(_b_info, rsb);
    _b_info_json = str_cstr(str_builder_build(rsb));

    var benches = vec_new();
    _bench(benches, "english_phoneme_inventory", &b_english_inventory, 100000);
    _bench(benches, "sanskrit_phoneme_inventory", &b_sanskrit_inventory, 100000);
    _bench(benches, "greek_phoneme_inventory", &b_greek_inventory, 100000);
    _bench(benches, "phoneme_lookup_ipa", &b_phoneme_lookup, 1000000);
    _bench(benches, "registry_phonemes_lookup", &b_registry_lookup, 100000);
    _bench(benches, "registry_all_codes_iter", &b_registry_all_codes_iter, 100000);
    _bench(benches, "script_by_code_lookup", &b_script_lookup, 1000000);
    _bench(benches, "script_contains_codepoint", &b_script_contains_codepoint, 1000000);
    _bench(benches, "transliterate_devanagari_char", &b_translit_deva_char, 1000000);
    _bench(benches, "transliterate_greek_word", &b_translit_greek_word, 100000);
    _bench(benches, "numeral_value_of_char", &b_numeral_value_of, 1000000);
    _bench(benches, "numeral_string_value_word", &b_numeral_string_value, 1000000);
    _bench(benches, "gematria_char_value", &b_char_value, 1000000);
    _bench(benches, "gematria_char_value_ordinal", &b_char_value_ordinal, 1000000);
    _bench(benches, "gematria_string_value_in", &b_string_value_in, 1000000);
    _bench(benches, "gematria_alphabet_table", &b_script_alphabet_values, 100000);
    _bench(benches, "grammar_by_code_lookup", &b_grammar_lookup, 1000000);
    _bench(benches, "swadesh_by_code_lookup", &b_swadesh_lookup, 100000);
    _bench(benches, "lexicon_find_word", &b_lexicon_find, 1000000);
    _bench(benches, "allophone_realize", &b_allophone_realize, 1000000);
    _bench(benches, "phonotactics_is_permitted", &b_phonotactics_is_permitted, 1000000);
    _bench(benches, "dialect_apply_overlay", &b_dialect_apply, 100000);
    _bench(benches, "json_inventory_write_en", &b_json_inventory_write, 2000);
    _bench(benches, "json_inventory_read_en", &b_json_inventory_read, 1000);
    _bench(benches, "json_phonotactics_write_en", &b_json_phonotactics_write, 5000);
    _bench(benches, "json_phonotactics_read_en", &b_json_phonotactics_read, 2000);
    _bench(benches, "json_script_write_deva", &b_json_script_write, 10000);
    _bench(benches, "json_script_read_deva", &b_json_script_read, 5000);
    _bench(benches, "json_numerals_write_greek", &b_json_numerals_write, 2000);
    _bench(benches, "json_numerals_read_greek", &b_json_numerals_read, 1000);
    _bench(benches, "json_translit_write_iast", &b_json_translit_write, 1000);
    _bench(benches, "json_translit_read_iast", &b_json_translit_read, 500);
    _bench(benches, "json_grammar_write_en", &b_json_grammar_write, 10000);
    _bench(benches, "json_grammar_read_en", &b_json_grammar_read, 5000);
    _bench(benches, "json_lexicon_write_ar", &b_json_lexicon_write, 2000);
    _bench(benches, "json_lexicon_read_ar", &b_json_lexicon_read, 1000);
    _bench(benches, "json_cognate_write_water", &b_json_cognate_write, 10000);
    _bench(benches, "json_cognate_read_water", &b_json_cognate_read, 5000);
    _bench(benches, "json_variety_write_rp", &b_json_variety_write, 10000);
    _bench(benches, "json_variety_read_rp", &b_json_variety_read, 5000);
    _bench(benches, "json_registry_write_en", &b_json_registry_write, 10000);
    _bench(benches, "json_registry_read_en", &b_json_registry_read, 5000);
    bench_report_all(benches);
    return 0;
}

var r = main();
syscall(60, r);
