    _tt_add(tt, "ᾊ", "*)\\a|");
    _tt_add(tt, "ᾋ", "*(\\a|");
    _tt_add(tt, "ᾌ", "*)/a|");
    _tt_add(tt, "ᾍ", "*(/a|");
    _tt_add(tt, "ᾎ", "*)=a|");
    _tt_add(tt, "ᾏ", "*(=a|");
    _tt_add(tt, "ᾘ", "*)h|");
    _tt_add(tt, "ᾙ", "*(h|");
