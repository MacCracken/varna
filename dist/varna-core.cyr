var _c_script_glagolitic = 0;
# Glagolitic (2.6.0), registered because its numerals are (gematria_glagolitic), and
# every letter-value script must be a registered script. No corpus language is
# written in it; it is the script of the earliest Old Church Slavonic texts.
# Historical. Its attestation dates are left unset (0), because no source for them
# was checked; Croatian liturgical use continued long after its main period. Ranges
# are Unicode's Glagolitic and Glagolitic Supplement blocks (Blocks.txt).
fn script_glagolitic() {
    if (_c_script_glagolitic != 0) { return _c_script_glagolitic; }
    var s = _script_new("Glag", "Glagolitic", ScriptType.Alphabet, Direction.LeftToRight, ScriptStatus.Historical, 0);
    _script_add_range(s, 0x2C00, 0x2C5F);
    _script_add_range(s, 0x1E000, 0x1E02F);
    _c_script_glagolitic = s;
    return _c_script_glagolitic;
}

# Bopomofo (2.6.0), registered because the Zhuyin → Pinyin table reads it
# (translit_zhuyin_pinyin), and every table's source script must be a registered
# script. No corpus language is written in it: it annotates Mandarin, "used in
# dictionaries and teaching materials, but not in the actual writing of Chinese
# text" (The Unicode Standard, §18.3). Mixed, because Unicode calls it "a hybrid
# writing system—part alphabet and part syllabary". Left to right, as Hani and Kana
# are here; it is also written vertically. Its attestation dates are left unset (0),
# because no source for them was checked. Ranges are Unicode's Bopomofo and Bopomofo
# Extended blocks (Blocks.txt).
var _c_script_bopomofo = 0;
fn script_bopomofo() {
    if (_c_script_bopomofo != 0) { return _c_script_bopomofo; }
    var s = _script_new("Bopo", "Bopomofo", ScriptType.Mixed, Direction.LeftToRight, ScriptStatus.Living, 0);
    _script_add_range(s, 0x3100, 0x312F);
    _script_add_range(s, 0x31A0, 0x31BF);
    _c_script_bopomofo = s;
    return _c_script_bopomofo;
}

# Look up a script by ISO 15924 code — Script ptr, or 0 if unregistered.
fn script_by_code(code) {
    if (streq(code, "Latn") == 1) { return script_latin(); }
    if (streq(code, "Arab") == 1) { return script_arabic(); }
    if (streq(code, "Deva") == 1) { return script_devanagari(); }
    if (streq(code, "Hani") == 1) { return script_cjk(); }
    if (streq(code, "Cyrl") == 1) { return script_cyrillic(); }
    if (streq(code, "Hang") == 1) { return script_hangul(); }
    if (streq(code, "Kana") == 1) { return script_kana(); }
    if (streq(code, "Grek") == 1) { return script_greek(); }
    if (streq(code, "Xsux") == 1) { return script_cuneiform(); }
    if (streq(code, "Egyp") == 1) { return script_egyptian(); }
    if (streq(code, "Thai") == 1) { return script_thai(); }
    if (streq(code, "Beng") == 1) { return script_bengali(); }
    if (streq(code, "Taml") == 1) { return script_tamil(); }
    if (streq(code, "Ethi") == 1) { return script_ethiopic(); }
    if (streq(code, "Hebr") == 1) { return script_hebrew(); }
    if (streq(code, "Geor") == 1) { return script_georgian(); }
    if (streq(code, "Mymr") == 1) { return script_myanmar(); }
    if (streq(code, "Khmr") == 1) { return script_khmer(); }
    if (streq(code, "Laoo") == 1) { return script_lao(); }
    if (streq(code, "Glag") == 1) { return script_glagolitic(); }
    if (streq(code, "Bopo") == 1) { return script_bopomofo(); }
    return 0;
}

var _c_script_all_codes = 0;
# All registered ISO 15924 script codes — vec of cstrings.
fn script_all_codes() {
    if (_c_script_all_codes != 0) { return _c_script_all_codes; }
    var c = vec_new();
    vec_push(c, "Latn");
    vec_push(c, "Arab");
    vec_push(c, "Deva");
    vec_push(c, "Hani");
    vec_push(c, "Cyrl");
    vec_push(c, "Hang");
    vec_push(c, "Kana");
    vec_push(c, "Grek");
    vec_push(c, "Xsux");
    vec_push(c, "Egyp");
    vec_push(c, "Thai");
    vec_push(c, "Beng");
    vec_push(c, "Taml");
    vec_push(c, "Ethi");
    vec_push(c, "Hebr");
    vec_push(c, "Geor");
    vec_push(c, "Mymr");
    vec_push(c, "Khmr");
    vec_push(c, "Laoo");
    vec_push(c, "Glag");
    vec_push(c, "Bopo");
    _c_script_all_codes = c;
    return _c_script_all_codes;
}

# --- registry.cyr ---

# src/registry.cyr — central ISO 639 language lookup.
# Ported from v1.x Rust src/registry.rs. Maps codes -> LanguageInfo / phoneme
# inventory / primary script code. Needs phoneme.cyr + inventories.cyr.
#
# LanguageInfo (88B): [0]=code  [8]=name  [16]=scripts(vec of cstrings)
#                     [24]=family [32]=subfamily [40]=genus
#                     [48]=endangerment [56]=macroarea [64]=lat_mdeg [72]=lon_mdeg
#                     [80]=glottocode (cstring, or 0)
#
# --- Glottocodes (2.5.3) ---
# Each entry carries the Glottolog identifier of the language it describes. All 51 were
# obtained from Glottolog itself on 2026-11-13, through its ISO 639-3 resolver
# (glottolog.org/resource/languoid/iso/<iso>), and each resolved name was checked
# against the entry. None was written from memory: a Glottocode is an opaque
# identifier, so a remembered one is a plausible fabrication, not an approximation.
#
# The rule is one Glottolog LANGUAGE-level languoid per entry, for the variety the
# inventory transcribes. Where the corpus code is an ISO macrolanguage or collection,
# the individual language is named beside the entry, and so is the reason when the
# entry's name is wider than the code:
#   sw swh, ar arb, zh cmn, fa pes, gn gug, mn khk  the standard individual language
#   nah nci   Classical Nahuatl, as the entry's own scope comment says
#   grc       anci1242, Glottolog's languoid for grc. Koine is a stage of it. Glottolog's
#             koin1234 "Koineic Greek" is the clade of Koine's DESCENDANTS (Medieval,
#             Modern, Pontic...), not the Hellenistic language, so it would be wrong
#   qu        cusc1236. The inventory's plain / aspirated / ejective stop series is
#             Cusco-Collao, which Ayacucho lacks; Southern Quechua itself, quec1389, is
#             a subgroup, the genus this entry already names
#
# The field is nullable. A record decoded from a 2.5.2 document, which predates it,
# reads 0 here, as does an entry built without one.
#
# Genealogical classification added at 2.3.1. The three strings are the clean
# queryable values; where a node is contested the caveat lives in a comment beside
# the entry, not inside the field — "Ugric (contested; Glottolog rejects the node)"
# is documentation, not a subfamily name, and a consumer grouping by subfamily
# should not have to parse prose.
#
# --- Rank rule ---
# Each column has one rule, and all three must partition: no value may be a proper
# ancestor of another value in the same column and family.
#
#   family     the conventional top-level stock
#   subfamily  a PRIMARY (depth-1) branch of that family, always
#   genus      the smallest conventionally named clade above the language that its
#              close relatives still share
#
# Two consequences follow and are correct, not oversights:
#   - Genus depth varies between families, because family diversity varies. Bantu
#     spans more than Romance does; that is a fact about the families.
#   - genus == subfamily is the right answer for a low-diversity family. Seven rows
#     do this (ko, ja, km, el, grc, zh, lzh); it is an answer, not a placeholder.
#
# The one intentional exception is `la`: Latino-Faliscan is ancestral to the four
# Romance genera, so it technically nests. Every alternative is worse — "Romance" is
# false, "Latin" discards Faliscan — and no consumer querying Latino-Faliscan expects
# Spanish. It is whitelisted in the non-nesting test rather than left a silent gap.
#
# Transferring from docs/development/typology-data.md: the field is the head term
# before the first parenthesis; the parenthetical is prose and stays in a comment.

var _varna_langs = 0;   # vec of LanguageInfo ptrs, lazily built
var _varna_lang_index = 0;   # map code -> LanguageInfo ptr, lazily built
var _varna_all_codes = 0;    # cached vec of cstrings, lazily built

# Registry entry without a genealogical classification; family/subfamily/genus
# read back as 0, distinguishing "not classified" from any placeholder string.
# --- Vitality and geography (2.3.2) --------------------------------
# Variant names are prefixed: Cyrius enum variants share one flat symbol namespace,
# and `Historical` is already taken by ScriptStatus. The spellings are also the JSON
# names (ADR 0003), so renaming one breaks stored documents.
#
# The scale is UNESCO-style, with one addition. END_HISTORICAL covers a language
# with no native-speaker community that remains in active scholarly, liturgical or
# literary use — Latin, Ancient Greek, Literary Chinese and Sanskrit. Collapsing
# those into END_EXTINCT would conflate two genuinely different situations: a
# minority language whose last speakers died, and a classical language still taught,
# read and used in worship. No language in this corpus is END_EXTINCT, which
# `tests/vitality.tcyr` pins so the distinction stays visible.
#derive(Serialize)
enum EndangermentLevel {
    END_SAFE = 0;
    END_VULNERABLE = 1;
    END_THREATENED = 2;
    END_SHIFTING = 3;
    END_MORIBUND = 4;
    END_NEARLY_EXTINCT = 5;
    END_EXTINCT = 6;
    END_HISTORICAL = 7;
}

# The six WALS macro-areas, unchanged. Mesoamerica is part of North America here
# because WALS has no seventh area for it, and Hawaii is Papunesia rather than
# North America, likewise following WALS.
#derive(Serialize)
enum MacroArea {
    AREA_AFRICA = 0;
    AREA_EURASIA = 1;
    AREA_PAPUNESIA = 2;
    AREA_NORTH_AMERICA = 3;
    AREA_SOUTH_AMERICA = 4;
    AREA_AUSTRALIA = 5;
}

fn _li_new(code, name, sc) {
    return _li_new_geo(code, name, sc, 0, 0, 0, 0, EndangermentLevel.END_SAFE,
      MacroArea.AREA_EURASIA, 0, 0);
}

fn _li_new_full(code, name, sc, family, subfamily, genus) {
    return _li_new_geo(code, name, sc, 0, family, subfamily, genus,
      EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 0, 0);
}

# Coordinates are MILLI-DEGREES (52.5 degrees -> 52500).
#
# Cyrius has f64 — lib/math.cyr and lib/ganita.cyr carry a full float surface
# (f64_pow, f64_hypot, trig, f64v2/f64v4 SIMD) and bayan parses JSON floats. The
# integer encoding is a deliberate choice, not a language limitation:
#
#   - The source is rounded to one decimal degree, so a float would advertise
#     precision the data does not have. Every stored value is a multiple of 100 and
#     the last two digits carry no information; `tests/vitality.tcyr` asserts that,
#     so the storage cannot silently outrun the source.
#   - Integers compare exactly, so the bounding-box and precision tests need no
#     epsilon.
#
# (`hoosh.cyr` reaches for per-mille integers for its own reasons; its comment says
# the v1.x port chose to avoid f64, which is a design note about that port and not a
# statement about the language.)
#
# These are approximate centroids for a language area, not survey points.
#
# `glottocode` sits beside the other identifiers, before the classification: a 0
# there means the entry has none (see the header).
fn _li_new_geo(code, name, sc, glottocode, family, subfamily, genus, endangerment, area, lat_mdeg, lon_mdeg) {
    var li = alloc(88);
    store64(li + 80, glottocode);
    store64(li, code);
    store64(li + 8, name);
    var sv = vec_new();
    vec_push(sv, sc);
    store64(li + 16, sv);
    store64(li + 24, family);
    store64(li + 32, subfamily);
    store64(li + 40, genus);
    store64(li + 48, endangerment);
    store64(li + 56, area);
    store64(li + 64, lat_mdeg);
    store64(li + 72, lon_mdeg);
    return li;
}

fn registry_info_code(li) { return load64(li); }
fn registry_info_name(li) { return load64(li + 8); }
fn registry_info_scripts(li) { return load64(li + 16); }

# Genealogical classification (2.3.1). Each returns 0 when unclassified.
fn registry_info_family(li) { return load64(li + 24); }
fn registry_info_subfamily(li) { return load64(li + 32); }
fn registry_info_genus(li) { return load64(li + 40); }

# --- Vitality and geography (2.3.2) ---
fn registry_info_endangerment(li) { return load64(li + 48); }
fn registry_info_macroarea(li) { return load64(li + 56); }
# Milli-degrees: divide by 1000 for degrees. See _li_new_geo for why.
fn registry_info_latitude_mdeg(li) { return load64(li + 64); }
fn registry_info_longitude_mdeg(li) { return load64(li + 72); }

# --- Glottocode (2.5.3) ---
# The Glottolog identifier, such as "stan1293", or 0 when the entry has none.
fn registry_info_glottocode(li) { return load64(li + 80); }

# 1 when `s` has a Glottocode's shape: four lowercase letters or digits, then four
# digits, exactly eight bytes ("stan1293", "laoo1244"). Shape only: whether Glottolog
# has such a languoid can only be looked up.
#must_use
fn registry_glottocode_well_formed(s) {
    if (s == 0) { return 0; }
    if (strlen(s) != 8) { return 0; }
    var i = 0;
    while (i < 8) {
        var c = load8(s + i);
        var digit = 0;
        if (c >= '0' && c <= '9') { digit = 1; }
        if (i < 4) {
            if (digit == 0 && (c < 'a' || c > 'z')) { return 0; }
        }
        elif (digit == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# The registry entry with this Glottocode, or 0. The reverse of
# registry_info_glottocode, for a caller holding a Glottolog or PHOIBLE identifier.
#must_use
fn registry_by_glottocode(glottocode) {
    if (glottocode == 0) { return 0; }
    var langs = registry_languages();
    var n = vec_len(langs);
    var i = 0;
    while (i < n) {
        var li = vec_get(langs, i);
        var g = load64(li + 80);
        if (g != 0) {
            if (streq(g, glottocode) == 1) { return li; }
        }
        i = i + 1;
    }
    return 0;
}

# All registered codes in a macro-area — vec of cstrings.
fn registry_by_macroarea(area) {
    var langs = registry_languages();
    var n = vec_len(langs);
    var out = vec_new();
    var i = 0;
    while (i < n) {
        var li = vec_get(langs, i);
        if (load64(li + 56) == area) { vec_push(out, load64(li)); }
        i = i + 1;
    }
    return out;
}

# All registered codes at or beyond a given endangerment level — vec of cstrings.
# END_HISTORICAL sorts last numerically but is not "more endangered" than extinct,
# so it is excluded from a threshold query and must be asked for exactly.
fn registry_at_least_endangered(level) {
    var langs = registry_languages();
    var n = vec_len(langs);
    var out = vec_new();
    var i = 0;
    while (i < n) {
        var li = vec_get(langs, i);
        var e = load64(li + 48);
        if (e != EndangermentLevel.END_HISTORICAL) {
            if (e >= level) { vec_push(out, load64(li)); }
        }
        i = i + 1;
    }
    return out;
}

# Family for an ISO 639 code directly, or 0 if the code is unknown.
fn registry_family(code) {
    var li = registry_info(code);
    if (li == 0) { return 0; }
    return load64(li + 24);
}

# All registered codes sharing a family — vec of cstrings, empty if none match.
fn registry_by_family(family) {
    var langs = registry_languages();
    var n = vec_len(langs);
    var out = vec_new();
    var i = 0;
    while (i < n) {
        var li = vec_get(langs, i);
        var f = load64(li + 24);
        if (f != 0) {
            if (streq(f, family) == 1) { vec_push(out, load64(li)); }
        }
        i = i + 1;
    }
    return out;
}

fn _registry_build() {
    var r = vec_new();
    vec_push(r, _li_new_geo("en", "English", "Latn", "stan1293",
        "Indo-European", "Germanic", "West Germanic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 52500, -1500));
    # Vedic/Classical stage of Indo-Aryan; see hi/ur/bn for the same genus at the
    # modern stage. The stage lives here rather than in the field, matching grc and
    # lzh — a genus must not contain another row's genus.
    vec_push(r, _li_new_geo("sa", "Sanskrit", "Deva", "sans1269",
        "Indo-European", "Indo-Iranian", "Indo-Aryan",
        EndangermentLevel.END_HISTORICAL, MacroArea.AREA_EURASIA, 27000, 78000));
    # Modern Greek, descended from the Attic-Ionic koine; see grc for the ancient stage.
    vec_push(r, _li_new_geo("el", "Greek", "Grek", "mode1248",
        "Indo-European", "Hellenic", "Greek",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 39000, 22500));
    vec_push(r, _li_new_geo("yua", "Yucatec Maya", "Latn", "yuca1254",
        "Mayan", "Yucatecan", "Yucatec-Lacandon",
        EndangermentLevel.END_VULNERABLE, MacroArea.AREA_NORTH_AMERICA, 19500, -89000));
    # Atlantic-Congo > Bantoid > Northeast Coast/Sabaki (Guthrie G40).
    # Niger-Congo is the conventional family label; the demonstrated node is
    # Atlantic-Congo, which is what the subfamily sits under.
    vec_push(r, _li_new_geo("sw", "Swahili", "Latn", "swah1253",
        "Niger-Congo", "Benue-Congo", "Bantu",
        EndangermentLevel.END_SAFE, MacroArea.AREA_AFRICA, -6200, 39200));
    # Volta-Niger is the Glottolog node; older Benue-Congo trees call this Defoid.
    # Niger-Congo is the conventional family label; the demonstrated node is
    # Atlantic-Congo, which is what the subfamily sits under.
    vec_push(r, _li_new_geo("yo", "Yoruba", "Latn", "yoru1245",
        "Niger-Congo", "Volta-Niger", "Yoruboid",
        EndangermentLevel.END_SAFE, MacroArea.AREA_AFRICA, 7500, 4000));
    # Atlantic-Congo > Bantoid > Nguni (Guthrie S40).
    # Niger-Congo is the conventional family label; the demonstrated node is
    # Atlantic-Congo, which is what the subfamily sits under.
    vec_push(r, _li_new_geo("zu", "Zulu", "Latn", "zulu1248",
        "Niger-Congo", "Benue-Congo", "Bantu",
        EndangermentLevel.END_SAFE, MacroArea.AREA_AFRICA, -28500, 31000));
    # Chiang Saen subgroup. Tai-Kadai is also called Kra-Dai.
    vec_push(r, _li_new_geo("th", "Thai", "Thai", "thai1261",
        "Tai-Kadai", "Tai", "Southwestern Tai",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 14500, 100500));
    vec_push(r, _li_new_geo("vi", "Vietnamese", "Latn", "viet1252",
        "Austroasiatic", "Vietic", "Viet-Muong",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 21000, 105800));
    # Greater Central Philippine > Tagalogic.
    vec_push(r, _li_new_geo("tl", "Tagalog", "Latn", "taga1270",
        "Austronesian", "Malayo-Polynesian", "Central Philippine",
        EndangermentLevel.END_SAFE, MacroArea.AREA_PAPUNESIA, 14500, 121000));
    # Shaz Turkic > Southwestern Turkic. NOT Altaic: that grouping is rejected.
    vec_push(r, _li_new_geo("tr", "Turkish", "Latn", "nucl1301",
        "Turkic", "Common Turkic", "Oghuz",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 39000, 35000));
    vec_push(r, _li_new_geo("fi", "Finnish", "Latn", "finn1318",
        "Uralic", "Finnic", "Northern Finnic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 62000, 25000));
    # Ni'ihau has never broken transmission and the Punana Leo / Kula Kaiapuni
    # immersion system has run since 1983, so END_MORIBUND ("only the grandparent
    # generation") is empirically false. UNESCO's "critically endangered" is from the
    # 2010 Atlas, frozen before the revitalization.
    # Malayo-Polynesian > Oceanic > Eastern Polynesian, Marquesic. The subfamily is
    # the primary branch, as for id and tl; Oceanic is well inside it.
    vec_push(r, _li_new_geo("haw", "Hawaiian", "Latn", "hawa1245",
        "Austronesian", "Malayo-Polynesian", "Polynesian",
        EndangermentLevel.END_THREATENED, MacroArea.AREA_PAPUNESIA, 20500, -157000));
    # nah is an ISO 639-3 collection code, not a single language; this entry models
    # Classical Nahuatl (nci) — the inventory has no voiced stops, the four-vowel
    # system with contrastive length, /t͡ɬ/, /kʷ/ and the saltillo, which is the
    # classical language rather than any modern variety.
    # SCOPE: END_HISTORICAL follows from that. Modern Nahuatl (~1.65M speakers) would
    # be END_THREATENED, but that is a different language object from this one.
    vec_push(r, _li_new_geo("nah", "Classical Nahuatl", "Latn", "clas1250",
        "Uto-Aztecan", "Southern Uto-Aztecan", "Aztecan",
        EndangermentLevel.END_HISTORICAL, MacroArea.AREA_NORTH_AMERICA, 19500, -98000));
    # Ancestor of the Romance genera below.
    vec_push(r, _li_new_geo("la", "Latin", "Latn", "lati1261",
        "Indo-European", "Italic", "Latino-Faliscan",
        EndangermentLevel.END_HISTORICAL, MacroArea.AREA_EURASIA, 41900, 12500));
    # West Semitic > Central Semitic. The genus is Arabic, the Central Semitic sister
    # of he's Northwest Semitic — naming Central Semitic here would make the genus
    # column non-disjoint, since it contains Hebrew's node.
    # ar is a macrolanguage; this classifies Standard/Classical Arabic.
    vec_push(r, _li_new_geo("ar", "Arabic", "Arab", "stan1318",
        "Afro-Asiatic", "Semitic", "Arabic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 25000, 45000));
    # Ancient Greek (Attic-Ionic / Koine); same genus as el at an earlier stage.
    vec_push(r, _li_new_geo("grc", "Koine Greek", "Grek", "anci1242",
        "Indo-European", "Hellenic", "Greek",
        EndangermentLevel.END_HISTORICAL, MacroArea.AREA_EURASIA, 38000, 23500));
    # Literary Chinese: a written register based on Old/Middle Chinese, not a spoken variety.
    vec_push(r, _li_new_geo("lzh", "Literary Chinese", "Hani", "lite1248",
        "Sino-Tibetan", "Sinitic", "Chinese",
        EndangermentLevel.END_HISTORICAL, MacroArea.AREA_EURASIA, 34500, 112500));
    # zh is a macrolanguage; the standard variety is Mandarin. Same genus as lzh.
    vec_push(r, _li_new_geo("zh", "Mandarin Chinese", "Hani", "mand1415",
        "Sino-Tibetan", "Sinitic", "Chinese",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 34000, 113000));
    # Central Indo-Aryan, Hindustani — the same genus as ur, which it differs from by register and script.
    vec_push(r, _li_new_geo("hi", "Hindi", "Deva", "hind1269",
        "Indo-European", "Indo-Iranian", "Indo-Aryan",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 26500, 80500));
    # Eastern Indo-Aryan, Bengali-Assamese.
    vec_push(r, _li_new_geo("bn", "Bengali", "Beng", "beng1280",
        "Indo-European", "Indo-Iranian", "Indo-Aryan",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 23500, 89500));
    # South Dravidian I > Tamil-Malayalam.
    vec_push(r, _li_new_geo("ta", "Tamil", "Taml", "tami1289",
        "Dravidian", "South Dravidian", "Tamil-Kannada",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 11000, 78500));
    # Central Indo-Aryan, Hindustani — same genus as hi.
    vec_push(r, _li_new_geo("ur", "Urdu", "Arab", "urdu1245",
        "Indo-European", "Indo-Iranian", "Indo-Aryan",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 28600, 77200));
    # NOT Altaic. Japonic is a small family, not an isolate: Ryukyuan is its sister branch.
    vec_push(r, _li_new_geo("ja", "Japanese", "Kana", "nucl1643",
        "Japonic", "Japanesic", "Japanese",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 36000, 138000));
    vec_push(r, _li_new_geo("es", "Spanish", "Latn", "stan1288",
        "Indo-European", "Italic", "Ibero-Romance",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 40400, -3700));
    vec_push(r, _li_new_geo("fr", "French", "Latn", "stan1290",
        "Indo-European", "Italic", "Gallo-Romance",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 48000, 2500));
    # High German.
    vec_push(r, _li_new_geo("de", "German", "Latn", "stan1295",
        "Indo-European", "Germanic", "West Germanic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 51000, 10000));
    vec_push(r, _li_new_geo("ru", "Russian", "Cyrl", "russ1263",
        "Indo-European", "Balto-Slavic", "East Slavic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 55800, 37600));
    # NOT Altaic. Koreanic has Jeju as a sister to mainland Korean.
    vec_push(r, _li_new_geo("ko", "Korean", "Hang", "kore1280",
        "Koreanic", "Korean", "Korean",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 37500, 127500));
    # Galician-Portuguese; same genus as es.
    vec_push(r, _li_new_geo("pt", "Portuguese", "Latn", "port1283",
        "Indo-European", "Italic", "Ibero-Romance",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 39500, -8000));
    vec_push(r, _li_new_geo("it", "Italian", "Latn", "ital1282",
        "Indo-European", "Italic", "Italo-Dalmatian",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 43000, 12000));
    # Low Franconian.
    vec_push(r, _li_new_geo("nl", "Dutch", "Latn", "dutc1256",
        "Indo-European", "Germanic", "West Germanic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 52000, 5300));
    # Lechitic.
    vec_push(r, _li_new_geo("pl", "Polish", "Latn", "poli1260",
        "Indo-European", "Balto-Slavic", "West Slavic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 52000, 19500));
    # West Semitic > Ethiosemitic > Transversal, Amharic-Argobba.
    # ("South Semitic" as a node covering Ethiosemitic is superseded.)
    vec_push(r, _li_new_geo("am", "Amharic", "Ethi", "amha1245",
        "Afro-Asiatic", "Semitic", "South Ethiopic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_AFRICA, 11000, 38000));
    vec_push(r, _li_new_geo("ha", "Hausa", "Latn", "haus1257",
        "Afro-Asiatic", "Chadic", "West Chadic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_AFRICA, 12000, 8500));
    # Malayo-Chamic; standardised from Riau Malay.
    vec_push(r, _li_new_geo("id", "Indonesian", "Latn", "indo1316",
        "Austronesian", "Malayo-Polynesian", "Malayic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_PAPUNESIA, -6200, 106800));
    # Southwestern Iranian, Persid.
    vec_push(r, _li_new_geo("fa", "Persian", "Arab", "west2369",
        "Indo-European", "Indo-Iranian", "Iranian",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 32500, 53000));
    # Central Semitic > Canaanite.
    vec_push(r, _li_new_geo("he", "Hebrew", "Hebr", "hebr1245",
        "Afro-Asiatic", "Semitic", "Northwest Semitic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 31900, 35100));
    # Kartvelian is an independent family, not related to Indo-European or Turkic.
    vec_push(r, _li_new_geo("ka", "Georgian", "Geor", "nucl1302",
        "Kartvelian", "Karto-Zan", "Georgian",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 42000, 44000));
    # Czech-Slovak.
    vec_push(r, _li_new_geo("cs", "Czech", "Latn", "czec1258",
        "Indo-European", "Balto-Slavic", "West Slavic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 49800, 15500));
    # CONTESTED subfamily: Glottolog rejects the Ugric node and treats Hungarian as a
    # primary branch of Uralic. Retained here because it remains the conventional label.
    vec_push(r, _li_new_geo("hu", "Hungarian", "Latn", "hung1274",
        "Uralic", "Ugric", "Hungarian",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 47200, 19500));
    # Balkan Romance, Daco-Romanian.
    vec_push(r, _li_new_geo("ro", "Romanian", "Latn", "roma1327",
        "Indo-European", "Italic", "Eastern Romance",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 45900, 25000));
    # CONTESTED subfamily: Tibeto-Burman is probably paraphyletic and the intermediate
    # node (Burmo-Qiangic) is unsettled. Sino-Tibetan is also called Trans-Himalayan.
    vec_push(r, _li_new_geo("my", "Burmese", "Mymr", "nucl1310",
        "Sino-Tibetan", "Tibeto-Burman", "Lolo-Burmese",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 21000, 96000));
    # Khmeric, not Mon-Khmer: the latter is paraphyletic and not a valid node.
    vec_push(r, _li_new_geo("km", "Khmer", "Khmr", "cent1989",
        "Austroasiatic", "Khmeric", "Khmer",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 12500, 105000));
    # East Cushitic > Omo-Tana, Somaloid.
    vec_push(r, _li_new_geo("so", "Somali", "Latn", "soma1255",
        "Afro-Asiatic", "Cushitic", "Lowland East Cushitic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_AFRICA, 5000, 45500));
    # qu is a macrolanguage spanning both Quechua branches; the entry is named for the
    # variety it actually describes so the subfamily is not false for the rest of the
    # code's scope. CONTESTED subfamily: the QI/QII binary is disputed, though
    # Southern Quechua (QIIC) itself is not. Quechumaran (with Aymaran) is
    # contact-driven and not accepted.
    # SCOPE: the level describes Southern Quechua (QIIC), ~5-7M speakers with intact
    # rural transmission and co-official status in Peru and Bolivia — hence
    # END_VULNERABLE. END_SHIFTING would be right for Central (QI) and the northern
    # varieties, which this entry excludes by name.
    vec_push(r, _li_new_geo("qu", "Southern Quechua", "Latn", "cusc1236",
        "Quechuan", "Quechua II", "Southern Quechua",
        EndangermentLevel.END_VULNERABLE, MacroArea.AREA_SOUTH_AMERICA, -13500, -72000));
    # gn is a macrolanguage; Tupi-Guarani subgroup I.
    vec_push(r, _li_new_geo("gn", "Guarani", "Latn", "para1311",
        "Tupian", "Tupi-Guarani", "Guarani",
        EndangermentLevel.END_SAFE, MacroArea.AREA_SOUTH_AMERICA, -25500, -57000));
    # West Scandinavian / Insular Nordic.
    vec_push(r, _li_new_geo("is", "Icelandic", "Latn", "icel1247",
        "Indo-European", "Germanic", "North Germanic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 64500, -19000));
    # Niger-Congo is the conventional family label; the demonstrated node is
    # Atlantic-Congo. CONTESTED subfamily: Atlantic is not a demonstrated node — Glottolog treats Wolof
    # as a primary branch of Atlantic-Congo. Retained as the conventional label.
    vec_push(r, _li_new_geo("wo", "Wolof", "Latn", "nucl1347",
        "Niger-Congo", "Atlantic", "Wolofic",
        EndangermentLevel.END_SAFE, MacroArea.AREA_AFRICA, 14800, -16300));
    # Lao-Phutai subgroup; same genus as th.
    vec_push(r, _li_new_geo("lo", "Lao", "Laoo", "laoo1244",
        "Tai-Kadai", "Tai", "Southwestern Tai",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 18000, 102800));
    # Khalkha. NOT Altaic. Mongolic is also called Mongolic-Khitan.
    vec_push(r, _li_new_geo("mn", "Mongolian", "Cyrl", "halh1238",
        "Mongolic", "Central Mongolic", "Mongolian",
        EndangermentLevel.END_SAFE, MacroArea.AREA_EURASIA, 47000, 106500));
    return r;
}

fn registry_languages() {
    if (_varna_langs == 0) { _varna_langs = _registry_build(); }
    return _varna_langs;
}

# code -> LanguageInfo index, built once on first lookup.
#
# The lookup was a linear streq scan over all 51 entries, which put anything
# iterating the registry at O(n^2) in string compares — `registry_all_codes_iter`
# spent ~1,300 streq calls per pass and was by a wide margin the slowest
# benchmark. LanguageInfo pointers are never 0, so map_get's 0 doubles as the
# not-found sentinel.
fn _registry_index() {
    if (_varna_lang_index != 0) { return _varna_lang_index; }
    var langs = registry_languages();
    var n = vec_len(langs);
    var idx = map_new();
    var i = 0;
    while (i < n) {
        var li = vec_get(langs, i);
        map_set(idx, registry_info_code(li), li);
        i = i + 1;
    }
    _varna_lang_index = idx;
    return idx;
}

# Look up a language by ISO 639 code — LanguageInfo ptr, or 0 if unknown.
fn registry_info(code) {
    return map_get(_registry_index(), code);
}

# All registered ISO 639 codes — vec of cstrings.
#
# The vec is built once and shared. It was rebuilt per call, which allocated a
# fresh 51-element vec every time — and the bump allocator never frees, so a
# caller polling this leaked steadily. Treat the result as read-only: pushing to
# it mutates what every other caller sees.
fn registry_all_codes() {
    if (_varna_all_codes != 0) { return _varna_all_codes; }
    var langs = registry_languages();
    var n = vec_len(langs);
    var codes = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(codes, registry_info_code(vec_get(langs, i)));
        i = i + 1;
    }
    _varna_all_codes = codes;
    return codes;
}

# Primary script ISO 15924 code for a language, or 0 if unknown.
fn registry_primary_script_code(code) {
    var li = registry_info(code);
    if (li == 0) { return 0; }
    var sv = registry_info_scripts(li);
    if (vec_len(sv) == 0) { return 0; }
    return vec_get(sv, 0);
}

# Primary Script object for a language, or 0 if unknown / script unregistered.
# Requires src/script.cyr to be included before src/registry.cyr.
fn registry_primary_script(code) {
    var sc = registry_primary_script_code(code);
    if (sc == 0) { return 0; }
    return script_by_code(sc);
}

# Phoneme inventory for a language, or 0 if unavailable.
fn registry_phonemes(code) {
    if (streq(code, "en") == 1) { return phoneme_english(); }
    if (streq(code, "sa") == 1) { return phoneme_sanskrit(); }
    if (streq(code, "el") == 1) { return phoneme_greek(); }
    if (streq(code, "yua") == 1) { return phoneme_yucatec_maya(); }
    if (streq(code, "sw") == 1) { return phoneme_swahili(); }
    if (streq(code, "yo") == 1) { return phoneme_yoruba(); }
    if (streq(code, "zu") == 1) { return phoneme_zulu(); }
    if (streq(code, "th") == 1) { return phoneme_thai(); }
    if (streq(code, "vi") == 1) { return phoneme_vietnamese(); }
    if (streq(code, "tl") == 1) { return phoneme_tagalog(); }
    if (streq(code, "tr") == 1) { return phoneme_turkish(); }
    if (streq(code, "fi") == 1) { return phoneme_finnish(); }
    if (streq(code, "haw") == 1) { return phoneme_hawaiian(); }
    if (streq(code, "nah") == 1) { return phoneme_nahuatl(); }
    if (streq(code, "la") == 1) { return phoneme_latin(); }
    if (streq(code, "ar") == 1) { return phoneme_classical_arabic(); }
    if (streq(code, "grc") == 1) { return phoneme_koine_greek(); }
    if (streq(code, "lzh") == 1) { return phoneme_literary_chinese(); }
    if (streq(code, "zh") == 1) { return phoneme_mandarin(); }
    if (streq(code, "hi") == 1) { return phoneme_hindi(); }
    if (streq(code, "bn") == 1) { return phoneme_bengali(); }
    if (streq(code, "ta") == 1) { return phoneme_tamil(); }
    if (streq(code, "ur") == 1) { return phoneme_urdu(); }
    if (streq(code, "ja") == 1) { return phoneme_japanese(); }
    if (streq(code, "es") == 1) { return phoneme_spanish(); }
    if (streq(code, "fr") == 1) { return phoneme_french(); }
    if (streq(code, "de") == 1) { return phoneme_german(); }
    if (streq(code, "ru") == 1) { return phoneme_russian(); }
    if (streq(code, "ko") == 1) { return phoneme_korean(); }
    if (streq(code, "pt") == 1) { return phoneme_portuguese(); }
    if (streq(code, "it") == 1) { return phoneme_italian(); }
    if (streq(code, "nl") == 1) { return phoneme_dutch(); }
    if (streq(code, "pl") == 1) { return phoneme_polish(); }
    if (streq(code, "am") == 1) { return phoneme_amharic(); }
    if (streq(code, "ha") == 1) { return phoneme_hausa(); }
    if (streq(code, "id") == 1) { return phoneme_indonesian(); }
    if (streq(code, "fa") == 1) { return phoneme_persian(); }
    if (streq(code, "he") == 1) { return phoneme_hebrew(); }
    if (streq(code, "ka") == 1) { return phoneme_georgian(); }
    if (streq(code, "cs") == 1) { return phoneme_czech(); }
    if (streq(code, "hu") == 1) { return phoneme_hungarian(); }
    if (streq(code, "ro") == 1) { return phoneme_romanian(); }
    if (streq(code, "my") == 1) { return phoneme_burmese(); }
    if (streq(code, "km") == 1) { return phoneme_khmer(); }
    if (streq(code, "so") == 1) { return phoneme_somali(); }
    if (streq(code, "qu") == 1) { return phoneme_quechua(); }
    if (streq(code, "gn") == 1) { return phoneme_guarani(); }
    if (streq(code, "is") == 1) { return phoneme_icelandic(); }
    if (streq(code, "wo") == 1) { return phoneme_wolof(); }
    if (streq(code, "lo") == 1) { return phoneme_lao(); }
    if (streq(code, "mn") == 1) { return phoneme_mongolian(); }
    return 0;
}

# --- numerals.cyr ---

# src/numerals.cyr — script-to-numeral value mappings.
# Ported from v1.x Rust src/script/numerals.rs (data transpiled byte-exact).
#
# NumeralSystem (32B): [0]=script_code [8]=name [16]=kind [24]=mappings(vec)
# NumeralMapping (40B): [0]=character(cstr) [8]=len [16]=value [24]=role [32]=base(cstr)
#   `len` is the character's byte length, cached at construction. Every lookup is
#   a linear scan comparing the probe against each entry, and recomputing
#   strlen() on a stored constant once per entry per lookup was measurably the
#   dominant cost of that scan.
# Sentinels: value_of -> (0-1) when unmapped (value 0 is valid, e.g. Deva 0);
#            char_for / string_value -> 0 / (0-1) when not found.

#derive(Serialize)
enum NumeralSystemKind {
    Decimal = 0;
    Alphabetic = 1;
    Other = 2;
}

fn _nsys_new(script_code, name, kind) {
    var sys = alloc(32);
    store64(sys, script_code);
    store64(sys + 8, name);
    store64(sys + 16, kind);
    store64(sys + 24, vec_new());
    return sys;
}

# What a mapping's character IS within its writing system. The ordinal method
# needs this: it asks "which letter of the alphabet is this?", and only a letter
# has an answer. Deriving the ordinal from a mapping's raw index instead assumes
# every entry occupies an alphabet position, which silently shifts every letter
# after any entry that does not — see the Greek final sigma note below. The spellings
# are also the JSON names (ADR 0003), so renaming one breaks stored documents.
#derive(Serialize)
enum LetterRole {
    ROLE_LETTER = 0;         # a letter of the alphabet; occupies one position
    ROLE_ALLOGRAPH = 1;      # positional variant of another letter (Greek ς, Hebrew finals)
    ROLE_NUMERAL_SIGN = 2;   # numeral-only sign, never a letter (Greek ϛ, ϟ, ϡ)
}

fn _nsys_add(sys, character, value) {
    return _nsys_add_full(sys, character, value, LetterRole.ROLE_LETTER, 0);
}

# A positional variant of `base`: same standard value, and it borrows `base`'s
# ordinal rather than claiming one of its own.
fn _nsys_add_variant(sys, character, value, base) {
    return _nsys_add_full(sys, character, value, LetterRole.ROLE_ALLOGRAPH, base);
}

# A numeral-only sign. It carries a standard value but has no alphabet position,
# so the ordinal method reports it unmapped rather than inventing one.
fn _nsys_add_sign(sys, character, value) {
    return _nsys_add_full(sys, character, value, LetterRole.ROLE_NUMERAL_SIGN, 0);
}

fn _nsys_mapping_new(character, value, role, base) {
    var m = alloc(40);
    store64(m, character);
    store64(m + 8, strlen(character));
    store64(m + 16, value);
    store64(m + 24, role);
    store64(m + 32, base);
    return m;
}

fn _nsys_add_full(sys, character, value, role, base) {
    vec_push(load64(sys + 24), _nsys_mapping_new(character, value, role, base));
    return sys;
}

fn numerals_mapping_char(m) { return load64(m); }
fn numerals_mapping_len(m) { return load64(m + 8); }
fn numerals_mapping_value(m) { return load64(m + 16); }
fn numerals_mapping_role(m) { return load64(m + 24); }
# The letter an allograph varies; 0 for anything else.
fn numerals_mapping_base(m) { return load64(m + 32); }

fn numerals_script_code(sys) { return load64(sys); }
fn numerals_name(sys) { return load64(sys + 8); }
fn numerals_kind(sys) { return load64(sys + 16); }
fn numerals_mappings(sys) { return load64(sys + 24); }

# Numeric value of a single-character string, or (0-1) if unmapped.
fn numerals_value_of(sys, ch) {
    return _numerals_value_of_bytes(sys, ch, strlen(ch));
}

# Value of the `len` bytes at `ch`, or (0-1) if unmapped.
#
# Compares in place so `numerals_string_value` can walk a string without
# copying each codepoint into a fresh NUL-terminated buffer first — that
# allocated once per character, and the bump allocator never frees.
fn _numerals_value_of_bytes(sys, ch, len) {
    var ms = load64(sys + 24);
    var n = vec_len(ms);
    var i = 0;
    while (i < n) {
        var m = vec_get(ms, i);
        if (load64(m + 8) == len) {
            if (memeq(load64(m), ch, len) == 1) { return load64(m + 16); }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Character (cstr) for a numeric value, or 0 if none.
fn numerals_char_for(sys, value) {
    var ms = load64(sys + 24);
    var n = vec_len(ms);
    var i = 0;
    while (i < n) {
        var m = vec_get(ms, i);
        if (load64(m + 16) == value) { return load64(m); }
        i = i + 1;
    }
    return 0;
}

# Additive value: sum each codepoint's value. (0-1) if any is unmapped.
#
# `_utf8_step` (src/util.cyr) clamps each stride to the bytes actually present,
# so a truncated codepoint at the tail is consumed rather than read past — it
# then simply fails to match any mapping and the call returns the unmapped
# sentinel, which is the right answer for malformed input.
fn numerals_string_value(sys, s) {
    var total = 0;
    var p = 0;
    var n = strlen(s);
    while (p < n) {
        var len = _utf8_step(s, p, n);
        var v = _numerals_value_of_bytes(sys, s + p, len);
        if (v < 0) { return 0 - 1; }
        total = total + v;
        p = p + len;
    }
    return total;
}

# --- Pre-built numeral systems -------------------------------------

var _c_numerals_devanagari_digits = 0;
fn numerals_devanagari_digits() {
    if (_c_numerals_devanagari_digits != 0) { return _c_numerals_devanagari_digits; }
    var sys = _nsys_new("Deva", "Devanagari Digits", NumeralSystemKind.Decimal);
    _nsys_add(sys, "०", 0);
    _nsys_add(sys, "१", 1);
    _nsys_add(sys, "२", 2);
    _nsys_add(sys, "३", 3);
    _nsys_add(sys, "४", 4);
    _nsys_add(sys, "५", 5);
    _nsys_add(sys, "६", 6);
    _nsys_add(sys, "७", 7);
    _nsys_add(sys, "८", 8);
    _nsys_add(sys, "९", 9);
    _c_numerals_devanagari_digits = sys;
    return _c_numerals_devanagari_digits;
}

var _c_numerals_greek_isopsephy = 0;
# Greek isopsephy. The letter run skips 6, 90 and 900 because those values belong
# to three numeral-only signs — stigma ϛ, koppa ϟ and sampi ϡ — which are not
# letters of the alphabet and were dropped from it while staying in the numeral
# sequence. They are included here as ROLE_NUMERAL_SIGN, so the run is complete
# 1..900 and χξϛ sums to 666; without them the most-cited isopsephic value in
# existence could not be computed. Final sigma ς is a positional allograph of σ,
# not a 25th letter, so it borrows sigma's ordinal rather than taking its own.
fn numerals_greek_isopsephy() {
    if (_c_numerals_greek_isopsephy != 0) { return _c_numerals_greek_isopsephy; }
    var sys = _nsys_new("Grek", "Greek Isopsephy", NumeralSystemKind.Alphabetic);
    _nsys_add(sys, "α", 1);
    _nsys_add(sys, "β", 2);
    _nsys_add(sys, "γ", 3);
    _nsys_add(sys, "δ", 4);
    _nsys_add(sys, "ε", 5);
    _nsys_add_sign(sys, "ϛ", 6);
    _nsys_add(sys, "ζ", 7);
    _nsys_add(sys, "η", 8);
    _nsys_add(sys, "θ", 9);
    _nsys_add(sys, "ι", 10);
    _nsys_add(sys, "κ", 20);
    _nsys_add(sys, "λ", 30);
    _nsys_add(sys, "μ", 40);
    _nsys_add(sys, "ν", 50);
    _nsys_add(sys, "ξ", 60);
    _nsys_add(sys, "ο", 70);
    _nsys_add(sys, "π", 80);
    _nsys_add_sign(sys, "ϟ", 90);
    _nsys_add(sys, "ρ", 100);
    _nsys_add(sys, "σ", 200);
    _nsys_add_variant(sys, "ς", 200, "σ");
    _nsys_add(sys, "τ", 300);
    _nsys_add(sys, "υ", 400);
    _nsys_add(sys, "φ", 500);
    _nsys_add(sys, "χ", 600);
    _nsys_add(sys, "ψ", 700);
    _nsys_add(sys, "ω", 800);
    _nsys_add_sign(sys, "ϡ", 900);
    _c_numerals_greek_isopsephy = sys;
    return _c_numerals_greek_isopsephy;
}

