    _tt_add(tt, "ᾛ", "*(\\h|");
    _tt_add(tt, "ᾜ", "*)/h|");
    _tt_add(tt, "ᾝ", "*(/h|");
    _tt_add(tt, "ᾞ", "*)=h|");
    _tt_add(tt, "ᾟ", "*(=h|");
    _tt_add(tt, "ᾨ", "*)w|");
    _tt_add(tt, "ᾩ", "*(w|");
    _tt_add(tt, "ᾪ", "*)\\w|");
    _tt_add(tt, "ᾫ", "*(\\w|");
    _tt_add(tt, "ᾬ", "*)/w|");
    _tt_add(tt, "ᾭ", "*(/w|");
    _tt_add(tt, "ᾮ", "*)=w|");
    _tt_add(tt, "ᾯ", "*(=w|");
    _tt_add(tt, "Ᾰ", "*%27a");
