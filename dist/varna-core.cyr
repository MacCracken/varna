    _tt_add(tt, "̄", "%26");
    _tt_add(tt, "̆", "%27");
    # Decomposed capitals: a mark after a capital is written before its letter.
    _tt_add(tt, "Ά", "*/a");
    _tt_add(tt, "Έ", "*/e");
    _tt_add(tt, "Ή", "*/h");
    _tt_add(tt, "Ί", "*/i");
    _tt_add(tt, "Ό", "*/o");
    _tt_add(tt, "Ύ", "*/u");
    _tt_add(tt, "Ώ", "*/w");
