    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ɡ", Manner.Plosive, Place.Velar, 1);
    # Affricate
    phoneme_builder_consonant(b, "t͡ʃ", Manner.Affricate, Place.Postalveolar, 0);
    # Fricatives
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "h", Manner.Fricative, Place.Glottal, 0);
    # Nasals
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ɲ", Manner.Nasal, Place.Palatal, 1);
    phoneme_builder_consonant(b, "ŋ", Manner.Nasal, Place.Velar, 1);
    # Trill & approximants
    phoneme_builder_consonant(b, "r", Manner.TapFlap, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    # Oral vowels (6)
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "e", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel(b, "o", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    phoneme_builder_vowel(b, "ɨ", Height.Close, Backness.Central, 0);
    # Nasal vowels (6). Corrected at 2.5.4: five were precomposed with no Nasalized
    # bit, so only ɨ̃ read as [+nasal]. All six now carry the bit and the combining
    # tilde (U+0303), as ɨ̃ already did (see Portuguese).
    phoneme_builder_vowel_full(b, "ã", Height.Open, Backness.Central, 0, PhonemeFeature.Nasalized);
    phoneme_builder_vowel_full(b, "ẽ", Height.CloseMid, Backness.Front, 0, PhonemeFeature.Nasalized);
    phoneme_builder_vowel_full(b, "ĩ", Height.Close, Backness.Front, 0, PhonemeFeature.Nasalized);
    phoneme_builder_vowel_full(b, "õ", Height.CloseMid, Backness.Back, 1, PhonemeFeature.Nasalized);
    phoneme_builder_vowel_full(b, "ũ", Height.Close, Backness.Back, 1, PhonemeFeature.Nasalized);
    phoneme_builder_vowel_full(b, "ɨ̃", Height.Close, Backness.Central, 0, PhonemeFeature.Nasalized);
    _c_phoneme_guarani = phoneme_builder_build(b);
    return _c_phoneme_guarani;
}

var _c_phoneme_icelandic = 0;
fn phoneme_icelandic() {
    if (_c_phoneme_icelandic != 0) { return _c_phoneme_icelandic; }

    var b = phoneme_builder_with_capacity("is", "Icelandic", 30);
    phoneme_builder_stress(b, StressPattern.Free);
    # Aspirated voiceless stops (phonemically distinctive)
    phoneme_builder_consonant_full(b, "pʰ", Manner.Plosive, Place.Bilabial, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant_full(b, "tʰ", Manner.Plosive, Place.Alveolar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant_full(b, "kʰ", Manner.Plosive, Place.Velar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    # Plain (unaspirated) voiceless stops
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    # Voiced stops
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ɡ", Manner.Plosive, Place.Velar, 1);
    # Fricatives
    phoneme_builder_consonant(b, "f", Manner.Fricative, Place.Labiodental, 0);
    phoneme_builder_consonant(b, "v", Manner.Fricative, Place.Labiodental, 1);
    phoneme_builder_consonant(b, "θ", Manner.Fricative, Place.Dental, 0);
    phoneme_builder_consonant(b, "ð", Manner.Fricative, Place.Dental, 1);
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "ç", Manner.Fricative, Place.Palatal, 0);
    phoneme_builder_consonant(b, "h", Manner.Fricative, Place.Glottal, 0);
    # Voiceless lateral fricative (unique feature)
    phoneme_builder_consonant_full(b, "ɬ", Manner.LateralFricative, Place.Alveolar, 0,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    # Voiceless nasals (pre-aspiration related)
    phoneme_builder_consonant_full(b, "m̥", Manner.Nasal, Place.Bilabial, 0,
      Airstream.Pulmonic, PhonemeFeature.Devoiced);
    phoneme_builder_consonant_full(b, "n̥", Manner.Nasal, Place.Alveolar, 0,
      Airstream.Pulmonic, PhonemeFeature.Devoiced);
    phoneme_builder_consonant_full(b, "ŋ̊", Manner.Nasal, Place.Velar, 0,
      Airstream.Pulmonic, PhonemeFeature.Devoiced);
    # Voiced nasal + trill + approximant
    phoneme_builder_consonant(b, "r", Manner.Trill, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    # Monophthong vowels (8)
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel(b, "ɪ", Height.NearClose, Backness.Front, 0);
    phoneme_builder_vowel(b, "e", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "ɛ", Height.OpenMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "ɔ", Height.OpenMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "o", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    _c_phoneme_icelandic = phoneme_builder_build(b);
    return _c_phoneme_icelandic;
}

var _c_phoneme_wolof = 0;
fn phoneme_wolof() {
    if (_c_phoneme_wolof != 0) { return _c_phoneme_wolof; }

    var b = phoneme_builder_with_capacity("wo", "Wolof", 39);
    phoneme_builder_stress(b, StressPattern.Free);
    # Plosives
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant(b, "ɡ", Manner.Plosive, Place.Velar, 1);
    phoneme_builder_consonant(b, "q", Manner.Plosive, Place.Uvular, 0);
    # Prenasalized stops (phonemic units, not sequences)
    phoneme_builder_consonant_full(b, "mb", Manner.Plosive, Place.Bilabial, 1,
      Airstream.Pulmonic, PhonemeFeature.Prenasalized);
    phoneme_builder_consonant_full(b, "nd", Manner.Plosive, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Prenasalized);
    phoneme_builder_consonant_full(b, "ŋɡ", Manner.Plosive, Place.Velar, 1,
      Airstream.Pulmonic, PhonemeFeature.Prenasalized);
    phoneme_builder_consonant_full(b, "ɲɟ", Manner.Plosive, Place.Palatal, 1,
      Airstream.Pulmonic, PhonemeFeature.Prenasalized);
    # Fricatives
    phoneme_builder_consonant(b, "f", Manner.Fricative, Place.Labiodental, 0);
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "x", Manner.Fricative, Place.Velar, 0);
    phoneme_builder_consonant(b, "χ", Manner.Fricative, Place.Uvular, 0);
    phoneme_builder_consonant(b, "h", Manner.Fricative, Place.Glottal, 0);
    # Nasals
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ɲ", Manner.Nasal, Place.Palatal, 1);
    phoneme_builder_consonant(b, "ŋ", Manner.Nasal, Place.Velar, 1);
    # Approximants / liquids
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "r", Manner.Trill, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    # Vowels — 8 short, 7 long. Unseth (2009), "Vowel Harmony in Wolof", Occasional
    # Papers in Applied Linguistics No. 7, Table 1 (p. 1) and Table 2 (p. 2), whose
    # data is "based upon" Ka's Wolof Phonology and Morphology (1993; the corpus said
    # 1994). Sy (2006), Studies in African Linguistics 35(2), ex. (1), p. 204, has the
    # same vowels and values.
    #
    # Corrected at 2.5.3. The comment said "the same assignment appears in Torrence
    # (2013) and PHOIBLE". Torrence could not be checked. PHOIBLE marks no ATR value on
    # any Wolof vowel: it encodes e ~ ɛ as [tense], taken from the letter. Unseth's
    # paper is a student paper and does not credit its tables to Ka.
    #
    # Completed at 2.4.1. The block previously held only /i e a o/ + long, which is
    # not any analysis of Wolof — no description lacks /u/, and a four-quality system
    # is typologically near-unattested. It was byte-identical to the Classical Nahuatl
    # vowel block, i.e. a copy-paste rather than a reduced transcription.
    #
    # CLAD orthography: ⟨i é e ë a o ó u⟩ = /i e ɛ ə a ɔ o u/, doubled for length. So
    # the pre-existing /e/ and /o/ are ⟨é ó⟩ and stay CloseMid; the vowels added here
    # at OpenMid are ⟨e o⟩. /ɛː/ vs /eː/ is minimal-pair-bearing: reew /rɛːw/
    # "impolite" ~ réew /reːw/ "country".
    #
    # [ATR], marked on every vowel since 2.5.3: +ATR /i u e o ə/, −ATR /ɛ ɔ a/, with
    # length not changing the value (Unseth Table 1; Sy ex. 1). Pairs e~ɛ, o~ɔ, ə~a.
    # Sy writes the −ATR partner of ə as ʌ, apart from low a; the values agree. "The
    # high vowels have no [−ATR] counterparts and the low vowels no [+ATR]
    # counterparts" (Sy p. 204). The high vowels are + as a phonological value: "All
    # vowels trigger harmony in initial position" (Sy p. 204), /i u/ included, and
    # medially they let it pass. Their tongue root has not been measured.
    #
    # /ə/ has no long form ("with the exception of [ə]", Unseth p. 1). ⟨aa⟩ "is always
    # [-ATR] and changes all vowels following it to [-ATR]" (Unseth p. 3), as does the
    # suffix -kat. ⟨ëë⟩ is marginal: Unseth, Gauthier et al. (2016) and PHOIBLE omit it.
    #
    # The articulator: Dye (2015, NYU PhD), the first instrumental study, imaged /e/ vs
    # /ɛ/ by ultrasound and found /ɛ/ more retracted, by a small amount that varies by
    # speaker. /o ɔ/ and /ə a/ were not measured.
    var atr = PhonemeFeature.AdvancedTongueRoot;
    var rtr = PhonemeFeature.RetractedTongueRoot;
    var lng = PhonemeFeature.Long;
    phoneme_builder_vowel_full(b, "i", Height.Close, Backness.Front, 0, atr);
    phoneme_builder_vowel_full(b, "u", Height.Close, Backness.Back, 1, atr);
    phoneme_builder_vowel_full(b, "e", Height.CloseMid, Backness.Front, 0, atr);
    phoneme_builder_vowel_full(b, "o", Height.CloseMid, Backness.Back, 1, atr);
    phoneme_builder_vowel_full(b, "ɛ", Height.OpenMid, Backness.Front, 0, rtr);
    phoneme_builder_vowel_full(b, "ɔ", Height.OpenMid, Backness.Back, 1, rtr);
    phoneme_builder_vowel_full(b, "ə", Height.Mid, Backness.Central, 0, atr);
    phoneme_builder_vowel_full(b, "a", Height.Open, Backness.Central, 0, rtr);
    # Vowels — long. No /əː/.
    phoneme_builder_vowel_full(b, "iː", Height.Close, Backness.Front, 0, lng | atr);
    phoneme_builder_vowel_full(b, "uː", Height.Close, Backness.Back, 1, lng | atr);
    phoneme_builder_vowel_full(b, "eː", Height.CloseMid, Backness.Front, 0, lng | atr);
    phoneme_builder_vowel_full(b, "oː", Height.CloseMid, Backness.Back, 1, lng | atr);
    phoneme_builder_vowel_full(b, "ɛː", Height.OpenMid, Backness.Front, 0, lng | rtr);
    phoneme_builder_vowel_full(b, "ɔː", Height.OpenMid, Backness.Back, 1, lng | rtr);
    phoneme_builder_vowel_full(b, "aː", Height.Open, Backness.Central, 0, lng | rtr);
    _c_phoneme_wolof = phoneme_builder_build(b);
    return _c_phoneme_wolof;
}

var _c_phoneme_lao = 0;
fn phoneme_lao() {
    if (_c_phoneme_lao != 0) { return _c_phoneme_lao; }

    # Vientiane Lao. Rebuilt whole at 2.5.3 from one grammar, Enfield (2007), *A Grammar
    # of Lao* (Mouton), ch. 3, Tables 2-4 (pp. 34-35). The 2.5.2 block, unchanged since
    # v1.x, had 20 consonants and 9 vowels with no /a/, /o/, /ɔ/, /ɛ/ or the mid
    # unrounded vowel. That was a truncation, not an analysis: every description checked
    # (Enfield; Morev et al. 1979 and the EA database, both via PHOIBLE) has nine
    # vowel qualities.
    var b = phoneme_builder_with_capacity("lo", "Lao", 41);
    phoneme_builder_stress(b, StressPattern.Tonal);
    # FIVE tones, in Enfield's order 1-5 with his example words (pp. 35-36): mid level
    # khaa1 'galangal', high rising khaa2 'to be stuck', low rising khaa3 'leg', high
    # falling khaa4 'commerce', mid falling khaa5 'slave'. "There are five distinct
    # lexical tones in the variety of Lao spoken by natives of Vientiane (cf. Osatananda
    # 1997)" (p. 35). Osatananda's own abstract also says five.
    #
    # Enfield prints no pitch numbers, so the values are Yanagimura (2011), "Contextual
    # Tonal Variations in Vientiane Lao", Journal of Mekong Societies 7(1), Table 1
    # (p. 4): "canonical pitch patterns of the tones produced in isolation ... on a
    # five-point scale". He numbers the tones differently; matched by example word:
    #   Enfield 1 = his 1, 33 khaa 'value'      Enfield 2 = his 4, 34 kháa 'to be stuck'
    #   Enfield 3 = his 5, 215 khǎa 'leg'       Enfield 4 = his 3, 451 khâa 'to trade'
    #   Enfield 5 = his 2, 31 khàa 'to kill'
    # His prose calls 451 "high rising-falling" and 215 "low falling-rising", so the
    # parse reads them as peaking and dipping, as it reads Thai's citation-form ˨˩˦.
    # Before another syllable he finds both lose the first movement. Osatananda (1997,
    # p. 40) reportedly gives 33 / 35 / 13 / 52 / 31, but that is only as Wikipedia
    # reports it, and the dissertation could not be read. Its values are not used here.
    #
    # The 2.5.2 row was six tones, ˧ ˨˩ ˥˩ ˦˥ ˩˧˥ ˧˥, labelled in v1.x with THAI tone
    # names. It carried two high rises (˦˥ and ˧˥), and no source prints its ˩˧˥.
    # Six-tone analyses of Lao do exist (Hoshino & Marcus 1973). Their sixth is a low
    # level tone, which that row did not have either.
    var t = vec_new();
    vec_push(t, "˧");
    vec_push(t, "˧˦");
    vec_push(t, "˨˩˥");
    vec_push(t, "˦˥˩");
    vec_push(t, "˧˩");
    phoneme_builder_tones(b, t);
    # 20 initial consonants, Enfield Table 2: p t c k ʔ / pʰ tʰ kʰ / b d / f s h /
    # m n ɲ ŋ / l / v j. Lao has no aspirated palatal: the 2.5.2 /t͡ɕʰ/ was Thai's
    # ช, and Lao ຊ is /s/. /ɲ/ (ຍ initially) was missing.
    # Plosives
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant_full(b, "pʰ", Manner.Plosive, Place.Bilabial, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Alveolar, 0);
    phoneme_builder_consonant_full(b, "tʰ", Manner.Plosive, Place.Alveolar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant_full(b, "kʰ", Manner.Plosive, Place.Velar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "ʔ", Manner.Plosive, Place.Glottal, 0);
    # Affricate. Enfield writes c. ຈ "ranges between alveolar-palatal and palatal"
    # (the LDC Lao corpus documentation), so t͡ɕ, as in the Thai row.
    phoneme_builder_consonant(b, "t͡ɕ", Manner.Affricate, Place.Palatal, 0);
    # Fricatives
    phoneme_builder_consonant(b, "f", Manner.Fricative, Place.Labiodental, 0);
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "h", Manner.Fricative, Place.Glottal, 0);
    # Nasals
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ɲ", Manner.Nasal, Place.Palatal, 1);
    phoneme_builder_consonant(b, "ŋ", Manner.Nasal, Place.Velar, 1);
    # Approximants / liquids.
    # /w/ is one phoneme across the syllable. Enfield writes it v- initially, where it
    # is labio-dental and "never pronounced as a bilabial approximant w-", and -w
    # finally, where "Final -w represents the same phoneme as initial v-" (pp. 34-35).
    # The phoneme keeps the w that Morev et al. and the LDC chart write, because ʋ
    # would misdescribe the coda.
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    # Enfield writes the labialized onsets (kua1 'than') as consonant + ua, so the
    # labialized series Morev et al. list (kʷ, kʷʰ, ...) is not separate here.
    #
    # 18 vowels, Enfield Table 4: nine qualities, each short and long. The unrounded
    # column holds ɯ and the mid vowel Enfield writes ə; it is ɤ here, beside ɯ, as in
    # the Thai row, Morev et al. and the LDC chart.
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel_full(b, "iː", Height.Close, Backness.Front, 0, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "ɯ", Height.Close, Backness.Back, 0);
    phoneme_builder_vowel_full(b, "ɯː", Height.Close, Backness.Back, 0, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    phoneme_builder_vowel_full(b, "uː", Height.Close, Backness.Back, 1, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "e", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel_full(b, "eː", Height.CloseMid, Backness.Front, 0, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "ɤ", Height.CloseMid, Backness.Back, 0);
    phoneme_builder_vowel_full(b, "ɤː", Height.CloseMid, Backness.Back, 0, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "o", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel_full(b, "oː", Height.CloseMid, Backness.Back, 1, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "ɛ", Height.OpenMid, Backness.Front, 0);
    phoneme_builder_vowel_full(b, "ɛː", Height.OpenMid, Backness.Front, 0, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel_full(b, "aː", Height.Open, Backness.Central, 0, PhonemeFeature.Long);
    phoneme_builder_vowel(b, "ɔ", Height.OpenMid, Backness.Back, 1);
    phoneme_builder_vowel_full(b, "ɔː", Height.OpenMid, Backness.Back, 1, PhonemeFeature.Long);
    # Diphthongs (as vowel units), Enfield: "ia, ua, ɯa", with no length contrast.
    phoneme_builder_vowel(b, "ia", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "ua", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "ɯa", Height.CloseMid, Backness.Back, 0);
    _c_phoneme_lao = phoneme_builder_build(b);
    return _c_phoneme_lao;
}

var _c_phoneme_mongolian = 0;
fn phoneme_mongolian() {
    if (_c_phoneme_mongolian != 0) { return _c_phoneme_mongolian; }

    var b = phoneme_builder_with_capacity("mn", "Mongolian", 35);
    phoneme_builder_stress(b, StressPattern.Free);
    # Plosives
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant(b, "ɡ", Manner.Plosive, Place.Velar, 1);
    # Affricates
    phoneme_builder_consonant(b, "t͡s", Manner.Affricate, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "d͡z", Manner.Affricate, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "t͡ʃ", Manner.Affricate, Place.Postalveolar, 0);
    # Fricatives
    phoneme_builder_consonant(b, "f", Manner.Fricative, Place.Labiodental, 0);
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "z", Manner.Fricative, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ʃ", Manner.Fricative, Place.Postalveolar, 0);
    phoneme_builder_consonant(b, "x", Manner.Fricative, Place.Velar, 0);
    phoneme_builder_consonant(b, "χ", Manner.Fricative, Place.Uvular, 0);
    # Lateral fricative
    phoneme_builder_consonant_full(b, "ɮ", Manner.LateralFricative, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    # Nasals
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ŋ", Manner.Nasal, Place.Velar, 1);
    # Approximants / liquids
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "r", Manner.Trill, Place.Alveolar, 1);
    # Vowels — back harmony set (short)
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Back, 0);
    phoneme_builder_vowel(b, "o", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    phoneme_builder_vowel(b, "ɔ", Height.OpenMid, Backness.Back, 1);
    # Vowels — front harmony set (short)
    phoneme_builder_vowel(b, "e", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "ø", Height.CloseMid, Backness.Front, 1);
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    # Vowels — long pairs
    phoneme_builder_vowel_full(b, "aː", Height.Open, Backness.Back, 0, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "oː", Height.CloseMid, Backness.Back, 1, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "uː", Height.Close, Backness.Back, 1, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "ɔː", Height.OpenMid, Backness.Back, 1, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "eː", Height.CloseMid, Backness.Front, 0, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "øː", Height.CloseMid, Backness.Front, 1, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "iː", Height.Close, Backness.Front, 0, PhonemeFeature.Long);
    _c_phoneme_mongolian = phoneme_builder_build(b);
    return _c_phoneme_mongolian;
}

# --- allophone.cyr ---

# src/allophone.cyr — context-dependent allophone rules.
#
# Ported from v1.x Rust src/phoneme/allophone.rs.
#
# AllophoneRule (32B):    [0]=phoneme [8]=allophone [16]=environment [24]=obligatory(0/1)
# AllophoneRuleSet (16B): [0]=language_code [8]=rules(vec)
#
# v1.x's one `Environment` enum is two declarations here, for one reason each.
# `#derive(Serialize)` refuses an enum with a payload variant, and it is what gives the
# unit variants their by-name codec (ADR 0003), so `Before` / `After` cannot join
# `Environment`. And enum constants are global names: a second `Vowel` is "duplicate
# symbol ... last definition wins", so `PhonemeClass` cannot use v1.x's variant names, and
# neither set takes a bare `Before` / `After` that every consumer of dist/ would inherit.
#
#   v1.x                                       varna
#   Environment::Intervocalic                  Environment.Intervocalic      (an int)
#   Environment::Before(PhonemeClass::Nasal)   EnvBefore(PhonemeClass.ClassNasal)
#   Environment::After(PhonemeClass::Specific  EnvAfter(ClassSpecific("k"))
#     ("k".into()))
#
# So an environment VALUE is a unit `Environment` constant, or a box (tag at +0, payload
# at +8) from EnvBefore / EnvAfter. A `PhonemeClass` value is a unit constant, or a box
# from ClassSpecific. The two are told apart by range, and compared by value with
# environment_eq, as v1.x's derived PartialEq compared them.
#
# As in v1.x, `Before` / `After` are labels matched by equality. No code evaluates a class
# against a phoneme, and allophone_english() uses neither.
#
# src/json.cyr maps PhonemeClass to v1.x's names by hand, the one exception to ADR 0003's
# derived enum names (see its amendment).

#derive(Serialize)
enum Environment {
    WordInitial = 0;
    WordFinal = 1;
    Intervocalic = 2;
    PreVocalic = 3;
    PostVocalic = 4;
    SyllableFinal = 5;
    SyllableInitial = 6;
    PreStress = 7;
    Unstressed = 8;
}

# v1.x's PhonemeClass, a broad class of phonemes for environment matching.
enum PhonemeClass {
    ClassVowel = 0;
    ClassConsonant = 1;
    ClassNasal = 2;
    ClassPlosive = 3;
    ClassFricative = 4;
    ClassVoiceless = 5;
    ClassVoiced = 6;
    ClassSpecific(ipa);
}

# v1.x's Environment::Before / ::After. Each takes a PhonemeClass value.
enum ClassEnvironment {
    EnvBefore(cls);
    EnvAfter(cls);
}

# The first page is never mapped, so no box sits below this, and no enum here comes near
# it. A value is a box exactly when it is at or above it.
var _ALLOPHONE_BOX_MIN = 4096;

# 1 when `e` is a box from EnvBefore / EnvAfter, 0 when it is a unit Environment.
#must_use
fn environment_is_conditioned(e) {
    if (e >= _ALLOPHONE_BOX_MIN) { return 1; }
    return 0;
}

# A conditioned environment's side (ClassEnvironment.EnvBefore / .EnvAfter), or -1 for
# a unit Environment.
#must_use
fn environment_side(e) {
    if (environment_is_conditioned(e) == 0) { return 0 - 1; }
    return load64(e);
}

# A conditioned environment's PhonemeClass value, or -1 for a unit Environment.
#must_use
fn environment_class(e) {
    if (environment_is_conditioned(e) == 0) { return 0 - 1; }
    return load64(e + 8);
}

# 1 when `c` is a box from ClassSpecific, 0 when it is a unit PhonemeClass.
#must_use
fn phoneme_class_is_specific(c) {
    if (c >= _ALLOPHONE_BOX_MIN) { return 1; }
    return 0;
}

# The IPA symbol a ClassSpecific names, or 0 for a unit PhonemeClass.
#must_use
fn phoneme_class_ipa(c) {
    if (phoneme_class_is_specific(c) == 0) { return 0; }
    return load64(c + 8);
}

# 1 when two PhonemeClass values are equal: the same constant, or the same IPA symbol.
#must_use
fn phoneme_class_eq(a, b) {
    if (a == b) { return 1; }
    if (phoneme_class_is_specific(a) == 0 || phoneme_class_is_specific(b) == 0) { return 0; }
    return streq(load64(a + 8), load64(b + 8));
}

# 1 when two environment values are equal: the same constant, or the same side and class.
# Two boxes built apart compare equal, which is what lets a caller build the environment
# it asks allophone_realize about.
#must_use
fn environment_eq(a, b) {
    if (a == b) { return 1; }
    if (environment_is_conditioned(a) == 0 || environment_is_conditioned(b) == 0) { return 0; }
    if (load64(a) != load64(b)) { return 0; }
    return phoneme_class_eq(load64(a + 8), load64(b + 8));
}

fn _arule_new(phoneme, allophone, env, obligatory) {
    var r = alloc(32);
    store64(r, phoneme);
    store64(r + 8, allophone);
    store64(r + 16, env);
    store64(r + 24, obligatory);
    return r;
}

fn allophone_rule_phoneme(r) { return load64(r); }
fn allophone_rule_allophone(r) { return load64(r + 8); }
fn allophone_rule_environment(r) { return load64(r + 16); }
fn allophone_rule_obligatory(r) { return load64(r + 24); }

fn _aset_new(code) {
    var s = alloc(16);
    store64(s, code);
    store64(s + 8, vec_new());
    return s;
}

fn _aset_add(s, phoneme, allophone, env, obligatory) {
    vec_push(load64(s + 8), _arule_new(phoneme, allophone, env, obligatory));
    return s;
}

fn allophone_language_code(s) { return load64(s); }
fn allophone_rules(s) { return load64(s + 8); }

# All allophone rules for a phoneme — vec of rule ptrs (possibly empty).
fn allophone_rules_for(s, phoneme) {
    var rules = load64(s + 8);
    var n = vec_len(rules);
    var out = vec_new();
    var i = 0;
    while (i < n) {
        var r = vec_get(rules, i);
        if (streq(load64(r), phoneme) == 1) { vec_push(out, r); }
        i = i + 1;
    }
    return out;
}

# Surface realization of a phoneme in an environment — the allophone if a rule
# matches (first wins), else the phoneme unchanged.
fn allophone_realize(s, phoneme, env) {
    var rules = load64(s + 8);
    var n = vec_len(rules);
    var i = 0;
    while (i < n) {
        var r = vec_get(rules, i);
        if (streq(load64(r), phoneme) == 1 && environment_eq(load64(r + 16), env) == 1) {
            return load64(r + 8);
        }
        i = i + 1;
    }
    return phoneme;
}

# --- Pre-built rule sets -------------------------------------------

var _c_allophone_english = 0;
# English (General American) allophone rules.
fn allophone_english() {
    if (_c_allophone_english != 0) { return _c_allophone_english; }
    var s = _aset_new("en");
    _aset_add(s, "t", "ɾ", Environment.Intervocalic, 0);
    _aset_add(s, "t", "tʰ", Environment.WordInitial, 1);
    _aset_add(s, "p", "pʰ", Environment.WordInitial, 1);
    _aset_add(s, "k", "kʰ", Environment.WordInitial, 1);
    _aset_add(s, "l", "ɫ", Environment.SyllableFinal, 1);
    _aset_add(s, "ə", "ɨ", Environment.Unstressed, 0);
    _c_allophone_english = s;
    return _c_allophone_english;
}

# --- Lookup by language (2.6.0) ------------------------------------
# The same shape as grammar_by_code and swadesh_by_code. Each set is cached, so
# a caller gets the same record back on every call.

# The rule set for an ISO 639 code, or 0 when the corpus has none for it.
#must_use
fn allophone_by_code(code) {
    if (code == 0) { return 0; }
    if (streq(code, "en") == 1) { return allophone_english(); }
    if (streq(code, "es") == 1) { return allophone_spanish(); }
    if (streq(code, "ja") == 1) { return allophone_japanese(); }
    if (streq(code, "ru") == 1) { return allophone_russian(); }
    if (streq(code, "zh") == 1) { return allophone_mandarin(); }
    if (streq(code, "ar") == 1) { return allophone_arabic(); }
    return 0;
}

var _c_allophone_all_codes = 0;
# Every code with a rule set, in the order they were added — vec of cstrings.
fn allophone_all_codes() {
    if (_c_allophone_all_codes != 0) { return _c_allophone_all_codes; }
    var c = vec_new();
    vec_push(c, "en");
    vec_push(c, "es");
    vec_push(c, "ja");
    vec_push(c, "ru");
    vec_push(c, "zh");
    vec_push(c, "ar");
    _c_allophone_all_codes = c;
    return _c_allophone_all_codes;
}

# --- The 2.6.0 rule sets -------------------------------------------
# Each set comes from ONE description, the language's JIPA Illustration of the IPA,
# and holds only the rules whose environment this model states exactly. A rule whose
# real environment the model cannot say ("elsewhere", "in a syllable closed by a
# nasal", "after a palatalized consonant") is listed in the set's comment and NOT
# encoded: a nearby environment would state something the source does not.
# "Before a voiced consonant" is spelled out as one rule per consonant, because the
# Voiced class is a label (nothing evaluates it) and would read as including vowels.

# Before(Specific(seg)) for one IPA segment.
fn _env_before(seg) { return EnvBefore(ClassSpecific(seg)); }
fn _env_after(seg) { return EnvAfter(ClassSpecific(seg)); }

# One rule per segment in `segs`, all with the same phoneme, allophone and Before side.
fn _aset_add_before_each(s, phoneme, allophone, segs, obligatory) {
    var i = 0;
    while (i < vec_len(segs)) {
        _aset_add(s, phoneme, allophone, _env_before(vec_get(segs, i)), obligatory);
        i = i + 1;
    }
    return s;
}

var _c_allophone_spanish = 0;
# Castilian Spanish: Martínez-Celdrán, Fernández-Planas & Carrera-Sabaté (2003), JIPA
# 33(2), pp. 257-258.
#   Nasal place: "The place of articulation of nasal consonants in syllabic codas is
#     always the same as that of any following consonant": ánfora [ˈaɱfoɾa], encía
#     [en̟ˈθia], antes, ancha, banco. Encoded for the places the examples show.
#   Voicing: θ "like [s], becomes voiced before a voiced consonant" (rasgo [ˈrazɣo]).
#   /s/ "often becomes dental before a denti-alveolar consonant" (optional).
#   /x/ "can be pronounced uvular before a back vowel and the semivowel [w]" (optional).
#   /l/ "can become interdentalised, dentalised" before those places (optional).
# NOT encoded: spirantization of /b d ɡ/ to [β̞ ð̞ ɣ̞] (their environment is "in other
#   positions" than after a pause, a nasal, or for /d/ a lateral: an elsewhere case);
#   /ɟ͡ʝ/ → [ʝ̞] "in all other contexts"; /l/ palatalized (the source names a place, not
#   segments); vowel nasalization between nasals; coda /b d ɡ/ deletion.
fn allophone_spanish() {
    if (_c_allophone_spanish != 0) { return _c_allophone_spanish; }
    var s = _aset_new("es");
    _aset_add(s, "n", "m", _env_before("p"), 1);
    _aset_add(s, "n", "m", _env_before("b"), 1);
    _aset_add(s, "n", "ɱ", _env_before("f"), 1);
    _aset_add(s, "n", "n̟", _env_before("θ"), 1);
    _aset_add(s, "n", "n̪", _env_before("t"), 1);
    _aset_add(s, "n", "n̪", _env_before("d"), 1);
    _aset_add(s, "n", "nʲ", _env_before("t͡ʃ"), 1);
    _aset_add(s, "n", "ŋ", _env_before("k"), 1);
    _aset_add(s, "n", "ŋ", _env_before("ɡ"), 1);
    _aset_add(s, "n", "ŋ", _env_before("x"), 1);
    var voiced = vec_new();
    vec_push(voiced, "b");
    vec_push(voiced, "d");
    vec_push(voiced, "ɡ");
    vec_push(voiced, "ɟ͡ʝ");
    vec_push(voiced, "m");
    vec_push(voiced, "n");
    vec_push(voiced, "ɲ");
    vec_push(voiced, "l");
    vec_push(voiced, "ʎ");
    vec_push(voiced, "ɾ");
    vec_push(voiced, "r");
    _aset_add_before_each(s, "s", "z", voiced, 1);
    _aset_add_before_each(s, "θ", "θ̬", voiced, 1);
    _aset_add(s, "s", "s̪", _env_before("t"), 0);
    _aset_add(s, "s", "s̪", _env_before("d"), 0);
    _aset_add(s, "x", "χ", _env_before("u"), 0);
    _aset_add(s, "x", "χ", _env_before("o"), 0);
    _aset_add(s, "x", "χ", _env_before("w"), 0);
    _aset_add(s, "l", "l̟", _env_before("θ"), 0);
    _aset_add(s, "l", "l̪", _env_before("t"), 0);
    _aset_add(s, "l", "l̪", _env_before("d"), 0);
    _c_allophone_spanish = s;
    return _c_allophone_spanish;
}

var _c_allophone_japanese = 0;
# Tokyo Japanese: Okada (1991), JIPA 21(2), p. 95.
#   "/tˢ/ is normally [ts] but becomes [tɕ] before /i/"
#   "/s/ and /z/ are [ɕ] and [ʑ] before /i/"
#   "/z/ may be [ᵈz] initially ([ᵈʑ] before /i/) and after /N/" (optional)
#   "/h/ tends towards [ç] and [ɸ] before /i/ and /u/ respectively" (optional)
#   /g/ among younger speakers "often tends to become [ɣ] between vowels" (optional)
#   "Consonants, and notably /n/, are generally strongly palatalized before /i/"
#     (optional; ʲ is the IPA mark for "palatalized", Okada gives no symbol)
# NOT encoded: /g/ → [ŋ] "medially" (no exact environment); high-vowel devoicing
#   "between voiceless consonants" except in accented syllables; final /su/ → [s]; /ɴ/'s
#   homorganic place; [ᵈʑ] word-initially before /i/ (two conditions at once).
fn allophone_japanese() {
    if (_c_allophone_japanese != 0) { return _c_allophone_japanese; }
    var s = _aset_new("ja");
    _aset_add(s, "t͡s", "t͡ɕ", _env_before("i"), 1);
    _aset_add(s, "s", "ɕ", _env_before("i"), 1);
    _aset_add(s, "z", "ʑ", _env_before("i"), 1);
    _aset_add(s, "z", "ᵈz", Environment.WordInitial, 0);
    _aset_add(s, "z", "ᵈz", _env_after("ɴ"), 0);
    _aset_add(s, "h", "ç", _env_before("i"), 0);
    _aset_add(s, "h", "ɸ", _env_before("u"), 0);
    _aset_add(s, "ɡ", "ɣ", Environment.Intervocalic, 0);
    _aset_add(s, "n", "nʲ", _env_before("i"), 0);
    _c_allophone_japanese = s;
    return _c_allophone_japanese;
}

var _c_allophone_russian = 0;
# Russian (St. Petersburg standard): Yanushevskaya & Bunčić (2015), JIPA 45(2).
#   Final devoicing: "only voiceless but no voiced obstruents occur word-finally"
#     (p. 223), each to its voiceless partner in the chart (p. 222).
#   Vowel reduction (p. 225): "/o/ is replaced with /a/", and /a/ "is realised as [ʌ]
#     or [ɐ] in the first degree of reduction (the former is characteristic of
#     St. Petersburg...) and as [ə] in the second". The first degree is "the syllable
#     immediately before the stressed syllable" (PreStress here); the second applies
#     "to all other unstressed syllables" (Unstressed here, which in this set means
#     unstressed and not immediately before the stress).
#   /j/ is "a semivowel [i̯] (especially when unstressed)" (p. 223, optional).
# NOT encoded: regressive voicing assimilation (needs a class "voiced obstruent other
#   than /v vʲ/"); /e/ → /i/ or /ɨ/ unstressed (no condition given for which);
#   ikanye after palatalized consonants; [æ] between palatalized consonants;
#   labialization before /o u/ (one rule per consonant); /ɨ/ "tends to be
#   diphthongised ... particularly when word-final" (p. 225: no target symbol given).
fn allophone_russian() {
    if (_c_allophone_russian != 0) { return _c_allophone_russian; }
    var s = _aset_new("ru");
    var wf = Environment.WordFinal;
    _aset_add(s, "b", "p", wf, 1);
    _aset_add(s, "bʲ", "pʲ", wf, 1);
    _aset_add(s, "d", "t", wf, 1);
    _aset_add(s, "dʲ", "tʲ", wf, 1);
    _aset_add(s, "ɡ", "k", wf, 1);
    _aset_add(s, "ɡʲ", "kʲ", wf, 1);
    _aset_add(s, "v", "f", wf, 1);
    _aset_add(s, "vʲ", "fʲ", wf, 1);
    _aset_add(s, "z", "s", wf, 1);
    _aset_add(s, "zʲ", "sʲ", wf, 1);
    _aset_add(s, "ʒ", "ʃ", wf, 1);
    _aset_add(s, "o", "ʌ", Environment.PreStress, 1);
    _aset_add(s, "a", "ʌ", Environment.PreStress, 1);
    _aset_add(s, "o", "ə", Environment.Unstressed, 1);
    _aset_add(s, "a", "ə", Environment.Unstressed, 1);
    _aset_add(s, "j", "i̯", Environment.Unstressed, 0);
    _c_allophone_russian = s;
    return _c_allophone_russian;
}

var _c_allophone_mandarin = 0;
# Standard Chinese (Beijing): Lee & Zee (2003), JIPA 33(1), p. 111.
#   "In open syllables, [i, y, u] are about cardinal, [a] = [a̠]"
#   "in open syllables [ə] is rhotacized, i.e. [ɚ]"
# SyllableFinal is exact for both: a and ə are monophthong units here (diphthongs are
# separate units), so the vowel ends its syllable exactly when the syllable is open.
# NOT encoded: [a] = [a̟] and [u] = [ʊ] "in syllables closed by a nasal" (a nasal in
#   the same syllable, which Before(Nasal) does not say); [ɤ] "slightly diphthongized
#   from [ɤ] to [ʌ]" (no symbol given); voicing of syllable-initial obstruents before
#   the neutral tone (a tone, not stress); "[w] has a free variant form of [ʋ]" (no
#   environment); er-hua and tone sandhi.
fn allophone_mandarin() {
    if (_c_allophone_mandarin != 0) { return _c_allophone_mandarin; }
    var s = _aset_new("zh");
    _aset_add(s, "a", "a̠", Environment.SyllableFinal, 1);
    _aset_add(s, "ə", "ɚ", Environment.SyllableFinal, 1);
    _c_allophone_mandarin = s;
    return _c_allophone_mandarin;
}

var _c_allophone_arabic = 0;
# Arabic, spoken Modern Standard Arabic as read by one speaker of Levantine background:
# Thelwall & Sa'adeddin (1990), JIPA 20(2), pp. 38-39.
#   "/tˤ,dˤ,sˤ,ðˤ/ are Retracted Tongue Root ... /ʕ/ is a Retracted Tongue Root glottal
#     stop" (p. 38): the five consonants the vowel rules name as RTR.
#   "/a/ has three main allophones: [ɑ] before Retracted Tongue Root consonants, [ɐ]
#     before word boundary, and [a] elsewhere, taking phonological length into
#     account" (p. 39). So /aː/ → [ɑː] before them too.
#   "/i/ and /ij/ become [ɨ] before Retracted Tongue Root and pharyngeal consonants":
#     the five RTR consonants and pharyngeal /ħ/. Encoded for short /i/.
# NOT encoded: emphasis spread over the whole lexeme in both directions, blocked only
#   by /j/ (p. 38); "/u/ and /uw/ become [ʊ] and [ɤ]" (which goes with which is not
#   stated); /iː/ (whether [ɨ] keeps its length is not stated); word-final /aː/ (its
#   length "is neutralised", to what is not stated).
fn allophone_arabic() {
    if (_c_allophone_arabic != 0) { return _c_allophone_arabic; }
    var s = _aset_new("ar");
    var rtr = vec_new();
    vec_push(rtr, "tˤ");
    vec_push(rtr, "dˤ");
    vec_push(rtr, "sˤ");
    vec_push(rtr, "ðˤ");
    vec_push(rtr, "ʕ");
    _aset_add_before_each(s, "a", "ɑ", rtr, 1);
    _aset_add_before_each(s, "aː", "ɑː", rtr, 1);
    _aset_add(s, "a", "ɐ", Environment.WordFinal, 1);
    _aset_add_before_each(s, "i", "ɨ", rtr, 1);
    _aset_add(s, "i", "ɨ", _env_before("ħ"), 1);
    _c_allophone_arabic = s;
    return _c_allophone_arabic;
}

# --- syllable.cyr ---

# src/syllable.cyr — syllable structure + phonotactic constraints.
#
# Ported from v1.x Rust src/phoneme/syllable.rs.
#
# SyllableTemplate (32B):      [0]=max_onset [8]=max_coda [16]=complex_nucleus(0/1) [24]=pattern
# PhonotacticConstraint (32B): [0]=kind [8]=position [16]=sequences(vec) [24]=description
# Phonotactics (24B):          [0]=language_code [8]=syllable(template) [16]=constraints(vec)
#
# is_permitted returns tri-state: 1 = permitted, 0 = forbidden, (0-1) = unspecified.

#derive(Serialize)
enum ConstraintKind {
    Permitted = 0;
    Forbidden = 1;
}

#derive(Serialize)
enum SyllablePosition {
    Onset = 0;
    Coda = 1;
    Nucleus = 2;
    AcrossBoundary = 3;
}

# --- SyllableTemplate ----------------------------------------------

fn _syllable_new(max_onset, max_coda, complex_nucleus, pattern) {
    var t = alloc(32);
    store64(t, max_onset);
    store64(t + 8, max_coda);
    store64(t + 16, complex_nucleus);
    store64(t + 24, pattern);
    return t;
}

fn syllable_max_onset(t) { return load64(t); }
fn syllable_max_coda(t) { return load64(t + 8); }
fn syllable_complex_nucleus(t) { return load64(t + 16); }
fn syllable_pattern(t) { return load64(t + 24); }

fn syllable_allows_onset_clusters(t) {
    if (load64(t) > 1) { return 1; }
    return 0;
}

fn syllable_allows_coda_clusters(t) {
    if (load64(t + 8) > 1) { return 1; }
    return 0;
}

fn syllable_allows_closed_syllables(t) {
    if (load64(t + 8) > 0) { return 1; }
    return 0;
}

# --- Constraints ---------------------------------------------------

fn _constraint_new(kind, position, description) {
    var c = alloc(32);
    store64(c, kind);
    store64(c + 8, position);
    store64(c + 16, vec_new());
    store64(c + 24, description);
    return c;
}

fn _constraint_add_seq(c, seq) {
    vec_push(load64(c + 16), seq);
    return c;
}

fn constraint_kind(c) { return load64(c); }
fn constraint_position(c) { return load64(c + 8); }
fn constraint_sequences(c) { return load64(c + 16); }
fn constraint_description(c) { return load64(c + 24); }

# --- Phonotactics --------------------------------------------------

fn _phonotactics_new(code, syllable) {
    var p = alloc(24);
    store64(p, code);
    store64(p + 8, syllable);
    store64(p + 16, vec_new());
    return p;
}

fn _phonotactics_add(p, constraint) {
    vec_push(load64(p + 16), constraint);
    return p;
}

fn phonotactics_language_code(p) { return load64(p); }
fn phonotactics_syllable(p) { return load64(p + 8); }
fn phonotactics_constraints(p) { return load64(p + 16); }

# Convenience accessors delegating to the syllable template.
fn phonotactics_max_onset(p) { return syllable_max_onset(load64(p + 8)); }
fn phonotactics_max_coda(p) { return syllable_max_coda(load64(p + 8)); }
fn phonotactics_pattern(p) { return syllable_pattern(load64(p + 8)); }
fn phonotactics_allows_onset_clusters(p) { return syllable_allows_onset_clusters(load64(p + 8)); }
fn phonotactics_allows_coda_clusters(p) { return syllable_allows_coda_clusters(load64(p + 8)); }
fn phonotactics_allows_closed_syllables(p) { return syllable_allows_closed_syllables(load64(p + 8)); }

# All constraints at a syllable position — vec of constraint ptrs.
fn phonotactics_constraints_at(p, position) {
    var cs = load64(p + 16);
    var n = vec_len(cs);
    var out = vec_new();
    var i = 0;
    while (i < n) {
        var c = vec_get(cs, i);
        if (load64(c + 8) == position) { vec_push(out, c); }
        i = i + 1;
    }
    return out;
}

# Tri-state: 1 permitted, 0 forbidden, (0-1) unspecified. First match wins.
fn phonotactics_is_permitted(p, sequence, position) {
    var cs = load64(p + 16);
    var n = vec_len(cs);
    var i = 0;
    while (i < n) {
        var c = vec_get(cs, i);
        if (load64(c + 8) == position) {
            var seqs = load64(c + 16);
            var m = vec_len(seqs);
            var j = 0;
            while (j < m) {
                if (streq(vec_get(seqs, j), sequence) == 1) {
                    if (load64(c) == ConstraintKind.Permitted) { return 1; }
                    return 0;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# --- Pre-built phonotactic profiles --------------------------------
# Re-sourced and extended at 2.6.0 to the 11 core languages (en ar zh hi ja es fr de ru
# ko pt) plus Sanskrit. The v1.x profiles for en, sa and ja were unsourced, and two were
# wrong (see each). Each profile now names ONE description. A Permitted list is an
# enumeration that source prints, and a Forbidden list holds sequences it explicitly
# excludes. is_permitted answers 'unspecified' for anything else, which is not a ban.
# Sequences are spelled in each inventory's own symbols, so a profile can be checked
# against its inventory (tests/syllable_profiles.tcyr).

var _c_phonotactics_english = 0;
# English, after Cruttenden (rev.), Gimson's Pronunciation of English (1994), §10.9.1,
# pp. 216-220 (read through archive.org full-text search; pages from running heads).
# Template: initial CCC is the largest onset type (p. 218); "Final CCCC clusters occur
# only rarely, as a result of the suffixation" (prompts /-mpts/, sixths /-ksθs/).
# Onsets: "/s/ is the essential first element of CCC clusters; the second element is
# a voiceless stop; the third element must be one of /l,r,j,w/"; /spw- stl- stw-/ do
# not occur, "/CCj/ occurs only before /uː/". Gimson describes RP. The corpus inventory
# is General American, so /stj-/ (RP 'stew') is left out: GA has no yod there.
# Gimson's /r/ is the corpus's ɹ. Forbidden: "/ŋ/ does not occur initially", and
# /tl dl/ "do not occur initially".
# Corrected at 2.6.0: the v1.x list wrote r for ɹ, so "str" never matched the
# inventory; it described all of them as "/s/+stop"; it lacked skl; and it banned
# /sr/, which Gimson lists as occurring in loans (Sri Lanka).
fn phonotactics_english() {
    if (_c_phonotactics_english != 0) { return _c_phonotactics_english; }
    var p = _phonotactics_new("en", _syllable_new(3, 4, 1, "(C)(C)(C)V(C)(C)(C)(C)"));
    var c0 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Onset,
      "English CCC onsets: /s/ + voiceless stop + /l ɹ j w/ (Gimson)");
    _constraint_add_seq(c0, "spl");
    _constraint_add_seq(c0, "spɹ");
    _constraint_add_seq(c0, "spj");
    _constraint_add_seq(c0, "stɹ");
    _constraint_add_seq(c0, "skl");
    _constraint_add_seq(c0, "skɹ");
    _constraint_add_seq(c0, "skj");
    _constraint_add_seq(c0, "skw");
    _phonotactics_add(p, c0);
    var c1 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Onset,
      "English /s/ + consonant onsets (Gimson)");
    _constraint_add_seq(c1, "sp");
    _constraint_add_seq(c1, "st");
    _constraint_add_seq(c1, "sk");
    _constraint_add_seq(c1, "sm");
    _constraint_add_seq(c1, "sn");
    _constraint_add_seq(c1, "sl");
    _constraint_add_seq(c1, "sf");
    _constraint_add_seq(c1, "sw");
    _phonotactics_add(p, c1);
    var c2 = _constraint_new(ConstraintKind.Forbidden, SyllablePosition.Onset, "Not word-initial in English (Gimson)");
    _constraint_add_seq(c2, "ŋ");
    _constraint_add_seq(c2, "tl");
    _constraint_add_seq(c2, "dl");
    _phonotactics_add(p, c2);
    _c_phonotactics_english = p;
    return _c_phonotactics_english;
}

var _c_phonotactics_sanskrit = 0;
# Sanskrit, after Allen (1953), Phonetics in Ancient India, §3.2, pp. 70, 80-83, which
# reports the Prātiśākhya doctrine. A final consonant in pausa belongs with the
# preceding vowel (p. 82), and Whitney (1889, §150) agrees that "only one consonant,
# of whatever kind, is allowed to stand at the end of a word" (root stops after r,
# ūrk, are the exception). Allen gives no onset maximum; strī 'woman' is monosyllabic
# (Macdonell 1927, p. 61, §100a), an onset of three. Long vowels count 2 mātrās
# (Allen p. 83). "Of the non-nasal sparśas only the voiceless unaspirated stops may
# occur finally in pausa" (p. 70); no palatal is final (Whitney §142).
# Corrected at 2.6.0: the v1.x template had coda 2 and onset 2, and its onset list
# (pr kr tr sr pl kl) had no source and spelled t where the inventory has t̪.
fn phonotactics_sanskrit() {
    if (_c_phonotactics_sanskrit != 0) { return _c_phonotactics_sanskrit; }
    var p = _phonotactics_new("sa", _syllable_new(3, 1, 1, "(C)(C)(C)V(C)"));
    var c0 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Coda,
      "Sanskrit non-nasal stops allowed word-finally in pausa (Allen p. 70)");
    _constraint_add_seq(c0, "k");
    _constraint_add_seq(c0, "ʈ");
    _constraint_add_seq(c0, "t̪");
    _constraint_add_seq(c0, "p");
    _phonotactics_add(p, c0);
    _c_phonotactics_sanskrit = p;
    return _c_phonotactics_sanskrit;
}

var _c_phonotactics_japanese = 0;
# Tokyo Japanese, after Kubozono (2015), "Introduction to Japanese phonetics and
# phonology", Handbook of Japanese Phonetics and Phonology, p. 16: "the syllable
# structure of the language can be described as (Cj)V(VC)". The second V and the C
# "cannot generally co-occur" (no superheavy syllables). The moraic obstruent /Q/ and
# nasal /N/ "only occur in the coda position of the syllable" (p. 9). /Q/ is the first
# half of a geminate (ip.pai, it.tai, ik.kai, nis.san); p t k s are its printed
# examples, and /N/ is the corpus's ɴ.
# Corrected at 2.6.0: v1.x had "(C)V(N)", onset 1 and a nasal-only coda, so it
# excluded both Cj onsets (kja, ɾjo) and the obstruent coda Okada (1991, p. 95)
# already describes.
fn phonotactics_japanese() {
    if (_c_phonotactics_japanese != 0) { return _c_phonotactics_japanese; }
    var p = _phonotactics_new("ja", _syllable_new(2, 1, 1, "(C)(C)V(C)"));
    var c0 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Coda,
      "Japanese codas: the moraic nasal and the moraic obstruent (Kubozono)");
    _constraint_add_seq(c0, "ɴ");
    _constraint_add_seq(c0, "p");
    _constraint_add_seq(c0, "t");
    _constraint_add_seq(c0, "k");
    _constraint_add_seq(c0, "s");
    _phonotactics_add(p, c0);
    _c_phonotactics_japanese = p;
    return _c_phonotactics_japanese;
}

var _c_phonotactics_arabic = 0;
# Modern Standard Arabic, after Ryding (2005), A Reference Grammar of Modern Standard
# Arabic, §6, pp. 35-36. "No word or syllable may start with a vowel" (p. 35), so the
# onset is required; "no word or syllable may begin with a consonant cluster, such as
# /sk/ or /br/" (p. 36). The five syllable types are CV, CVV, CVC, and in pause form
# CVVC and CVCC, "primarily in word-final position" (p. 36). The template also admits
# CVVCC, which Ryding's list excludes; that cannot be stated here.
fn phonotactics_arabic() {
    if (_c_phonotactics_arabic != 0) { return _c_phonotactics_arabic; }
    var p = _phonotactics_new("ar", _syllable_new(1, 2, 1, "CV(C)(C)"));
    var c0 = _constraint_new(ConstraintKind.Forbidden, SyllablePosition.Onset,
      "No onset cluster in MSA; Ryding's examples (p. 36)");
    _constraint_add_seq(c0, "sk");
    _constraint_add_seq(c0, "br");
    _phonotactics_add(p, c0);
    _c_phonotactics_arabic = p;
    return _c_phonotactics_arabic;
}

var _c_phonotactics_mandarin = 0;
# Standard Chinese (Beijing), after Lee & Zee (2003), JIPA 33(1), p. 111, the source of
# the inventory. It prints no template: (C)V(C) follows from its distributions. Rising
# diphthongs and triphthongs are vowel units here, so the onset is one consonant.
# "[m] occurs only in syllable-initial position; [n] occurs in both syllable-initial
# and syllable-final positions; and [ŋ] occurs only in syllable-final position."
# Not stateable here: which vowels occur in open syllables only (ɤ, ai au ou uo ei, the
# triphthongs, ɹ̩), which only before a nasal (uə iu), and ɕ t͡ɕ t͡ɕʰ only before i y.
fn phonotactics_mandarin() {
    if (_c_phonotactics_mandarin != 0) { return _c_phonotactics_mandarin; }
    var p = _phonotactics_new("zh", _syllable_new(1, 1, 1, "(C)V(C)"));
    var c0 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Coda, "Mandarin codas (Lee & Zee p. 111)");
    _constraint_add_seq(c0, "n");
    _constraint_add_seq(c0, "ŋ");
    _phonotactics_add(p, c0);
    var c1 = _constraint_new(ConstraintKind.Forbidden, SyllablePosition.Coda,
      "Syllable-initial only (Lee & Zee p. 111)");
    _constraint_add_seq(c1, "m");
    _phonotactics_add(p, c1);
    var c2 = _constraint_new(ConstraintKind.Forbidden, SyllablePosition.Onset,
      "Syllable-final only (Lee & Zee p. 111)");
    _constraint_add_seq(c2, "ŋ");
    _phonotactics_add(p, c2);
    _c_phonotactics_mandarin = p;
    return _c_phonotactics_mandarin;
}

var _c_phonotactics_hindi = 0;
# Standard Hindi, after Ohala (1983), Aspects of Hindi Phonology, ch. 4, pp. 38-45,
# 72-73. She lists clusters at word edges and prints no template; the pattern follows
# from her lists. Onsets reach three ("str-, spr-, spl-, skr-, smr-", p. 39). Final
# three-consonant clusters "occur in Sanskrit loans only", and one four-consonant final
# (-rtsy) occurs in one loan (p. 43). Native finals reach two.
# complex_nucleus is 1 to match the corpus inventory's long vowels. Ohala treats Hindi
# vowels as contrasting in quality, not length, and [əi əu] as two vowels (p. 73).
# Her symbols are mapped to the inventory's (t d -> t̪ d̪, ṭ ḍ -> ʈ ɖ, č ǰ -> t͡ɕ d͡ʑ,
# y w h -> j ʋ ɦ, š -> ɕ). zy- is left out, as /z/ is not in the inventory. Her tables
# "do not list all possible loan clusters" (p. 38), and the two-consonant loan finals
# are not enumerated here, so they read unspecified.
fn phonotactics_hindi() {
    if (_c_phonotactics_hindi != 0) { return _c_phonotactics_hindi; }
    var p = _phonotactics_new("hi", _syllable_new(3, 3, 1, "(C)(C)(C)V(C)(C)(C)"));
    var c0 = _constraint_new(ConstraintKind.Permitted, SyllablePosition.Onset,
      "Hindi word-initial clusters (Ohala p. 39)");
    _constraint_add_seq(c0, "kr");
    _constraint_add_seq(c0, "kl");
    _constraint_add_seq(c0, "kʋ");
    _constraint_add_seq(c0, "kj");
    _constraint_add_seq(c0, "kɕ");
    _constraint_add_seq(c0, "kʰj");
    _constraint_add_seq(c0, "kʰʋ");
    _constraint_add_seq(c0, "ɡr");
    _constraint_add_seq(c0, "ɡl");
    _constraint_add_seq(c0, "ɡj");
    _constraint_add_seq(c0, "ɡʋ");
    _constraint_add_seq(c0, "ɡʱr");
