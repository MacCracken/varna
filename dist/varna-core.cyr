var _c_gematria_cyrillic = 0;
# Church Slavonic letter-numerals, inherited from Greek.
#
# The rule is POSITIONAL, not genealogical: values follow the Greek numeral
# SEQUENCE slot by slot, including the three slots held by numeral-only signs
# rather than letters (stigma 6, koppa 90, sampi 900). Slavic letters were
# dropped into some of those slots and the rest of the Slavic-only letters were
# skipped. It is tempting to state this as "only letters with a Greek ancestor
# carry a value", and that is false — its own table refutes it: ц descends from
# Hebrew tsade via Glagolitic, not from any Greek letter, and carries 900 in the
# sampi slot, while ч is Slavic and carries 90 in the koppa slot. Extending this
# table by the genealogical rule will get the extension wrong.
#
# Absent, and deliberately so — char_value returns the unmapped sentinel: б, ж,
# ш, щ, ъ, ь, ы, ѣ (yat), and the big and iotated yuses ѫ ѭ ѩ. Note the
# asymmetry that makes the yuses worth naming: little yus ѧ carries 900 in Early
# Cyrillic while big yus carries nothing. я is absent as the modern ia-ligature;
# for early material the glyph written for /ja/ is ѧ, which is 900.
#
# Scope. This is the standardised recension. In the earlier ustav period 90 is
# koppa ҁ and ч has no value (Unicode Technical Note #41, pp. 16, 64; the date of
# the change, often given as about 1300, was not verified). Some Western Cyrillic
# varieties instead give ч=60 and ҁ=90. Variant glyphs exist for two slots: 400
# is у or ѵ (izhitsa, the Old Church Slavonic form), and 800 is ѡ or ѿ (ot, the
# Synodal form). Only the conventional carrier is mapped here. Monograph uk ꙋ is
# NOT a 400 glyph: no source shows it used as a numeral (corrected at 2.6.0).
# Glagolitic is a different system, numbering in its own alphabetical order
# (buky=2, zhivete=7): see gematria_glagolitic.
#
# Variant glyphs and period alternatives stay OUT of this table on purpose. It is a
# canonical alphabet. Since 2.6.0 the alias layer (_numerals_alias) reads ѵ, ѿ and
# ҁ as their canonical letters before lookup, so char_value accepts them.
fn gematria_cyrillic() {
    if (_c_gematria_cyrillic != 0) { return _c_gematria_cyrillic; }
    var sys = _nsys_new("Cyrl", "Church Slavonic Numerals (standardised recension)", NumeralSystemKind.Alphabetic);
    _nsys_add(sys, "а", 1);
    _nsys_add(sys, "в", 2);
    _nsys_add(sys, "г", 3);
    _nsys_add(sys, "д", 4);
    _nsys_add(sys, "є", 5);
    _nsys_add(sys, "ѕ", 6);
    _nsys_add(sys, "з", 7);
    _nsys_add(sys, "и", 8);
    _nsys_add(sys, "ѳ", 9);
    _nsys_add(sys, "і", 10);
    _nsys_add(sys, "к", 20);
    _nsys_add(sys, "л", 30);
    _nsys_add(sys, "м", 40);
    _nsys_add(sys, "н", 50);
    _nsys_add(sys, "ѯ", 60);
    _nsys_add(sys, "о", 70);
    _nsys_add(sys, "п", 80);
    _nsys_add(sys, "ч", 90);
    _nsys_add(sys, "р", 100);
    _nsys_add(sys, "с", 200);
    _nsys_add(sys, "т", 300);
    _nsys_add(sys, "у", 400);
    _nsys_add(sys, "ф", 500);
    _nsys_add(sys, "х", 600);
    _nsys_add(sys, "ѱ", 700);
    _nsys_add(sys, "ѡ", 800);
    _nsys_add(sys, "ц", 900);
    _c_gematria_cyrillic = sys;
    return _c_gematria_cyrillic;
}

var _c_gematria_glagolitic = 0;
# Glagolitic numerals (2.6.0), the letters' values in Glagolitic's own alphabetical
# order, which differs from Cyrillic's: buky is 2 and zhivete 7, where Cyrillic gives
# both no value. Every value below is in each of Leskien (1922, pp. 4-5), Vajs (1932,
# p. 18), Schenker (1995, p. 182), Cubberley in Daniels & Bright (1996, Table 27.1)
# and Everson & Cleminson (WG2 N2610R, 2003, p. 5). Code points are the small
# letters, U+2C30-U+2C4D, checked against UnicodeData.txt.
#
# Initial izhe is a second form of izhe, both 10, so it is an allograph and folds to
# izhe's position. The ordinal is the position in this numeral table, as for the
# Cyrillic one, not in the full alphabet: valueless letters are not in it.
#
# Left out on purpose, because the sources disagree or only a late one has them: pe
# (no value; some scholars put it at 800 before shta took the slot, Schenker p. 172);
# yat as 800 (one 1391 breviary, per Vajs n. 19); and the thousands above 1000, sha
# 2000, yeru 3000, yu 5000 (Everson & Cleminson, "fifteenth-century evidence"; Vajs
# calls the higher cases isolated). The other letters, the yers, the yuses, fita and
# izhitsa, carry no value in any of the sources.
fn gematria_glagolitic() {
    if (_c_gematria_glagolitic != 0) { return _c_gematria_glagolitic; }
    var sys = _nsys_new("Glag", "Glagolitic Numerals", NumeralSystemKind.Alphabetic);
    _nsys_add(sys, "ⰰ", 1);   # U+2C30 azu
    _nsys_add(sys, "ⰱ", 2);   # U+2C31 buky
    _nsys_add(sys, "ⰲ", 3);   # U+2C32 vede
    _nsys_add(sys, "ⰳ", 4);   # U+2C33 glagoli
    _nsys_add(sys, "ⰴ", 5);   # U+2C34 dobro
    _nsys_add(sys, "ⰵ", 6);   # U+2C35 yestu
    _nsys_add(sys, "ⰶ", 7);   # U+2C36 zhivete
    _nsys_add(sys, "ⰷ", 8);   # U+2C37 dzelo
    _nsys_add(sys, "ⰸ", 9);   # U+2C38 zemlja
    _nsys_add(sys, "ⰹ", 10);   # U+2C39 izhe
    _nsys_add_variant(sys, "ⰺ", 10, "ⰹ");   # U+2C3A initial izhe, a form of izhe
    _nsys_add(sys, "ⰻ", 20);   # U+2C3B i
    _nsys_add(sys, "ⰼ", 30);   # U+2C3C djervi
    _nsys_add(sys, "ⰽ", 40);   # U+2C3D kako
    _nsys_add(sys, "ⰾ", 50);   # U+2C3E ljudije
    _nsys_add(sys, "ⰿ", 60);   # U+2C3F myslite
    _nsys_add(sys, "ⱀ", 70);   # U+2C40 nashi
    _nsys_add(sys, "ⱁ", 80);   # U+2C41 onu
    _nsys_add(sys, "ⱂ", 90);   # U+2C42 pokoji
    _nsys_add(sys, "ⱃ", 100);   # U+2C43 ritsi
    _nsys_add(sys, "ⱄ", 200);   # U+2C44 slovo
    _nsys_add(sys, "ⱅ", 300);   # U+2C45 tvrido
    _nsys_add(sys, "ⱆ", 400);   # U+2C46 uku
    _nsys_add(sys, "ⱇ", 500);   # U+2C47 fritu
    _nsys_add(sys, "ⱈ", 600);   # U+2C48 heru
    _nsys_add(sys, "ⱉ", 700);   # U+2C49 otu
    _nsys_add(sys, "ⱋ", 800);   # U+2C4B shta
    _nsys_add(sys, "ⱌ", 900);   # U+2C4C tsi
    _nsys_add(sys, "ⱍ", 1000);   # U+2C4D chrivi
    _c_gematria_glagolitic = sys;
    return _c_gematria_glagolitic;
}

# --- transliteration.cyr ---

# src/transliteration.cyr — bidirectional script transliteration tables.
# Ported from v1.x Rust src/script/transliteration.rs (data transpiled byte-exact).
#
# TransliterationTable (64B): [0]=scheme [8]=source_script [16]=target_script
#                             [24]=forward(vec of pairs) [32]=max_target(cache|0)
#                             [40]=inherent vowel (cstr|0, 2.6.0)
#                             [48]=source index (map|0) [56]=pairs it covers (2.6.0)
# pair (24B): [0]=src(cstr) [8]=tgt(cstr) [16]=kind (TranslitKind, 2.6.0)
# Requires src/util.cyr (_utf8_step). transliterate_char/reverse-lookup return 0
# when unmapped; transliterate() returns a fresh cstring.
#
# The inherent vowel (2.6.0). In an abugida such as Devanagari a consonant letter
# carries a vowel, a in Sanskrit, which a following vowel sign replaces and a virama
# removes: क is ka, कि is ki, क् is k. v1.x mapped क to "ka" and the signs to their
# vowels, so नमस्ते came out "namasatae". A table can now name its inherent vowel and
# mark each pair a consonant or a dependent sign: a consonant's target is the bare
# consonant ("k"), and translit_apply writes the inherent vowel after it unless a
# dependent sign comes next. A table without one (every alphabet) is unchanged.

# What a pair is to the inherent-vowel rule. Tagged, so variants are additive.
#derive(Serialize)
enum TranslitKind {
    TR_PLAIN = 0;
    TR_CONSONANT = 1;
    TR_DEPENDENT = 2;
}

fn _tt_new(scheme, src_script, tgt_script) {
    var tt = alloc(64);
    store64(tt, scheme);
    store64(tt + 8, src_script);
    store64(tt + 16, tgt_script);
    store64(tt + 24, vec_new());
    store64(tt + 32, 0);
    store64(tt + 40, 0);
    store64(tt + 48, 0);
    store64(tt + 56, 0);
    return tt;
}

fn _tt_add_kind(tt, src, tgt, kind) {
    var pair = alloc(24);
    store64(pair, src);
    store64(pair + 8, tgt);
    store64(pair + 16, kind);
    vec_push(load64(tt + 24), pair);
    store64(tt + 32, 0);
    store64(tt + 48, 0);
    return tt;
}

fn _tt_add(tt, src, tgt) { return _tt_add_kind(tt, src, tgt, TranslitKind.TR_PLAIN); }
fn _tt_consonant(tt, src, tgt) { return _tt_add_kind(tt, src, tgt, TranslitKind.TR_CONSONANT); }
fn _tt_dependent(tt, src, tgt) { return _tt_add_kind(tt, src, tgt, TranslitKind.TR_DEPENDENT); }

fn _tt_set_inherent(tt, vowel) {
    store64(tt + 40, vowel);
    store64(tt + 32, 0);
    return tt;
}

fn translit_scheme(tt) { return load64(tt); }
fn translit_source_script(tt) { return load64(tt + 8); }
fn translit_target_script(tt) { return load64(tt + 16); }
fn translit_forward(tt) { return load64(tt + 24); }
fn translit_pair_source(pair) { return load64(pair); }
fn translit_pair_target(pair) { return load64(pair + 8); }
# TranslitKind of a pair: TR_PLAIN unless the table has an inherent vowel.
fn translit_pair_kind(pair) { return load64(pair + 16); }
# The table's inherent vowel, or 0 for a table without one.
fn translit_inherent_vowel(tt) { return load64(tt + 40); }

# Transliterate a single source grapheme — target cstr, or 0 if unmapped. This is
# the pair's own target, so a consonant of an abugida table reads bare ("k" for क):
# the inherent vowel is translit_apply's to add.
fn translit_char(tt, ch) {
    return _translit_lookup(tt, ch, strlen(ch));
}

# Longest target string in the table, used to size the output buffer in
# `translit_apply`. Computed on demand and memoised in the table.
fn _translit_max_target(tt) {
    var cached = load64(tt + 32);
    if (cached != 0) { return cached; }
    var fwd = load64(tt + 24);
    var n = vec_len(fwd);
    var max = 1;
    var i = 0;
    while (i < n) {
        var tlen = strlen(load64(vec_get(fwd, i) + 8));
        if (tlen > max) { max = tlen; }
        i = i + 1;
    }
    store64(tt + 32, max);
    return max;
}

# Look up the `len` bytes at `ch` in the forward table — target cstr, or 0.
#
# Compares in place against each source literal instead of copying the candidate
# into a NUL-terminated scratch buffer first: `translit_apply` probes up to four
# candidates per input grapheme, and allocating each one leaked a buffer per
# probe (the bump allocator never frees).
fn _translit_lookup(tt, ch, len) {
    var pair = _translit_find(tt, ch, len);
    if (pair == 0) { return 0; }
    return load64(pair + 8);
}

var _translit_key = 0;

# The pair whose source is the `len` bytes at `ch`, or 0. The first such pair wins.
#
# Through the table's source index (2.6.0): the scan this replaced compared every
# pair, four probes per input character, which a 369-row Greek table made 7.6x
# slower than v1.x's 49 rows. The probe is NUL-terminated in one reused buffer, so a
# lookup allocates nothing. A source longer than any probe (16 bytes, four
# codepoints) can only come from translit_char, and is scanned for.
fn _translit_find(tt, ch, len) {
    if (len > 16) { return _translit_scan(tt, ch, len); }
    if (_translit_key == 0) { _translit_key = alloc(24); }
    memcpy(_translit_key, ch, len);
    store8(_translit_key + len, 0);
    return map_get(_translit_index(tt), _translit_key);
}

# The source index: each source to the first pair with it. Built on first use, and
# rebuilt when pairs were added since (_tt_add drops it; a pair pushed straight onto
# translit_forward is caught by the count). Null pairs are skipped.
fn _translit_index(tt) {
    var fwd = load64(tt + 24);
    var n = vec_len(fwd);
    var ix = load64(tt + 48);
    if (ix != 0 && load64(tt + 56) == n) { return ix; }
    ix = map_new();
    var i = 0;
    while (i < n) {
        var pair = vec_get(fwd, i);
        if (pair != 0) {
            if (map_has(ix, load64(pair)) == 0) { map_set(ix, load64(pair), pair); }
        }
        i = i + 1;
    }
    store64(tt + 48, ix);
    store64(tt + 56, n);
    return ix;
}

# The linear form of _translit_find, for a source too long to index-probe.
fn _translit_scan(tt, ch, len) {
    var fwd = load64(tt + 24);
    var n = vec_len(fwd);
    var i = 0;
    while (i < n) {
        var pair = vec_get(fwd, i);
        if (pair != 0) {
            var src = load64(pair);
            if (strlen(src) == len) {
                if (memeq(src, ch, len) == 1) { return pair; }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Append `n` bytes at `src` to `out` at `olen`, clamped so `out` keeps room for its
# NUL. Returns the new length.
fn _translit_emit(out, olen, cap, src, n) {
    if (olen + n + 1 > cap) { n = cap - olen - 1; }
    if (n <= 0) { return olen; }
    memcpy(out + olen, src, n);
    return olen + n;
}

# Reverse map (target -> source) as a hashmap; last source wins on collision.
fn translit_reverse_map(tt) {
    var fwd = load64(tt + 24);
    var n = vec_len(fwd);
    var rev = map_new();
    var i = 0;
    while (i < n) {
        var pair = vec_get(fwd, i);
        map_set(rev, load64(pair + 8), load64(pair));
        i = i + 1;
    }
    return rev;
}

# Transliterate a string by greedily matching the longest source sequence
# (up to 4 codepoints). Unmapped graphemes pass through unchanged.
#
# With an inherent vowel: after a consonant pair the vowel is pending. A dependent
# pair next (a vowel sign or virama) drops it; anything else, or the end of the
# input, writes it first. So क is "ka", कि is "ki", क् is "k", and कं is "kaṃ".
#
# Output sizing: one input byte can expand to at most `_translit_max_target`
# bytes, plus a pending inherent vowel written before it, since the shortest match
# consumes one codepoint (>= 1 byte). The old fixed `inlen * 4` held only because
# both bundled tables happen to shrink; a caller-built table mapping a short source
# to a long target overflowed it.
#
# Every write is still bounds-checked against `cap` and the walk is clamped to
# `inlen`, so neither a table with an unexpected expansion ratio nor malformed
# UTF-8 at the tail can run past the buffer.
fn translit_apply(tt, input) {
    var inlen = strlen(input);
    var inh = load64(tt + 40);
    var inhlen = 0;
    if (inh != 0) { inhlen = strlen(inh); }
    var cap = inlen * (_translit_max_target(tt) + inhlen) + inhlen + 16;
    var out = alloc(cap);
    var olen = 0;
    var pending = 0;
    var p = 0;
    while (p < inlen) {
        var l1 = _utf8_step(input, p, inlen);
        var b2 = p + l1;
        var l2 = 0;
        if (b2 < inlen) { l2 = _utf8_step(input, b2, inlen); }
        var b3 = b2 + l2;
        var l3 = 0;
        if (b3 < inlen) { l3 = _utf8_step(input, b3, inlen); }
        var b4 = b3 + l3;
        var l4 = 0;
        if (b4 < inlen) { l4 = _utf8_step(input, b4, inlen); }
        var e1 = l1;
        var e2 = e1 + l2;
        var e3 = e2 + l3;
        var e4 = e3 + l4;
        var matched = 0;
        var k = 4;
        while (k >= 1 && matched == 0) {
            var elen = e1;
            if (k == 2) { elen = e2; }
            if (k == 3) { elen = e3; }
            if (k == 4) { elen = e4; }
            var pair = _translit_find(tt, input + p, elen);
            if (pair != 0) {
                var kind = load64(pair + 16);
                if (pending == 1 && kind != TranslitKind.TR_DEPENDENT) {
                    olen = _translit_emit(out, olen, cap, inh, inhlen);
                }
                pending = 0;
                var rep = load64(pair + 8);
                olen = _translit_emit(out, olen, cap, rep, strlen(rep));
                if (kind == TranslitKind.TR_CONSONANT && inh != 0) { pending = 1; }
                p = p + elen;
                matched = 1;
            }
            k = k - 1;
        }
        if (matched == 0) {
            if (pending == 1) { olen = _translit_emit(out, olen, cap, inh, inhlen); }
            pending = 0;
            olen = _translit_emit(out, olen, cap, input + p, l1);
            p = p + l1;
        }
    }
    if (pending == 1) { olen = _translit_emit(out, olen, cap, inh, inhlen); }
    store8(out + olen, 0);
    return out;
}

# --- Pre-built tables ----------------------------------------------

# Devanagari → IAST. Since 2.6.0 the 33 consonants are bare ("k") with inherent
# vowel a, and the 10 vowel signs and the virama are dependent: v1.x wrote every
# consonant as "ka", so a sign or virama could not remove the a (नमस्ते gave
# "namasatae", now "namaste"; कि gave "kai", now "ki").
var _c_translit_devanagari_iast = 0;
fn translit_devanagari_iast() {
    if (_c_translit_devanagari_iast != 0) { return _c_translit_devanagari_iast; }
    var tt = _tt_new("IAST", "Deva", "Latn");
    _tt_set_inherent(tt, "a");
    _tt_add(tt, "अ", "a");
    _tt_add(tt, "आ", "ā");
    _tt_add(tt, "इ", "i");
    _tt_add(tt, "ई", "ī");
    _tt_add(tt, "उ", "u");
    _tt_add(tt, "ऊ", "ū");
    _tt_add(tt, "ऋ", "ṛ");
    _tt_add(tt, "ॠ", "ṝ");
    _tt_add(tt, "ऌ", "ḷ");
    _tt_add(tt, "ॡ", "ḹ");
    _tt_add(tt, "ए", "e");
    _tt_add(tt, "ऐ", "ai");
    _tt_add(tt, "ओ", "o");
    _tt_add(tt, "औ", "au");
    _tt_dependent(tt, "ा", "ā");
    _tt_dependent(tt, "ि", "i");
    _tt_dependent(tt, "ी", "ī");
    _tt_dependent(tt, "ु", "u");
    _tt_dependent(tt, "ू", "ū");
    _tt_dependent(tt, "ृ", "ṛ");
    _tt_dependent(tt, "े", "e");
    _tt_dependent(tt, "ै", "ai");
    _tt_dependent(tt, "ो", "o");
    _tt_dependent(tt, "ौ", "au");
    _tt_consonant(tt, "क", "k");
    _tt_consonant(tt, "ख", "kh");
    _tt_consonant(tt, "ग", "g");
    _tt_consonant(tt, "घ", "gh");
    _tt_consonant(tt, "ङ", "ṅ");
    _tt_consonant(tt, "च", "c");
    _tt_consonant(tt, "छ", "ch");
    _tt_consonant(tt, "ज", "j");
    _tt_consonant(tt, "झ", "jh");
    _tt_consonant(tt, "ञ", "ñ");
    _tt_consonant(tt, "ट", "ṭ");
    _tt_consonant(tt, "ठ", "ṭh");
    _tt_consonant(tt, "ड", "ḍ");
    _tt_consonant(tt, "ढ", "ḍh");
    _tt_consonant(tt, "ण", "ṇ");
    _tt_consonant(tt, "त", "t");
    _tt_consonant(tt, "थ", "th");
    _tt_consonant(tt, "द", "d");
    _tt_consonant(tt, "ध", "dh");
    _tt_consonant(tt, "न", "n");
    _tt_consonant(tt, "प", "p");
    _tt_consonant(tt, "फ", "ph");
    _tt_consonant(tt, "ब", "b");
    _tt_consonant(tt, "भ", "bh");
    _tt_consonant(tt, "म", "m");
    _tt_consonant(tt, "य", "y");
    _tt_consonant(tt, "र", "r");
    _tt_consonant(tt, "ल", "l");
    _tt_consonant(tt, "व", "v");
    _tt_consonant(tt, "श", "ś");
    _tt_consonant(tt, "ष", "ṣ");
    _tt_consonant(tt, "स", "s");
    _tt_consonant(tt, "ह", "h");
    _tt_add(tt, "ं", "ṃ");
    _tt_add(tt, "ः", "ḥ");
    _tt_dependent(tt, "्", "");
    _tt_add(tt, "ॐ", "oṃ");
    _c_translit_devanagari_iast = tt;
    return _c_translit_devanagari_iast;
}

# Greek → Beta Code, in v1.x's lowercase form (the TLG keys capitals A-Z; Perseus and
# v1.x use lowercase). The 49 letters are v1.x's. Since 2.6.0 the accented letters
# too, which passed through before (λόγος gave "lόgos", now "lo/gos"):
#   - the codes for the combining marks: ) ( / \ = + | (TLG Beta Code Manual, Dec 2023,
#     p. 6) and %26 macron, %27 breve (pp. 27-28);
#   - their order, from the TLG's encoding page (tlg.uci.edu/encoding.php): "On
#     lowercase letters ... (1) letter, (2) breathing, (3) accent, (4) iota subscript.
#     E.g. W(=|" and "On uppercase letters ... (1) asterisk, (2) breathing, (3) accent,
#     (4) letter, (5) iota subscript. E.g. *(=W|";
#   - each precomposed letter's marks, from its canonical decomposition in
#     UnicodeData.txt 18.0.0.
# DERIVED, NOT STATED: the TLG gives the diaeresis, macron and breve no place, which
# 16 letters need. By analogy (the project owner's decision) the mark goes before the
# accent, in Unicode's decomposition order, and before a capital's letter, as a
# capital's breathing and accent do: ΐ ΰ ῒ ΐ ῗ ῢ ΰ ῧ are "i+/" and the like, and
# Ϊ Ϋ Ᾰ Ᾱ Ῐ Ῑ Ῠ Ῡ are "*+i", "*%27a" and the like.
# Decomposed small letters are written mark by mark in the order typed; decomposed
# capitals are listed, so their marks also come before the letter.
var _c_translit_greek_beta_code = 0;
fn translit_greek_beta_code() {
    if (_c_translit_greek_beta_code != 0) { return _c_translit_greek_beta_code; }
    var tt = _tt_new("Beta Code", "Grek", "Latn");
    _tt_add(tt, "α", "a");
    _tt_add(tt, "β", "b");
    _tt_add(tt, "γ", "g");
    _tt_add(tt, "δ", "d");
    _tt_add(tt, "ε", "e");
    _tt_add(tt, "ζ", "z");
    _tt_add(tt, "η", "h");
    _tt_add(tt, "θ", "q");
    _tt_add(tt, "ι", "i");
    _tt_add(tt, "κ", "k");
    _tt_add(tt, "λ", "l");
    _tt_add(tt, "μ", "m");
    _tt_add(tt, "ν", "n");
    _tt_add(tt, "ξ", "c");
    _tt_add(tt, "ο", "o");
    _tt_add(tt, "π", "p");
    _tt_add(tt, "ρ", "r");
    _tt_add(tt, "σ", "s");
    _tt_add(tt, "ς", "s");
    _tt_add(tt, "τ", "t");
    _tt_add(tt, "υ", "u");
    _tt_add(tt, "φ", "f");
    _tt_add(tt, "χ", "x");
    _tt_add(tt, "ψ", "y");
    _tt_add(tt, "ω", "w");
    _tt_add(tt, "Α", "*a");
    _tt_add(tt, "Β", "*b");
    _tt_add(tt, "Γ", "*g");
    _tt_add(tt, "Δ", "*d");
    _tt_add(tt, "Ε", "*e");
    _tt_add(tt, "Ζ", "*z");
    _tt_add(tt, "Η", "*h");
    _tt_add(tt, "Θ", "*q");
    _tt_add(tt, "Ι", "*i");
    _tt_add(tt, "Κ", "*k");
    _tt_add(tt, "Λ", "*l");
    _tt_add(tt, "Μ", "*m");
    _tt_add(tt, "Ν", "*n");
    _tt_add(tt, "Ξ", "*c");
    _tt_add(tt, "Ο", "*o");
    _tt_add(tt, "Π", "*p");
    _tt_add(tt, "Ρ", "*r");
    _tt_add(tt, "Σ", "*s");
    _tt_add(tt, "Τ", "*t");
    _tt_add(tt, "Υ", "*u");
    _tt_add(tt, "Φ", "*f");
    _tt_add(tt, "Χ", "*x");
    _tt_add(tt, "Ψ", "*y");
    _tt_add(tt, "Ω", "*w");
    # The combining marks (TLG Beta Code Manual pp. 6, 27-28), for decomposed text.
    _tt_add(tt, "̓", ")");
