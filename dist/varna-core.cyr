    _tt_add(tt, "έ", "e/");
    _tt_add(tt, "ή", "h/");
    _tt_add(tt, "ί", "i/");
    _tt_add(tt, "ό", "o/");
    _tt_add(tt, "ύ", "u/");
    _tt_add(tt, "ώ", "w/");
    _tt_add(tt, "Ά", "*/a");
    _tt_add(tt, "Έ", "*/e");
    _tt_add(tt, "Ή", "*/h");
