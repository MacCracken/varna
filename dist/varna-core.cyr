    # Vowel letters (table, p. 2): ֶי ַי ֵי ִי, and וֹ וּ.
    _tt_add(tt, "ֶי", "e");
    _tt_add(tt, "ַי", "ai");
    _tt_add(tt, "ֵי", "e");
