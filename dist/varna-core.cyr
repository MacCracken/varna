# --- Gematria and letter-value systems (2.4.0) ---------------------
#
# The alphabets below are `NumeralSystem` records like the numeral systems above,
# holding each letter's STANDARD value in alphabet order. The other methods are
# derived rather than stored, for the reason src/features.cyr gives: two
# hand-maintained encodings of one fact drift apart.
#
#   Standard  the stored value (Hebrew qof = 100)
#   Ordinal   position in the alphabet, 1-based — the index, not a second table
#   Reduced   digital root of the standard value (mispar katan): 100 -> 1, 300 -> 3
#
# The roadmap listed a fourth, "Additive". That is not a per-character method: it
# describes how a system COMBINES values across a string, which is already
# `NumeralSystemKind` (Decimal / Alphabetic / Other) on each record, and is what
# `numerals_string_value` implements. Adding it here would have been a fourth enum
# value that no lookup could answer differently from Standard.
#
# NUM_GADOL (2.6.0) is mispar gadol, a Hebrew method: the five final forms count as
# the hundreds after tav, ך 500, ם 600, ן 700, ף 800, ץ 900, and the other 22 letters
# keep their standard values (Jewish Encyclopedia, "Gematria", no. 11: "the final
# letters count as hundreds"; Avodat Yisrael, Balak 2, for ך 500 and ם 600, with the
# atbash pairs fixing ף 800 and ץ 900). The order is by value, NOT the order of the
# mnemonic מנצפ״ך. It is the first method that needs data the standard table does not
# carry, so the five values live in _gadol_final. Mispar gadol exists only for
# Hebrew, so for any other script it reports unmapped rather than inventing a value.
enum NumericSystem {
    NUM_STANDARD = 0;   # the letter's own numeral value (Hebrew ת = 400)
    NUM_ORDINAL = 1;    # its position in the alphabet (Hebrew ת = 22)
    NUM_REDUCED = 2;    # the standard value's digital root (Hebrew ת = 4)
    NUM_GADOL = 3;      # mispar gadol, Hebrew only: finals 500-900 (Hebrew ץ = 900)
}

# Digital root: repeatedly sum decimal digits until a single digit remains. For the
# 1/10/100 series every gematria alphabet uses, this is just the leading digit.
fn _digital_root(v) {
    if (v <= 0) { return v; }
    var n = v;
    while (n > 9) {
        var sum = 0;
        while (n > 0) {
            sum = sum + n - (n / 10) * 10;
            n = n / 10;
        }
        n = sum;
    }
    return n;
}

# Letter-value alphabet for an ISO 15924 script code, or 0 if none is defined.
fn gematria_by_script(code) {
    if (streq(code, "Hebr") == 1) { return gematria_hebrew(); }
    if (streq(code, "Arab") == 1) { return gematria_arabic_abjad(); }
    if (streq(code, "Latn") == 1) { return gematria_latin(); }
    if (streq(code, "Cyrl") == 1) { return gematria_cyrillic(); }
    if (streq(code, "Grek") == 1) { return numerals_greek_isopsephy(); }
    if (streq(code, "Glag") == 1) { return gematria_glagolitic(); }
    return 0;
}

# All script codes with a letter-value alphabet — vec of cstrings.
var _c_gematria_all_scripts = 0;
fn gematria_all_scripts() {
    if (_c_gematria_all_scripts != 0) { return _c_gematria_all_scripts; }
    var c = vec_new();
    vec_push(c, "Hebr");
    vec_push(c, "Arab");
    vec_push(c, "Latn");
    vec_push(c, "Cyrl");
    vec_push(c, "Grek");
    vec_push(c, "Glag");
    _c_gematria_all_scripts = c;
    return _c_gematria_all_scripts;
}

# Value of one character under one method, or (0-1) when the character is not in
# the alphabet or the script has no letter-value system.
#
# Ordinal is the character's position in the alphabet, so a letter that shares a
# standard value with another (the Hebrew final forms) still gets its own ordinal.
# Alphabet position of the mapping at index `i`, or (0-1) if it has none.
#
# Counts only ROLE_LETTER entries, so an allograph or a numeral sign sitting in
# the middle of the table does not push every letter after it up by one. An
# allograph folds to its base letter's position: Hebrew final mem scores 13 like
# mem, which is what classical mispar siduri does, and Greek final sigma scores
# 18 like sigma. A numeral sign has no position at all and reports unmapped.
fn _ordinal_at(ms, i) {
    var m = vec_get(ms, i);
    var role = load64(m + 24);
    if (role == LetterRole.ROLE_NUMERAL_SIGN) { return 0 - 1; }

    var target = load64(m);
    var tlen = load64(m + 8);
    if (role == LetterRole.ROLE_ALLOGRAPH) {
        target = load64(m + 32);
        # No constructor makes an allograph without a base, but 0 is the
        # not-found sentinel in that slot and strlen would dereference it.
        if (target == 0) { return 0 - 1; }
        tlen = strlen(target);
    }
    var pos = 0;
    var k = 0;
    var n = vec_len(ms);
    while (k < n) {
        var e = vec_get(ms, k);
        if (load64(e + 24) == LetterRole.ROLE_LETTER) {
            pos = pos + 1;
            if (load64(e + 8) == tlen) {
                if (memeq(load64(e), target, tlen) == 1) { return pos; }
            }
        }
        k = k + 1;
    }
    return 0 - 1;
}

# Value of the `len` bytes at `ch` under one method, or (0-1) if unmapped.
#
# Compares in place, so `string_value_in` can walk a string without copying each
# codepoint into a NUL-terminated buffer first — that allocated once per
# character, and the bump allocator never frees. `_numerals_value_of_bytes`
# exists for the same reason on the older API; keep the two in step.
fn _char_value_bytes(ms, system, ch, len) {
    var n = vec_len(ms);
    var i = 0;
    while (i < n) {
        var m = vec_get(ms, i);
        if (load64(m + 8) == len) {
            if (memeq(load64(m), ch, len) == 1) {
                if (system == NumericSystem.NUM_ORDINAL) { return _ordinal_at(ms, i); }
                if (system == NumericSystem.NUM_REDUCED) { return _digital_root(load64(m + 16)); }
                return load64(m + 16);
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Mispar gadol's value for a Hebrew final form, or 0 when `ch` is not one.
fn _gadol_final(ch, len) {
    if (len != 2) { return 0; }
    if (memeq(ch, "ך", 2) == 1) { return 500; }
    if (memeq(ch, "ם", 2) == 1) { return 600; }
    if (memeq(ch, "ן", 2) == 1) { return 700; }
    if (memeq(ch, "ף", 2) == 1) { return 800; }
    if (memeq(ch, "ץ", 2) == 1) { return 900; }
    return 0;
}

# --- Variant glyphs (2.6.0) -------------------------------------------
# A decode-side alias layer: a variant glyph is read as its canonical letter, so the
# canonical tables stay one entry per slot (see architecture note 001, which is why
# these must never go into a table). Church Slavonic only, verified per glyph:
#   ѵ izhitsa (U+0475) → у, 400. The 400 of Old Church Slavonic (Leskien 1922 p. 5;
#       Schenker 1995 p. 182). Synodal Church Slavonic writes 400 with у instead
#       (Unicode Technical Note #41, Table 15).
#   ѿ ot (U+047F), the ligature of ѡ and т → ѡ, 800, the usual form in Synodal
#       printing (UTN #41, pp. 16, 74).
#   ҁ koppa (U+0481) → ч, 90, the earlier ustav period's 90 before ч took the slot
#       (UTN #41, pp. 16, 64).
# Not aliased: monograph uk ꙋ (U+A64B). It is a glyph of оу, but no source shows it
# used as a numeral (Cleminson, L2/06-359, p. 3; UTN #41 omits it).
# An alias reads its canonical letter under every method, ordinal included, because
# it fills that letter's slot. Only the lowercase forms are aliased, as the tables
# map lowercase only.
fn _numerals_alias(script_code, ch, len) {
    if (len != 2) { return 0; }
    if (streq(script_code, "Cyrl") == 0) { return 0; }
    if (memeq(ch, "ѵ", 2) == 1) { return "у"; }
    if (memeq(ch, "ѿ", 2) == 1) { return "ѡ"; }
    if (memeq(ch, "ҁ", 2) == 1) { return "ч"; }
    return 0;
}

# The value of the `len` bytes at `ch` in a script's table under one method, with
# mispar gadol and the alias layer applied. Allocates nothing.
fn _lookup_value(script_code, ms, system, ch, len) {
    if (system == NumericSystem.NUM_GADOL) {
        if (streq(script_code, "Hebr") == 0) { return 0 - 1; }
        var g = _gadol_final(ch, len);
        if (g > 0) { return g; }
        return _char_value_bytes(ms, NumericSystem.NUM_STANDARD, ch, len);
    }
    var v = _char_value_bytes(ms, system, ch, len);
    if (v >= 0) { return v; }
    var a = _numerals_alias(script_code, ch, len);
    if (a == 0) { return 0 - 1; }
    return _char_value_bytes(ms, system, a, strlen(a));
}

fn char_value(script_code, system, ch) {
    var sys = gematria_by_script(script_code);
    if (sys == 0) { return 0 - 1; }
    return _lookup_value(script_code, numerals_mappings(sys), system, ch, strlen(ch));
}

# Sum of a string's character values under one method. (0-1) if any character is
# unmapped, matching `numerals_string_value`.
fn string_value_in(script_code, system, s) {
    var sys = gematria_by_script(script_code);
    if (sys == 0) { return 0 - 1; }
    var ms = numerals_mappings(sys);
    var total = 0;
    var p = 0;
    var n = strlen(s);
    while (p < n) {
        var len = _utf8_step(s, p, n);
        var v = _lookup_value(script_code, ms, system, s + p, len);
        if (v < 0) { return 0 - 1; }
        total = total + v;
        p = p + len;
    }
    return total;
}

# Full (character, value) table for a script under one method — a vec of 16-byte
# pairs [0]=char [8]=value, in table order. Returns an empty vec for a script with
# no letter-value system.
#
# Under NUM_ORDINAL a numeral sign's slot holds the unmapped sentinel (0-1), since
# it carries a value but no alphabet position; the pairs are not all positive.
#
# CACHED since 2.5.4, like every other table in this file. There are only 24
# possible results (6 scripts x 4 methods, since 2.6.0). Until 2.5.4 each call built a fresh
# ~856 B table, and the bump allocator never frees, so a caller in a loop grew the
# heap without bound. Now the first call for a (script, method) builds its table
# and every later call returns the SAME vec and the same pair records, allocating
# nothing.
#
# That sharing is the one semantic change: the result is read-only. A caller that
# writes into a pair, or pushes onto the vec, changes it for every later caller.
# Copy it first if you need to edit it. Every unknown script shares one empty vec,
# so the same holds there.
#
# A `system` other than NUM_ORDINAL, NUM_REDUCED or NUM_GADOL reads as NUM_STANDARD,
# as it always has here and in char_value, and shares the standard table. NUM_GADOL
# on a script other than Hebrew has no table, and returns the shared empty vec.
# The tables are canonical: the alias layer's variant glyphs are not in them.
var _c_alpha_tables = 0;   # 24 slots, [script index * 4 + method], 0 until built
var _c_alpha_empty = 0;    # the one empty table every unknown script gets

fn script_alphabet_values(script_code, system) {
    var scripts = gematria_all_scripts();
    var si = 0 - 1;
    var k = 0;
    # Stop at the match: every script past it is one more string compare per call.
    while (k < vec_len(scripts)) {
        if (streq(vec_get(scripts, k), script_code) == 1) {
            si = k;
            break;
        }
        k = k + 1;
    }
    if (si < 0) {
        if (_c_alpha_empty == 0) { _c_alpha_empty = vec_new(); }
        return _c_alpha_empty;
    }
    var mi = 0;
    if (system == NumericSystem.NUM_ORDINAL) { mi = 1; }
    elif (system == NumericSystem.NUM_REDUCED) { mi = 2; }
    elif (system == NumericSystem.NUM_GADOL) { mi = 3; }
    if (mi == 3) {
        if (streq(script_code, "Hebr") == 0) {
            if (_c_alpha_empty == 0) { _c_alpha_empty = vec_new(); }
            return _c_alpha_empty;
        }
    }
    if (_c_alpha_tables == 0) {
        var slots = vec_len(scripts) * 4;
        _c_alpha_tables = alloc(slots * 8);
        var z = 0;
        while (z < slots) {
            store64(_c_alpha_tables + z * 8, 0);
            z = z + 1;
        }
    }
    var slot = _c_alpha_tables + (si * 4 + mi) * 8;
    if (load64(slot) == 0) {
        store64(slot, _alphabet_table_build(gematria_by_script(script_code), mi));
    }
    return load64(slot);
}

# Build one (script, method) table. `method` is 0 standard, 1 ordinal, 2 reduced,
# 3 gadol (Hebrew only; the caller has already refused other scripts).
fn _alphabet_table_build(sys, method) {
    var system = NumericSystem.NUM_STANDARD;
    if (method == 1) { system = NumericSystem.NUM_ORDINAL; }
    if (method == 2) { system = NumericSystem.NUM_REDUCED; }
    if (method == 3) { system = NumericSystem.NUM_GADOL; }
    var out = vec_new();
    var ms = numerals_mappings(sys);
    var n = vec_len(ms);
    var pos = 0;
    var i = 0;
    while (i < n) {
        var m = vec_get(ms, i);
        var pair = alloc(16);
        store64(pair, load64(m));
        if (load64(m + 24) == LetterRole.ROLE_LETTER) { pos = pos + 1; }
        # A letter's position is just the running count; only an allograph or a
        # sign needs _ordinal_at's rescan, and there are at most a handful.
        if (system == NumericSystem.NUM_ORDINAL) {
            if (load64(m + 24) == LetterRole.ROLE_LETTER) { store64(pair + 8, pos); }
            else { store64(pair + 8, _ordinal_at(ms, i)); }
        }
        elif (system == NumericSystem.NUM_REDUCED) { store64(pair + 8, _digital_root(load64(m + 16))); }
        elif (system == NumericSystem.NUM_GADOL) {
            var g = _gadol_final(load64(m), load64(m + 8));
            if (g > 0) { store64(pair + 8, g); }
            else { store64(pair + 8, load64(m + 16)); }
        }
        else { store64(pair + 8, load64(m + 16)); }
        vec_push(out, pair);
        i = i + 1;
    }
    return out;
}

var _c_gematria_hebrew = 0;
# Standard mispar hechrachi: alef=1..tet=9, yod=10..tsadi=90, qof=100..tav=400.
# The five final forms are appended after the 22 base letters and take the SAME
# standard value as their base, which is ordinary gematria practice. (Mispar
# gadol instead gives them 500-900; that is a different method, not encoded.)
# They are allographs, not letters: the alphabet has 22 positions, and a final
# form is where a letter stands in a word rather than a 23rd letter. So under
# NUM_ORDINAL each folds to its base — final mem is 13, like mem — which is what
# classical mispar siduri does.
fn gematria_hebrew() {
    if (_c_gematria_hebrew != 0) { return _c_gematria_hebrew; }
    var sys = _nsys_new("Hebr", "Hebrew Gematria", NumeralSystemKind.Alphabetic);
    _nsys_add(sys, "א", 1);
    _nsys_add(sys, "ב", 2);
    _nsys_add(sys, "ג", 3);
    _nsys_add(sys, "ד", 4);
    _nsys_add(sys, "ה", 5);
    _nsys_add(sys, "ו", 6);
    _nsys_add(sys, "ז", 7);
    _nsys_add(sys, "ח", 8);
    _nsys_add(sys, "ט", 9);
    _nsys_add(sys, "י", 10);
    _nsys_add(sys, "כ", 20);
    _nsys_add(sys, "ל", 30);
    _nsys_add(sys, "מ", 40);
    _nsys_add(sys, "נ", 50);
    _nsys_add(sys, "ס", 60);
    _nsys_add(sys, "ע", 70);
    _nsys_add(sys, "פ", 80);
    _nsys_add(sys, "צ", 90);
    _nsys_add(sys, "ק", 100);
    _nsys_add(sys, "ר", 200);
    _nsys_add(sys, "ש", 300);
    _nsys_add(sys, "ת", 400);
    # Final forms — same standard value as the base letter.
    _nsys_add_variant(sys, "ך", 20, "כ");
    _nsys_add_variant(sys, "ם", 40, "מ");
    _nsys_add_variant(sys, "ן", 50, "נ");
    _nsys_add_variant(sys, "ף", 80, "פ");
    _nsys_add_variant(sys, "ץ", 90, "צ");
    _c_gematria_hebrew = sys;
    return _c_gematria_hebrew;
}

var _c_gematria_arabic_abjad = 0;
# Abjadi order (abjad hawwaz hutti kalaman saafas qarashat thakhadh dazagh),
# which is the old Semitic order, NOT the modern hija'i dictionary order. The
# distinction matters: hija'i would give completely different values.
#
# This is the MASHRIQI (eastern) reckoning, the conventional default. The
# Maghrebi/Andalusi tradition orders the last four groups sa'fad qarasat
# thakhadh zaghash instead, which moves exactly six letters — sin 60<->shin 300,
# sad 90<->60, dad 800<->90, zah 900<->800, ghayn 1000<->900 — and leaves the
# other 22 identical. "Abjadi" alone does not say which, hence the name here.
# Maghrebi sources need their own table; scoring them against this one is
# silently wrong on those six letters and only those.
#
# Only the 28 letters are mapped. The orthographic forms — hamza ء, alif madda
# آ, ta marbuta ة, alif maqsura ى — have no independent abjad value (hamza
# counts with alif, ta marbuta as ha or ta by tradition, alif maqsura as ya), so
# callers normalise first. Unnormalised input fails loudly: char_value returns
# the unmapped sentinel and string_value_in propagates it for the whole string.
fn gematria_arabic_abjad() {
