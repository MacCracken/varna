var _c_phoneme_somali = 0;
fn phoneme_somali() {
    if (_c_phoneme_somali != 0) { return _c_phoneme_somali; }

    var b = phoneme_builder_with_capacity("so", "Somali", 32);
    phoneme_builder_stress(b, StressPattern.Tonal);
    # Standard (Northern) Somali. Reviewed at 2.5.3 against PHOIBLE's two Somali
    # inventories (127, SPA, from Armstrong and Andrzejewski; 552, UPSID), Gabbard
    # (2010) and Edmondson, Esling & Harris (2004).
    var t = vec_new();
    vec_push(t, "˥");
    vec_push(t, "˩");
    phoneme_builder_tones(b, t);
    # Plosives. /t d/ are dental (2.5.3; were Alveolar): Edmondson et al.
    # "apico-dental", PHOIBLE 552 t̪ʰ d̪, and Gabbard's chart. No source gave alveolar.
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Dental, 0);
    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Dental, 1);
    phoneme_builder_consonant(b, "ɖ", Manner.Plosive, Place.Retroflex, 1);
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant(b, "ɡ", Manner.Plosive, Place.Velar, 1);
    # ⟨q⟩ stays voiceless /q/, after Gabbard (2010), whose spectrograms show "never any
    # voicing or aspiration", and Edmondson et al. Armstrong (via SPA), both PHOIBLE
    # inventories and Saeed (1999) write /ɢ/; the sources genuinely disagree.
    phoneme_builder_consonant(b, "q", Manner.Plosive, Place.Uvular, 0);
    phoneme_builder_consonant(b, "ʔ", Manner.Plosive, Place.Glottal, 0);
    # Affricate ⟨j⟩, added at 2.5.3: t̠ʃ in both PHOIBLE inventories; Edmondson et al.
    # "voiceless aspirated palato-alveolar affricate", voiced [dʒ] in southern
    # varieties. Its absence was a gap, not an analysis.
    phoneme_builder_consonant(b, "t͡ʃ", Manner.Affricate, Place.Postalveolar, 0);
    # Fricatives. ⟨kh⟩ stays /x/, as in SPA and both PHOIBLE inventories; it is marginal,
    # mostly in Arabic loans, and Gabbard and Edmondson et al. hear it uvular.
    # /ɣ/ was removed at 2.5.3. It is /ɡ/ between vowels (Armstrong, via SPA: "sometimes
    # [ɣ] when single between vowels"; Gabbard), and no source checked lists it as a
    # phoneme.
    phoneme_builder_consonant(b, "f", Manner.Fricative, Place.Labiodental, 0);
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "ʃ", Manner.Fricative, Place.Postalveolar, 0);
    phoneme_builder_consonant(b, "x", Manner.Fricative, Place.Velar, 0);
    phoneme_builder_consonant(b, "ħ", Manner.Fricative, Place.Pharyngeal, 0);
    phoneme_builder_consonant(b, "ʕ", Manner.Fricative, Place.Pharyngeal, 1);
    phoneme_builder_consonant(b, "h", Manner.Fricative, Place.Glottal, 0);
    # Nasals
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    # Approximants & liquids
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "r", Manner.Trill, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    # Five vowel qualities, each short and long, with a second "series" left out of the
    # segments on purpose. Somali is "commonly described as containing five major vowel
    # categories {i,e,a,o,u}, each of which is contrastive for length and (purportedly)
    # for an additional feature" (Kimper, Bennett, Green & Yu 2019, p. 199). That is
    # the framing kept here.
    #
    # The additional feature splits every vowel into two series, and the sources do not
    # agree on what it is: front vs back (Andrzejewski 1955), ±ATR (Saeed 1999), or a
    # voice register (Edmondson et al.). Orwin's thesis (1994, *Aspects of Somali
    # Phonology*, p. 61) sets out "two series of vowels" and finds "no satisfactory
    # explanation of how the front and back series ... are phonologically distinct".
    # The series is fixed on a root, spreads to suffixes, and can reach the phrase. Kimper
    # et al. found "no clear evidence" of a categorical contrast in their speakers and
    # suggest a near merger. The ten-symbol listings also conflict: Saeed's chart, and
    # PHOIBLE 127 and 552, each pair the vowels differently.
    #
    # Corrected citation (2.5.3): from 2.4.1 the corpus quoted "Orwin (1994)" as
    # saying "each of these five vowels has a fronted (ATR) variant". That sentence is
    # Wikipedia's paraphrase, not Orwin's. His five-vowel listing is the textbook,
    # *Colloquial Somali* (1995), which says fronting "is a matter we shall not address
    # in this book".
    #
    # Heights follow Edmondson et al.: i and u close, and e and o "open mid" in both
    # registers. The expanded-register vowel is described as raised from that base.
    # Short vowels (5)
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel(b, "e", Height.OpenMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "o", Height.OpenMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    # Long vowels (5)
    phoneme_builder_vowel_full(b, "iː", Height.Close, Backness.Front, 0, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "eː", Height.OpenMid, Backness.Front, 0, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "aː", Height.Open, Backness.Central, 0, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "oː", Height.OpenMid, Backness.Back, 1, PhonemeFeature.Long);
    phoneme_builder_vowel_full(b, "uː", Height.Close, Backness.Back, 1, PhonemeFeature.Long);
    _c_phoneme_somali = phoneme_builder_build(b);
    return _c_phoneme_somali;
}

var _c_phoneme_quechua = 0;
fn phoneme_quechua() {
    if (_c_phoneme_quechua != 0) { return _c_phoneme_quechua; }

    var b = phoneme_builder_with_capacity("qu", "Southern Quechua", 27);
    phoneme_builder_stress(b, StressPattern.Fixed);
    # Plain stops
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "t͡ʃ", Manner.Affricate, Place.Postalveolar, 0);
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant(b, "q", Manner.Plosive, Place.Uvular, 0);
    # Aspirated stops
    phoneme_builder_consonant_full(b, "pʰ", Manner.Plosive, Place.Bilabial, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant_full(b, "tʰ", Manner.Plosive, Place.Alveolar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant_full(b, "t͡ʃʰ", Manner.Affricate, Place.Postalveolar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant_full(b, "kʰ", Manner.Plosive, Place.Velar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant_full(b, "qʰ", Manner.Plosive, Place.Uvular, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    # Ejectives
    phoneme_builder_consonant_airstream(b, "pʼ", Manner.Plosive, Place.Bilabial, 0, Airstream.Ejective);
    phoneme_builder_consonant_airstream(b, "tʼ", Manner.Plosive, Place.Alveolar, 0, Airstream.Ejective);
    phoneme_builder_consonant_airstream(b, "t͡ʃʼ", Manner.Affricate, Place.Postalveolar, 0, Airstream.Ejective);
    phoneme_builder_consonant_airstream(b, "kʼ", Manner.Plosive, Place.Velar, 0, Airstream.Ejective);
    phoneme_builder_consonant_airstream(b, "qʼ", Manner.Plosive, Place.Uvular, 0, Airstream.Ejective);
    # Fricatives
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "h", Manner.Fricative, Place.Glottal, 0);
    # Nasals
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ɲ", Manner.Nasal, Place.Palatal, 1);
    # Approximants & liquids
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "r", Manner.TapFlap, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    # Three-vowel system (typologically notable)
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    _c_phoneme_quechua = phoneme_builder_build(b);
    return _c_phoneme_quechua;
}

var _c_phoneme_guarani = 0;
