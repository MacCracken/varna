    _tt_add(tt, "Ὲ", "*\\e");
    _tt_add(tt, "Ὴ", "*\\h");
    _tt_add(tt, "ῌ", "*h|");
    _tt_add(tt, "Ῐ", "*%27i");
    _tt_add(tt, "Ῑ", "*%26i");
    _tt_add(tt, "Ὶ", "*\\i");
    _tt_add(tt, "Ῠ", "*%27u");
    _tt_add(tt, "Ῡ", "*%26u");
    _tt_add(tt, "Ὺ", "*\\u");
    _tt_add(tt, "Ῥ", "*(r");
