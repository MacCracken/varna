    _tt_add(tt, "וֹ", "o");
    _tt_add(tt, "וֺ", "o");
    _tt_add(tt, "וּ", "u");
    # י after a vowel point is a consonant when it has a point of its own (מַיִם mayim).
    _tt_add(tt, "ֶיְ", "ey");
