    phoneme_builder_consonant(b, "ɣ", Manner.Fricative, Place.Velar, 1);
    phoneme_builder_consonant(b, "h", Manner.Fricative, Place.Glottal, 0);
    # Nasals
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ɲ", Manner.Nasal, Place.Palatal, 1);
    phoneme_builder_consonant(b, "ŋ", Manner.Nasal, Place.Velar, 1);
    # Liquids
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    # Vowels
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel(b, "e", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "ɛ", Height.OpenMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "ɑ", Height.Open, Backness.Back, 0);
    phoneme_builder_vowel(b, "ɨ", Height.Close, Backness.Central, 0);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    phoneme_builder_vowel(b, "o", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "ɔ", Height.OpenMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "ə", Height.Mid, Backness.Central, 0);
    phoneme_builder_vowel(b, "æ", Height.NearOpen, Backness.Front, 0);
    phoneme_builder_vowel(b, "ɐ", Height.NearOpen, Backness.Central, 0);
    _c_phoneme_literary_chinese = phoneme_builder_build(b);
    return _c_phoneme_literary_chinese;
}

var _c_phoneme_mandarin = 0;
fn phoneme_mandarin() {
    if (_c_phoneme_mandarin != 0) { return _c_phoneme_mandarin; }

    var b = phoneme_builder_with_capacity("zh", "Mandarin Chinese", 46);
    phoneme_builder_stress(b, StressPattern.Tonal);
    var t = vec_new();
    vec_push(t, "˥˥");
    vec_push(t, "˧˥");
    vec_push(t, "˨˩˦");
    vec_push(t, "˥˩");
    vec_push(t, "˧");
    phoneme_builder_tones(b, t);
    # Bilabials
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant_full(b, "pʰ", Manner.Plosive, Place.Bilabial, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "f", Manner.Fricative, Place.Labiodental, 0);
    # Alveolars
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Alveolar, 0);
    phoneme_builder_consonant_full(b, "tʰ", Manner.Plosive, Place.Alveolar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    # Alveolar sibilants
    phoneme_builder_consonant(b, "t͡s", Manner.Affricate, Place.Alveolar, 0);
    phoneme_builder_consonant_full(b, "t͡sʰ", Manner.Affricate, Place.Alveolar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    # Retroflex sibilants
    phoneme_builder_consonant(b, "ʈ͡ʂ", Manner.Affricate, Place.Retroflex, 0);
    phoneme_builder_consonant_full(b, "ʈ͡ʂʰ", Manner.Affricate, Place.Retroflex, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "ʂ", Manner.Fricative, Place.Retroflex, 0);
    phoneme_builder_consonant(b, "ɻ", Manner.Approximant, Place.Retroflex, 1);
    # Palatals (from velar/alveolar before front vowels)
    phoneme_builder_consonant(b, "t͡ɕ", Manner.Affricate, Place.Palatal, 0);
    phoneme_builder_consonant_full(b, "t͡ɕʰ", Manner.Affricate, Place.Palatal, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "ɕ", Manner.Fricative, Place.Palatal, 0);
    # Velars
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant_full(b, "kʰ", Manner.Plosive, Place.Velar, 0,
      Airstream.Pulmonic, PhonemeFeature.Aspirated);
    phoneme_builder_consonant(b, "x", Manner.Fricative, Place.Velar, 0);
    # --- Corrected at 2.6.0, after Lee & Zee (2003), "Standard Chinese (Beijing)",
    # JIPA 33(1), the IPA Illustration (pp. 109-111). Their chart has /ŋ w j/, which the
    # corpus lacked: "[ŋ] occurs only in syllable-final position" (p. 111). The
    # sibilants and /ɻ/ above keep the retroflex symbols of Chao (1968), a convention
    # Lee & Zee's own notes record; they write [tʃ̺ tʃ̺ʰ ʃ̺ ɹ̺], "apical post-alveolar".
    phoneme_builder_consonant(b, "ŋ", Manner.Nasal, Place.Velar, 1);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    # Vowels, Lee & Zee p. 110: monophthongs i y a ə u ɤ. The corpus had /e o/ as
    # monophthongs and no /ə/. In this description e and o occur only inside the
    # diphthongs and triphthongs below, so they are not listed alone.
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel(b, "y", Height.Close, Backness.Front, 1);
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "ə", Height.Mid, Backness.Central, 0);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    phoneme_builder_vowel(b, "ɤ", Height.CloseMid, Backness.Back, 0);
    # The syllabic apical approximant [ɹ̩], the "apical vowel" (p. 110, "Syllabic
    # consonants"; sɹ̩ 'to think'). It "occurs only in isolation or after [s, ts, tsʰ, ʃ,
    # tʃ, tʃʰ]" (p. 111). Filed as a vowel unit with the Syllabic bit, as Sanskrit's
    # syllabic liquids are.
    phoneme_builder_vowel_full(b, "ɹ̩", Height.Close, Backness.Central, 0, PhonemeFeature.Syllabic);
    # Diphthongs (11) and triphthongs (4), Lee & Zee p. 110, as vowel units. Each is
    # filed under the height, backness and rounding of its nucleus: the vowel that is
    # not the i/y/u glide.
    phoneme_builder_vowel(b, "ai", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "au", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "ou", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "uo", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "ei", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "ye", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "ie", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "ia", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "ua", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "uə", Height.Mid, Backness.Central, 0);
    phoneme_builder_vowel(b, "iu", Height.Close, Backness.Back, 1);
    phoneme_builder_vowel(b, "iau", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "uai", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "iou", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "uei", Height.CloseMid, Backness.Front, 0);
    _c_phoneme_mandarin = phoneme_builder_build(b);
    return _c_phoneme_mandarin;
}

