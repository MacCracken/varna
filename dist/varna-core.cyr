    _constraint_add_seq(c2, "ŋ");
    _phonotactics_add(p, c2);
    var c3 = _constraint_new(ConstraintKind.Forbidden, SyllablePosition.Coda, "Excluded German codas (Schäfer p. 132)");
    _constraint_add_seq(c3, "mf");
    _constraint_add_seq(c3, "ŋf");
    _constraint_add_seq(c3, "mn");
    _constraint_add_seq(c3, "mŋ");
    _constraint_add_seq(c3, "nm");
    _constraint_add_seq(c3, "nŋ");
    _constraint_add_seq(c3, "ŋm");
    _constraint_add_seq(c3, "ŋn");
    _constraint_add_seq(c3, "ml");
    _constraint_add_seq(c3, "mʁ");
    _constraint_add_seq(c3, "nl");
    _constraint_add_seq(c3, "nʁ");
    _constraint_add_seq(c3, "ŋl");
    _constraint_add_seq(c3, "ŋʁ");
    _phonotactics_add(p, c3);
    var c4 = _constraint_new(ConstraintKind.Forbidden, SyllablePosition.Coda,
      "No voiced obstruent or /h/ in a German coda (Schäfer pp. 117, 131)");
    _constraint_add_seq(c4, "b");
    _constraint_add_seq(c4, "d");
    _constraint_add_seq(c4, "ɡ");
    _constraint_add_seq(c4, "v");
    _constraint_add_seq(c4, "z");
    _constraint_add_seq(c4, "j");
    _constraint_add_seq(c4, "h");
    _phonotactics_add(p, c4);
    _c_phonotactics_german = p;
    return _c_phonotactics_german;
}

var _c_phonotactics_russian = 0;
# Russian, after Русская грамматика (1980), vol. 1, "Фонетика" (S. N. Dmitrenko), §22.
# A syllable can begin with up to three consonants ("двух шумных и сонорного") or a
# vowel, and end in up to four ("цилиндр, семестр, консульств"). max_onset is 4 on
# Chew (2003), A Computational Phonology of Russian, p. 86: four-consonant onsets exist,
# and "all such onsets in Russian begin with /vs/ or /vz/" (взгляд). Russian has six
# vowels and no diphthongs or length (Yanushevskaya & Bunčić 2015, p. 224).
# "Любой слог ... не может начинаться сочетанием '[j] + согласный'", and any syllable
# "может начинаться сочетанием 'согласный + [j]'" (вьюга): both are spelled out over
# the inventory. Final devoicing (§28) is word-final only, which a Coda constraint
# cannot say, so it is in allophone_russian instead.
fn phonotactics_russian() {
    if (_c_phonotactics_russian != 0) { return _c_phonotactics_russian; }
    var p = _phonotactics_new("ru", _syllable_new(4, 4, 0, "(C)(C)(C)(C)V(C)(C)(C)(C)"));
    var c0 = _constraint_new(ConstraintKind.Forbidden, SyllablePosition.Onset,
      "No Russian syllable begins with /j/ + consonant (Русская грамматика §22)");
