# Hebrew → Latin, ALA-LC (Library of Congress, Hebrew and Yiddish romanization table,
# 2011 PDF), read from the LoC PDF; the Hebrew column only (Yiddish values differ).
# PARTIAL: the table itself says romanizing Hebrew "often" needs a dictionary "for
# the purpose of supplying vowels", so unpointed text gives consonants (שלום is
# "shlṿm"). Where the table gives two readings, or none, the project owner chose:
#   - א is ʼ everywhere ("ʼ (alif) or disregarded": an initial or silent alef also
#     writes ʼ, so אָדָם is ʼadam, not adam);
#   - shva writes nothing ("e or disregarded": a vocal shva loses its e);
#   - a bare ש (no dot) is sh; the sin dot gives ś;
#   - dagesh outside ב כ ך פ ף ת, meteg, rafe and cantillation write nothing.
# Qamats is a, the table's first value; qamats qatan (U+05C7), marked explicitly, is o.
# Left out:
#   - ו and י "only if a consonant", beyond the vowel letters the table lists;
#   - ALA-LC capitalization;
#   - a final ַי after a hard letter in Unicode order: בַּי reads bay, not bai (see
#     the rows);
#   - a vowel letter after a cantillation mark, which sorts between the point and
#     the letter: בְּרֵאשִׁ֖ית reads breʼshiyt.
# ʻ and ʼ are U+02BB and U+02BC, as this PDF prints them and as MARC 21 maps ALA-LC's
# ayn and alif; ṿ is U+1E7F, ḳ U+1E33.
var _c_translit_hebrew_alalc = 0;
fn translit_hebrew_alalc() {
    if (_c_translit_hebrew_alalc != 0) { return _c_translit_hebrew_alalc; }
    var tt = _tt_new("ALA-LC Hebrew", "Hebr", "Latn");
    # The letters (table, p. 1). א is ʼ everywhere and a bare ש is sh (owner's decisions).
    _tt_add(tt, "א", "ʼ");
    _tt_add(tt, "ב", "v");
    _tt_add(tt, "ג", "g");
    _tt_add(tt, "ד", "d");
    _tt_add(tt, "ה", "h");
    _tt_add(tt, "ו", "ṿ");
    _tt_add(tt, "װ", "ṿ");
    _tt_add(tt, "ז", "z");
    _tt_add(tt, "ח", "ḥ");
    _tt_add(tt, "ט", "ṭ");
    _tt_add(tt, "י", "y");
    _tt_add(tt, "כ", "kh");
    _tt_add(tt, "ך", "kh");
    _tt_add(tt, "ל", "l");
    _tt_add(tt, "מ", "m");
    _tt_add(tt, "ם", "m");
    _tt_add(tt, "נ", "n");
    _tt_add(tt, "ן", "n");
    _tt_add(tt, "ס", "s");
    _tt_add(tt, "ע", "ʻ");
    _tt_add(tt, "פ", "f");
    _tt_add(tt, "ף", "f");
    _tt_add(tt, "צ", "ts");
    _tt_add(tt, "ץ", "ts");
    _tt_add(tt, "ק", "ḳ");
    _tt_add(tt, "ר", "r");
    _tt_add(tt, "ש", "sh");
    _tt_add(tt, "ת", "t");
    # Dagesh makes ב כ ך פ ף hard (table); in Unicode order it follows a vowel point.
    _tt_add(tt, "בּ", "b");
    _tt_add(tt, "כּ", "k");
    _tt_add(tt, "ךּ", "k");
    _tt_add(tt, "פּ", "p");
    _tt_add(tt, "ףּ", "p");
    _tt_add(tt, "תּ", "t");
    # The shin and sin dots (table), before or after a vowel point and dagesh.
    _tt_add(tt, "שׁ", "sh");
    _tt_add(tt, "שּׁ", "sh");
    _tt_add(tt, "שׂ", "ś");
    _tt_add(tt, "שּׂ", "ś");
    # Vowel points; dagesh elsewhere, meteg, rafe and cantillation write nothing (owner's decision).
    _tt_add(tt, "ְ", "");
    _tt_add(tt, "ֱ", "e");
    _tt_add(tt, "ֲ", "a");
    _tt_add(tt, "ֳ", "o");
    _tt_add(tt, "ִ", "i");
    _tt_add(tt, "ֵ", "e");
    _tt_add(tt, "ֶ", "e");
    _tt_add(tt, "ַ", "a");
    _tt_add(tt, "ָ", "a");
