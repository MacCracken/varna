var _c_phoneme_japanese = 0;
fn phoneme_japanese() {
    if (_c_phoneme_japanese != 0) { return _c_phoneme_japanese; }

    var b = phoneme_builder_with_capacity("ja", "Japanese", 21);
    phoneme_builder_stress(b, StressPattern.PitchAccent);
    # Tokyo Japanese after Okada (1991), "Japanese", JIPA 21(2), the IPA Illustration:
    # 16 consonants p b t d tˢ ɖ k ɡ m n ɴ s z h j w and the vowels i e a o u (p. 94).
    #
    # Corrected at 2.6.0. The corpus listed [t͡ɕ d͡ʑ ɸ ɕ ŋ] as phonemes. Okada gives
    # each as an allophone: /tˢ/ "becomes [tɕ] before /i/", /s z/ "are [ɕ] and [ʑ]
    # before /i/" ([ᵈʑ] for /z/ initially), /h/ "tends towards [ç] and [ɸ] before /i/
    # and /u/", and /g/ "becomes [ŋ] medially" (p. 95). They are rules now
    # (allophone_japanese). The moraic nasal /ɴ/ was missing.
    #
    # Two notations are kept. The affricate stays t͡s, Okada's /tˢ/. The liquid stays ɾ:
    # Okada writes it /ɖ/, "often transcribed by others as /r/", postalveolar, with
    # [ɾ] "more frequent" between vowels. Vowel length and geminates are distinctive
    # (p. 95). Okada analyses both as moraic sequences, not separate phonemes.
    # Plosives
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant(b, "ɡ", Manner.Plosive, Place.Velar, 1);
    # Affricate
    phoneme_builder_consonant(b, "t͡s", Manner.Affricate, Place.Alveolar, 0);
    # Fricatives
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "z", Manner.Fricative, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "h", Manner.Fricative, Place.Glottal, 0);
    # Nasals. /ɴ/ is the moraic nasal, homorganic with a following consonant.
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ɴ", Manner.Nasal, Place.Uvular, 1);
    # Approximants & liquids
    phoneme_builder_consonant(b, "ɾ", Manner.TapFlap, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    # Vowels (5-vowel system)
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel(b, "e", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "o", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 0);
    _c_phoneme_japanese = phoneme_builder_build(b);
    return _c_phoneme_japanese;
}

var _c_phoneme_spanish = 0;
fn phoneme_spanish() {
    if (_c_phoneme_spanish != 0) { return _c_phoneme_spanish; }

    var b = phoneme_builder_with_capacity("es", "Spanish", 26);
    phoneme_builder_stress(b, StressPattern.Free);
    # Castilian Spanish after Martínez-Celdrán, Fernández-Planas & Carrera-Sabaté (2003),
    # "Castilian Spanish", JIPA 33(2), the IPA Illustration: 19 consonants p b t d k ɡ
    # t͡ʃ ɟ͡ʝ m n ɲ ɾ r f θ s x l ʎ (p. 255) and the vowels i e a o u (p. 256).
    #
    # Corrected at 2.6.0:
    #   - [β ð ɣ] were listed as phonemes. They are allophones of /b d ɡ/: "complete
    #     stops only after a pause or after a nasal consonant and, in the case of /d/,
    #     after a lateral too. In other positions they are pronounced as their
    #     approximant variants [β̞], [ð̞] and [ɣ̞]" (p. 257).
    #   - The rhotics were "r" (a tap) and "rr", which is spelling, not IPA. The source
    #     has the tap /ɾ/ and the trill /r/ (caro [ˈkaɾo] vs carro [ˈkaro], p. 258).
    #   - /ɟ͡ʝ/ (yate [ˈɟ͡ʝate]) was missing.
    # /j w/ stay. The source writes them as glides in diphthongs (p. 256) and states no
    # analysis that would remove them.
    # Plosives
    phoneme_builder_consonant(b, "p", Manner.Plosive, Place.Bilabial, 0);
    phoneme_builder_consonant(b, "b", Manner.Plosive, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "t", Manner.Plosive, Place.Dental, 0);
    phoneme_builder_consonant(b, "d", Manner.Plosive, Place.Dental, 1);
    phoneme_builder_consonant(b, "k", Manner.Plosive, Place.Velar, 0);
    phoneme_builder_consonant(b, "ɡ", Manner.Plosive, Place.Velar, 1);
    # Affricates
    phoneme_builder_consonant(b, "t͡ʃ", Manner.Affricate, Place.Postalveolar, 0);
    phoneme_builder_consonant(b, "ɟ͡ʝ", Manner.Affricate, Place.Palatal, 1);
    # Fricatives
    phoneme_builder_consonant(b, "f", Manner.Fricative, Place.Labiodental, 0);
    phoneme_builder_consonant(b, "θ", Manner.Fricative, Place.Dental, 0);
    phoneme_builder_consonant(b, "s", Manner.Fricative, Place.Alveolar, 0);
    phoneme_builder_consonant(b, "x", Manner.Fricative, Place.Velar, 0);
    # Nasals
    phoneme_builder_consonant(b, "m", Manner.Nasal, Place.Bilabial, 1);
    phoneme_builder_consonant(b, "n", Manner.Nasal, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "ɲ", Manner.Nasal, Place.Palatal, 1);
    # Liquids
    phoneme_builder_consonant_full(b, "l", Manner.LateralApproximant, Place.Alveolar, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant_full(b, "ʎ", Manner.LateralApproximant, Place.Palatal, 1,
      Airstream.Pulmonic, PhonemeFeature.Lateral);
    phoneme_builder_consonant(b, "ɾ", Manner.TapFlap, Place.Alveolar, 1);
    phoneme_builder_consonant(b, "r", Manner.Trill, Place.Alveolar, 1);
    # Approximants
    phoneme_builder_consonant(b, "j", Manner.Approximant, Place.Palatal, 1);
    phoneme_builder_consonant(b, "w", Manner.Approximant, Place.LabialVelar, 1);
    # Vowels
    phoneme_builder_vowel(b, "i", Height.Close, Backness.Front, 0);
    phoneme_builder_vowel(b, "e", Height.CloseMid, Backness.Front, 0);
    phoneme_builder_vowel(b, "a", Height.Open, Backness.Central, 0);
    phoneme_builder_vowel(b, "o", Height.CloseMid, Backness.Back, 1);
    phoneme_builder_vowel(b, "u", Height.Close, Backness.Back, 1);
    _c_phoneme_spanish = phoneme_builder_build(b);
    return _c_phoneme_spanish;
}

