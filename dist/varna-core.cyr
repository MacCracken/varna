    _nsys_add(sys, "l", 12);
    _nsys_add(sys, "m", 13);
    _nsys_add(sys, "n", 14);
    _nsys_add(sys, "o", 15);
    _nsys_add(sys, "p", 16);
    _nsys_add(sys, "q", 17);
    _nsys_add(sys, "r", 18);
    _nsys_add(sys, "s", 19);
    _nsys_add(sys, "t", 20);
