# --- Lookup by scheme name (2.6.0) ---------------------------------
# The names the MCP tool takes. The same shape as allophone_by_code.

# The table for a scheme name, or 0 for a name varna has no table for.
#must_use
fn translit_by_scheme(name) {
    if (name == 0) { return 0; }
    if (streq(name, "devanagari_iast") == 1) { return translit_devanagari_iast(); }
    if (streq(name, "greek_beta") == 1) { return translit_greek_beta_code(); }
    if (streq(name, "russian_alalc") == 1) { return translit_russian_alalc(); }
    if (streq(name, "arabic_alalc") == 1) { return translit_arabic_alalc(); }
    if (streq(name, "hebrew_alalc") == 1) { return translit_hebrew_alalc(); }
    if (streq(name, "zhuyin_pinyin") == 1) { return translit_zhuyin_pinyin(); }
    return 0;
}

var _c_translit_all_schemes = 0;
# Every scheme name, in the order the tables were added — vec of cstrings.
fn translit_all_schemes() {
    if (_c_translit_all_schemes != 0) { return _c_translit_all_schemes; }
    var c = vec_new();
    vec_push(c, "devanagari_iast");
    vec_push(c, "greek_beta");
    vec_push(c, "russian_alalc");
    vec_push(c, "arabic_alalc");
    vec_push(c, "hebrew_alalc");
    vec_push(c, "zhuyin_pinyin");
    _c_translit_all_schemes = c;
    return _c_translit_all_schemes;
}
