    var tt = _tt_new("ALA-LC Arabic", "Arab", "Latn");
    # The letters (table, p. 1). ة before ه, so the reverse map gives ه for h.
    _tt_add(tt, "ب", "b");
    _tt_add(tt, "ت", "t");
    _tt_add(tt, "ث", "th");
    _tt_add(tt, "ج", "j");
    _tt_add(tt, "ح", "ḥ");
    _tt_add(tt, "خ", "kh");
    _tt_add(tt, "د", "d");
    _tt_add(tt, "ذ", "dh");
    _tt_add(tt, "ر", "r");
    _tt_add(tt, "ز", "z");
    _tt_add(tt, "س", "s");
    _tt_add(tt, "ش", "sh");
    _tt_add(tt, "ص", "ṣ");
    _tt_add(tt, "ض", "ḍ");
    _tt_add(tt, "ط", "ṭ");
    _tt_add(tt, "ظ", "ẓ");
    _tt_add(tt, "ع", "ʻ");
    _tt_add(tt, "غ", "gh");
    _tt_add(tt, "ف", "f");
    _tt_add(tt, "ق", "q");
    _tt_add(tt, "ك", "k");
    _tt_add(tt, "ل", "l");
    _tt_add(tt, "م", "m");
    _tt_add(tt, "ن", "n");
    _tt_add(tt, "ة", "h");
    _tt_add(tt, "ه", "h");
    _tt_add(tt, "و", "w");
    _tt_add(tt, "ي", "y");
    _tt_add(tt, "ڢ", "f");
    _tt_add(tt, "ڧ", "q");
    # Alif: "omit" (table); its long-vowel use is fatha + alif below.
    _tt_add(tt, "ا", "");
    _tt_add(tt, "ٱ", "");
    _tt_add(tt, "آ", "ʼā");
    # Hamzah: medial and final, rule 8(a); its seats are not written (rule 2). Initial
