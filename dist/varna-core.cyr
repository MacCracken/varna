    _tt_add(tt, "ἒ", "e)\\");
    _tt_add(tt, "ἓ", "e(\\");
    _tt_add(tt, "ἔ", "e)/");
    _tt_add(tt, "ἕ", "e(/");
    _tt_add(tt, "Ἐ", "*)e");
    _tt_add(tt, "Ἑ", "*(e");
    _tt_add(tt, "Ἒ", "*)\\e");
    _tt_add(tt, "Ἓ", "*(\\e");
    _tt_add(tt, "Ἔ", "*)/e");
    _tt_add(tt, "Ἕ", "*(/e");
    _tt_add(tt, "ἠ", "h)");
    _tt_add(tt, "ἡ", "h(");
    _tt_add(tt, "ἢ", "h)\\");
