    _tt_add(tt, "Ύ", "*/u");
    _tt_add(tt, "Ό", "*/o");
    _tt_add(tt, "Ώ", "*/w");
    # The precomposed letters.
    _tt_add(tt, "Ά", "*/a");
    _tt_add(tt, "Έ", "*/e");
    _tt_add(tt, "Ή", "*/h");
    _tt_add(tt, "Ί", "*/i");
    _tt_add(tt, "Ό", "*/o");
    _tt_add(tt, "Ύ", "*/u");
    _tt_add(tt, "Ώ", "*/w");
    _tt_add(tt, "ΐ", "i+/");
    _tt_add(tt, "Ϊ", "*+i");
    _tt_add(tt, "Ϋ", "*+u");
    _tt_add(tt, "ά", "a/");
    _tt_add(tt, "έ", "e/");
    _tt_add(tt, "ή", "h/");
    _tt_add(tt, "ί", "i/");
    _tt_add(tt, "ΰ", "u+/");
    _tt_add(tt, "ϊ", "i+");
    _tt_add(tt, "ϋ", "u+");
    _tt_add(tt, "ό", "o/");
    _tt_add(tt, "ύ", "u/");
